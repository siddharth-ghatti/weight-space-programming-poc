{"id": "toolu_01S7sAjnXNWYp2bWesSjMfRs", "caller": {"type": "direct"}, "input": {"code": "y=np.load('y.npy'); folds=np.load('folds.npy')\nlg=np.load('pass_1/logits.npy'); bp=lg.argmax(1)\ndef mf1(y,p):\n    f=[]\n    for c in range(4):\n        tp=((p==c)&(y==c)).sum(); fp=((p==c)&(y!=c)).sum(); fn=((p!=c)&(y==c)).sum()\n        f.append(2*tp/max(2*tp+fp+fn,1))\n    return np.mean(f)\ndef ridge_pred(X,T,lam,folds):\n    out=np.zeros((len(X),T.shape[1]))\n    for f in range(10):\n        tr=folds!=f; te=~tr\n        mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6\n        Z=(X[tr]-mu)/sd; Zte=(X[te]-mu)/sd\n        tm=T[tr].mean(0)\n        B=np.linalg.solve(Z.T@Z+lam*np.eye(Z.shape[1]),Z.T@(T[tr]-tm))\n        out[te]=Zte@B+tm\n    return out\nmarg=np.sort(lg,1); marg=marg[:,-1]-marg[:,-2]\nlow=marg<np.percentile(marg,25)\nprint('base margin quartiles',np.percentile(marg,[10,25,50,75]))\nfor l in range(2,7):\n    X=np.load(f'pass_1/cls_hidden_L{l}.npy')\n    for lam in [30,100,300,1000]:\n        o=ridge_pred(X,lg,lam,folds); p=o.argmax(1)\n        r2=1-((o-lg)**2).sum()/((lg-lg.mean(0))**2).sum()\n        print(l,lam,'agree %.3f acc %.3f mf1 %.3f R2 %.3f lowmargin-agree %.3f'%((p==bp).mean(),(p==y).mean(),mf1(y,p),r2,(p[low]==bp[low]).mean()))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
