{"id": "toolu_01TUvCZsptth6orFUxDGcKCC", "caller": {"type": "direct"}, "input": {"code": "import numpy as np, scipy.special as sps\nexec(open('lsbuild.py').read())\ntk=np.load('tok_kind.npy')\ndef LN(x,g,b): mu=x.mean(1,keepdims=True); v=x.var(1,keepdims=True); return (x-mu)/np.sqrt(v+1e-5)*g+b\nfor l in range(3):\n    pre=f'roberta.encoder.layer.{l}.'\n    a,W1,b1,U,b2=layer_data(l,base)\n    G=gelu(a@W1.T+b1); F=G@U.T+b2\n    keep,Un,b2n=build_ls(l,2048,base)\n    Fe=G@Un.T+b2n\n    g2=base(pre+'output.LayerNorm.weight').astype(np.float64); be2=base(pre+'output.LayerNorm.bias').astype(np.float64)\n    h=LN(a+F,g2,be2); he=LN(a+Fe,g2,be2)\n    s=tk==2\n    raw=((Fe-F)**2)[s]; post=((he-h)**2)[s]\n    print(f'L{l} raw rel {raw.sum()/((F[s]-F[s].mean(0))**2).sum():.4f}  post rel {post.sum()/((h[s]-h[s].mean(0))**2).sum():.4f}')\n    rd=raw.sum(0); pdim=post.sum(0)\n    o=np.argsort(-rd)[:5]; print('  top raw-err dims',o, (rd[o]/rd.sum()).round(3),'g2',g2[o].round(2), 'post share',(pdim[o]/pdim.sum()).round(3))\n    o2=np.argsort(-pdim)[:5]; print('  top post-err dims',o2,(pdim[o2]/pdim.sum()).round(3))\n    sx=np.sqrt((a+F).var(1)); print('  sigma_x pct',np.percentile(sx[s],[5,50,95]).round(2), ' |g2| pct',np.percentile(np.abs(g2),[5,50,95]).round(2))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
