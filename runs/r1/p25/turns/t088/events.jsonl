{"id": "toolu_011yebQbJyS8QmFvX23yYhtn", "caller": {"type": "direct"}, "input": {"code": "\nimport sys; sys.path.insert(0,str(WORK))\nfrom evalh import *\npb=Lb.argmax(1)\nsrt=np.sort(Lb,1); marg=srt[:,-1]-srt[:,-2]\nprint('margin quantiles', np.quantile(marg,[.01,.05,.1,.2,.5]))\nfor k in [12,17]:\n    L=np.load(f'pass_{k}/logits.npy'); pe=L.argmax(1)\n    # perturbation of pairwise logit differences\n    D=(L-L.mean(1,keepdims=True))-(Lb-Lb.mean(1,keepdims=True))\n    pw=np.abs(D[:,:,None]-D[:,None,:]).max((1,2))\n    # perturbation of margin between base top and base second\n    i2=np.argsort(Lb,1)[:,-2]\n    dm=(L[np.arange(1000),pb]-L[np.arange(1000),i2])-marg\n    print(k,'dm std',dm.std(),'mean',dm.mean(),'|dm| q',np.quantile(np.abs(dm),[.5,.9,.99]),'maxpw q',np.quantile(pw,[.5,.9,.99]))\n    flip=pe!=pb\n    print(' flips',flip.sum(),'base right->wrong',(flip&(pb==lab1)).sum(),'wrong->right',(flip&(pe==lab1)).sum(),'wrong->wrong',(flip&(pb!=lab1)&(pe!=lab1)).sum())\n    print(' flip margins',np.round(np.sort(marg[flip]),2))\n    # is |dm| correlated with margin?\n    print(' corr |dm| vs marg',np.corrcoef(np.abs(dm),marg)[0,1], ' |dm| for marg<1', np.abs(dm[marg<1]).mean(), 'marg>=1', np.abs(dm[marg>=1]).mean())\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
