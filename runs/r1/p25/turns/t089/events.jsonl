{"id": "toolu_01WcL1KSMPTiBnPzKaYN2Y9s", "caller": {"type": "direct"}, "input": {"code": "\nimport sys; sys.path.insert(0,str(WORK))\nfrom evalh import *\nD=base('classifier.dense.weight'); bd=base('classifier.dense.bias'); O=base('classifier.out_proj.weight'); bo=base('classifier.out_proj.bias')\nhb=np.load('pass_1/cls_hidden_L6.npy').astype(np.float64); \ndef head(h,Dm=D,b=bd): return np.tanh(h@Dm.T+b)@O.T+bo\nprint('check base head vs logits', np.abs(head(hb)-Lb).max())\npb=Lb.argmax(1)\nfolds=np.load('folds.npy'); print(folds[:10], np.unique(folds))\nfor k in [12,17]:\n    he=np.load(f'pass_{k}/cls_hidden_L6.npy').astype(np.float64)\n    Le=head(he); print(k,'head(he) vs pass logits',np.abs(Le-np.load(f'pass_{k}/logits.npy')).max())\n    Zb=hb@D.T+bd\n    for lam in [1e2,1e3,1e4,1e5]:\n        Lcv=np.zeros_like(Lb)\n        for f in np.unique(folds):\n            tr=folds!=f; te=folds==f\n            X=he[tr]; mu=X.mean(0); Xc=X-mu; Y=Zb[tr]; ym=Y.mean(0); Yc=Y-ym\n            # min ||Xc M^T - Yc||^2 + lam ||M - D||^2\n            G=Xc.T@Xc+lam*np.eye(768); M=np.linalg.solve(G, Xc.T@Yc+lam*D.T).T\n            c=ym-M@mu\n            Lcv[te]=np.tanh(he[te]@M.T+c)@O.T+bo\n        st=stats(None,Lcv,verbose=False); print(' lam',lam,st['agree'],st['low'],st['R2'],st['acc'])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
