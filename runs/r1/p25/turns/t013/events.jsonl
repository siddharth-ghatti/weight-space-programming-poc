{"id": "toolu_013uavp1HKFDTzhBmGSeN9DD", "caller": {"type": "direct"}, "input": {"code": "mask=np.load('pass_2/attention_mask.npy').astype(bool)\nHs=[np.load(f'pass_2/token_hidden_L{l}.npy') for l in range(7)]\nn=mask.shape[0]; trs=np.arange(n)<24\nfor t in range(1,6):\n    a=Hs[t][mask & trs[:,None]].astype(np.float64); b=Hs[t+1][mask & trs[:,None]].astype(np.float64)\n    at=Hs[t][mask & ~trs[:,None]].astype(np.float64); bt=Hs[t+1][mask & ~trs[:,None]].astype(np.float64)\n    ma,mb=a.mean(0),b.mean(0)\n    den=((bt-bt.mean(0))**2).sum()\n    out=[]\n    out.append(1-((bt-at)**2).sum()/den)\n    slope=((a-ma)*(b-mb)).mean(0)/(a.var(0)+1e-9)\n    out.append(1-((bt-((at-ma)*slope+mb))**2).sum()/den)\n    for lam in [1,10,100]:\n        A=np.linalg.solve((a-ma).T@(a-ma)+lam*np.eye(768),(a-ma).T@(b-mb))\n        out.append(1-((bt-((at-ma)@A+mb))**2).sum()/den)\n    print(f'drop layer {t}: heldout R2 identity {out[0]:.3f} diag {out[1]:.3f} full(l=1,10,100) {np.round(out[2:],3)}')"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
