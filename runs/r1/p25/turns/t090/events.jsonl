{"id": "toolu_018PFXP6TDvfnhdYXYWZqHyn", "caller": {"type": "direct"}, "input": {"code": "\nimport sys; sys.path.insert(0,str(WORK))\nfrom evalh import *\npb=Lb.argmax(1); srt=np.sort(Lb,1); marg=srt[:,-1]-srt[:,-2]; sec=np.argsort(Lb,1)[:,-2]\nfor th in [0.25,0.5,1.0]:\n    s=marg<th\n    print(th, 'n',s.sum(),'base acc',(pb==lab1)[s].mean(),'second-correct',(sec==lab1)[s].mean())\nprint('margins of base errors', np.quantile(marg[pb!=lab1],[.1,.25,.5,.75,.9]))\nfor k in [12,17]:\n    L=np.load(f'pass_{k}/logits.npy'); pe=L.argmax(1)\n    s=marg<0.6\n    print(k,'among marg<0.6: flips',(pe!=pb)[s].sum(),'of',s.sum(),' P(flip)',(pe!=pb)[s].mean())\n    # flip prob by bin\n    bins=[0,0.1,0.2,0.3,0.45,0.6,1.0]\n    print('  ',[ (round((pe!=pb)[(marg>=a)&(marg<b)].mean(),2),((marg>=a)&(marg<b)).sum()) for a,b in zip(bins[:-1],bins[1:])])\n    # signed: does the edited model move toward true label more than chance? dm on true-label logit vs others\n    d=(L-L.mean(1,keepdims=True))-(Lb-Lb.mean(1,keepdims=True))\n    print('  mean change of true-label logit (centered)', d[np.arange(1000),lab1].mean(), ' of base-pred logit', d[np.arange(1000),pb].mean())\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
