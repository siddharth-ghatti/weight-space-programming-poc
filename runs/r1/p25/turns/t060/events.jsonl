{"id": "toolu_017yPD9vu3XLfU9JaFr77JjV", "caller": {"type": "direct"}, "input": {"code": "import numpy as np\nlgb=np.load('pass_1/logits.npy'); y=np.load('y.npy')\nfor pd in ['pass_11','pass_12']:\n    lge=np.load(f'{pd}/logits.npy')\n    d=lge-lgb\n    bp=lgb.argmax(1)\n    srt=np.sort(lgb,1); marg=srt[:,-1]-srt[:,-2]\n    # perturbation of margin between top and each other class\n    pert=[]\n    for i in range(len(lgb)):\n        c=bp[i]; others=[j for j in range(4) if j!=c]\n        pert.append(np.max(np.abs(d[i,others]-d[i,c])))\n    pert=np.array(pert)\n    print(pd,'logit diff std',d.std(0).round(3),' pairwise pert median',np.median(pert).round(3),'p90',np.percentile(pert,90).round(3))\nprint('margin percentiles',np.percentile(marg,[5,10,25,50]).round(2))\n# accuracy by margin bin\nfor lo,hi in [(0,1),(1,2),(2,4),(4,8),(8,100)]:\n    s=(marg>=lo)&(marg<hi); print(lo,hi,s.sum(), (bp[s]==y[s]).mean().round(3) if s.sum() else '')\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
