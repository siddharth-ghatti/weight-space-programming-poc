{"id": "toolu_01Bvv9zzGK4MBLA81DxinXi6", "caller": {"type": "direct"}, "input": {"code": "\nimport sys; sys.path.insert(0,str(WORK))\nimport numpy as np, json\nfrom lsbuild import gelu, layer_data\nfrom evalh import Lb, lab1, f1\ndef LN(x,g,b): mu=x.mean(1,keepdims=True); v=x.var(1,keepdims=True); return (x-mu)/np.sqrt(v+1e-5)*g+b\npre='roberta.encoder.layer.5.'\nab,W1,b1,U,b2=layer_data(5,base)\ng2=base(pre+'output.LayerNorm.weight').astype(np.float64); bb=base(pre+'output.LayerNorm.bias').astype(np.float64)\nD=base('classifier.dense.weight').astype(np.float64); bd=base('classifier.dense.bias'); O=base('classifier.out_proj.weight'); bo=base('classifier.out_proj.bias')\nhead=lambda h: np.tanh(h@D.T+bd)@O.T+bo\nae=np.load('a5e_1792.npy').astype(np.float64); Ge=gelu(ae@W1.T+b1)\nL_full=head(LN(ae+Ge@U.T+b2,g2,bb))\npb=Lb.argmax(1); srt=np.sort(Lb,1); marg=srt[:,-1]-srt[:,-2]; i2=np.argsort(Lb,1)[:,-2]\nfor name,L in [('1792 fullL5',L_full),('pass12 m2048',np.load('pass_12/logits.npy')),('pass17',np.load('pass_17/logits.npy'))]:\n    d=(L-L.mean(1,keepdims=True))-(Lb-Lb.mean(1,keepdims=True))\n    dm=(L[np.arange(1000),pb]-L[np.arange(1000),i2])-marg\n    low=marg<1; r=pb==lab1\n    print(name,'mean centered logit shift per class',np.round(d.mean(0),3),' dm low&right %.3f low&wrong %.3f all %.3f'%(dm[low&r].mean(),dm[low&~r].mean(),dm.mean()))\n    pe=L.argmax(1); print('   pred counts base',np.bincount(pb,minlength=4),'edit',np.bincount(pe,minlength=4), ' flips to class',np.bincount(pe[pe!=pb],minlength=4),'from',np.bincount(pb[pe!=pb],minlength=4))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
