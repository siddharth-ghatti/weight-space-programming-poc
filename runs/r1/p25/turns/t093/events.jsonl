{"id": "toolu_01GwsVxGBmYk12LNwcxvQBfU", "caller": {"type": "direct"}, "input": {"code": "\nimport sys; sys.path.insert(0,str(WORK))\nimport numpy as np\nfrom lsbuild import gelu, layer_data\ndef LN(x,g,b): mu=x.mean(1,keepdims=True); v=x.var(1,keepdims=True); return (x-mu)/np.sqrt(v+1e-5)*g+b\nres={}\nfor l in [0,1,2]:\n    a,W1,b1,U,b2=layer_data(l,base)\n    a2=np.load(f'true2_a_L{l}.npy').astype(np.float64)\n    tk=np.concatenate([np.load('tok_kind.npy'),np.load('tok2_kind.npy')])\n    grp=np.concatenate([np.load('tok_grp.npy'),1000+np.load('tok2_grp.npy')])\n    A=np.vstack([a,a2]); G=gelu(A@W1.T+b1); F=G@U.T+b2; X=A+F\n    sig=X.std(1)\n    pre=f'roberta.encoder.layer.{l}.'\n    g2=base(pre+'output.LayerNorm.weight').astype(np.float64)\n    nt=tk==2\n    print(l,'sigma normal tokens q',np.round(np.quantile(sig[nt],[.05,.5,.95]),3),'cls',sig[tk==0][:3],'eos',np.round(sig[tk==1][:3],3),'g2 q',np.round(np.quantile(np.abs(g2),[.05,.5,.95]),3))\n    res[l]=(A,G,U,b2,X,sig,g2,tk,grp)\nnp.save('tmp_sig.npy',np.array([0]))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
