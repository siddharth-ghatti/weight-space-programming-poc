{"id": "toolu_01JYvcF1JoBpsKyHYJTH3dur", "caller": {"type": "direct"}, "input": {"code": "for e in edits(): drop_edit(e)\nmask=np.load('pass_2/attention_mask.npy').astype(bool)\ndef diag_fit(t, cls_weight=0.0):\n    a=np.load(f'pass_2/token_hidden_L{t}.npy')[mask].astype(np.float64)\n    b=np.load(f'pass_2/token_hidden_L{t+1}.npy')[mask].astype(np.float64)\n    ma,mb=a.mean(0),b.mean(0)\n    slope=((a-ma)*(b-mb)).mean(0)/(a.var(0)+1e-9)\n    c=mb-slope*ma\n    return slope,c\ndef apply_drop(t):\n    slope,c=diag_fit(t)\n    g=base(f'roberta.encoder.layer.{t-1}.output.LayerNorm.weight').astype(np.float64)\n    bb=base(f'roberta.encoder.layer.{t-1}.output.LayerNorm.bias').astype(np.float64)\n    save_edit(f'roberta.encoder.layer.{t-1}.output.LayerNorm.weight',(slope*g).astype(np.float32))\n    save_edit(f'roberta.encoder.layer.{t-1}.output.LayerNorm.bias',(slope*bb+c).astype(np.float32))\n    print('slope stats',np.percentile(slope,[5,50,95]).round(3))\napply_drop(3)\nprint(set_structure(layers=[0,1,2,4,5],ffn_keep=3072)); print(edits())"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
