{"id": "toolu_01S5peuo63cjdsftLFGeP2nk", "caller": {"type": "direct"}, "input": {"code": "import json\ntoks=json.load(open('pass_2/tokens.json')); mask=np.load('pass_2/attention_mask.npy').astype(bool)\nprint(type(toks), len(toks), toks[0][:5], toks[0][-3:] if isinstance(toks[0],list) else '')\n# build position labels over masked tokens\npos=[];kind=[]\nfor i in range(mask.shape[0]):\n    T=mask[i].sum()\n    for t in range(T):\n        tk=toks[i][t]\n        kind.append(0 if t==0 else (1 if tk=='</s>' else 2))\nkind=np.array(kind); print(np.bincount(kind))\nnp.save('tok_kind.npy',kind)\nfor l in range(5):\n    a=np.load(f'true_a_L{l}.npy').astype(np.float64)\n    mt=a[kind==2].mean(0); \n    for k,name in [(0,'CLS'),(1,'</s>')]:\n        mk=a[kind==k].mean(0)\n        d=mk-mt\n        p=a@d; thr_lo=p[kind==2].max(); thr_hi=p[kind==k].min()\n        print(f'L{l} {name}: ||mean-tokmean|| {np.linalg.norm(d):.1f} vs tok spread {np.sqrt(np.trace(np.cov(a[kind==2].T))):.1f}; proj sep: max other {thr_lo:.1f}, min {name} {thr_hi:.1f}, within-{name} spread {np.sqrt(np.trace(np.cov(a[kind==k].T))):.2f}')"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
