{"id": "toolu_01TtYiv32YJBBfF75JLmRSDY", "caller": {"type": "direct"}, "input": {"code": "import numpy as np, scipy.special as sps\ndef gelu(z): return 0.5*z*(1+sps.erf(z/np.sqrt(2)))\ntk=np.load('tok_kind.npy'); print('tok_kind', tk.shape, np.unique(tk, return_counts=True))\nst=structure()\nfor l in range(5):\n    a=np.load(f'true_a_L{l}.npy').astype(np.float64)\n    pre=f'roberta.encoder.layer.{l}.'\n    W1=base(pre+'intermediate.dense.weight'); b1=base(pre+'intermediate.dense.bias'); U=base(pre+'output.dense.weight'); b2=base(pre+'output.dense.bias')\n    f=gelu(a@W1.T+b1)@U.T+b2\n    kp=np.array(st['ffn_keep'][str(l)] if isinstance(st['ffn_keep'],dict) and str(l) in st['ffn_keep'] else st['ffn_keep'][l])\n    W1e=W(pre+'intermediate.dense.weight')[kp]; b1e=W(pre+'intermediate.dense.bias')[kp]; Ue=W(pre+'output.dense.weight')[:,kp]; b2e=W(pre+'output.dense.bias')\n    fe=gelu(a@W1e.T+b1e)@Ue.T+b2e\n    x=a+f\n    for kind in np.unique(tk):\n        s=tk==kind\n        err=np.linalg.norm(fe[s]-f[s],axis=1); nf=np.linalg.norm(f[s]-f[tk==1].mean(0),axis=1); nx=np.linalg.norm(x[s],axis=1)\n        print(f'L{l} kind{kind} n={s.sum()}: |err| {err.mean():.2f}  |f-meanf| {nf.mean():.2f} |x| {nx.mean():.1f}  rel(err/|x|) {np.mean(err/nx):.3f}')\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
