{"id": "toolu_01176npmJyMwZAt9d9KuJ1rz", "caller": {"type": "direct"}, "input": {"code": "import numpy as np, scipy.special as sps\ndef gelu(z): return 0.5*z*(1+sps.erf(z/np.sqrt(2)))\ngrp=np.load('tok_grp.npy'); tk=np.load('tok_kind.npy'); fold=grp%4; tk2=np.load('tok2_kind.npy')\ndef cvsel2(l, m, hs, lams, wcls=20., weos=5.):\n    pre=f'roberta.encoder.layer.{l}.'\n    a=np.load(f'true_a_L{l}.npy').astype(np.float64); a2=np.load(f'true2_a_L{l}.npy').astype(np.float64)\n    W1=base(pre+'intermediate.dense.weight').astype(np.float64); b1=base(pre+'intermediate.dense.bias').astype(np.float64)\n    U=base(pre+'output.dense.weight').astype(np.float64); b2=base(pre+'output.dense.bias').astype(np.float64)\n    G=gelu(a@W1.T+b1); F=G@U.T+b2; G2=gelu(a2@W1.T+b1)\n    num={}; den=0\n    for f in range(4):\n        tr=fold!=f; te=~tr\n        Gt=np.vstack([G[tr],G2]); kt=np.concatenate([tk[tr],tk2])\n        w=np.where(kt==0,wcls,np.where(kt==1,weos,1.0)); sw=np.sqrt(w)[:,None]\n        mu=(w[:,None]*Gt).sum(0)/w.sum(); Gc=(Gt-mu)*sw\n        H=Gc.T@Gc; un=(U**2).sum(0)\n        Fm=F[tr][tk[tr]==2].mean(0); den+=((F[te]-Fm)**2).sum(1)[tk[te]==2].sum()\n        for h in hs:\n            sc=un*np.diag(H) if h is None else un/np.diag(np.linalg.inv(H+h*np.eye(3072)))\n            keep=np.sort(np.argsort(-sc)[:m]); pr=np.setdiff1d(np.arange(3072),keep)\n            A=H[np.ix_(keep,keep)]; B=H[np.ix_(keep,pr)]@U[:,pr].T\n            for lam in lams:\n                D=np.linalg.solve(A+lam*np.eye(m),B).T\n                Fe=F[te]-((G[te][:,pr]-mu[pr])@U[:,pr].T)+(G[te][:,keep]-mu[keep])@D.T\n                e=((Fe-F[te])**2).sum(1)\n                num[(h,lam)]=num.get((h,lam),0)+e[tk[te]==2].sum()\n    return {k:round(v/den,4) for k,v in num.items()}\nfor l in (0,1,2):\n    print(l, cvsel2(l,2048,[None,0.1,0.3,1.0],[30,100,300]))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
