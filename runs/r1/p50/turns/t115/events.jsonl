{"id": "toolu_01UirrWpAhGGrdDoExjm3SAJ", "caller": {"type": "direct"}, "input": {"code": "import numpy as np\nrng=np.random.default_rng(0)\n# classes gov,risk,strat,metr ; construct base test confusion (rows gold, cols pred)\nC=np.array([[15,3,7,0],[3,43,18,2],[8,12,173,15],[0,4,18,79]])\ngold=np.repeat(np.arange(4), C.sum(1)); pred=np.concatenate([np.repeat(np.arange(4),C[g]) for g in range(4)])\ndef f1m(g,p):\n    f=[]\n    for c in range(4):\n        tp=((p==c)&(g==c)).sum(); fp=((p==c)&(g!=c)).sum(); fn=((p!=c)&(g==c)).sum(); f.append(2*tp/max(2*tp+fp+fn,1))\n    return np.mean(f)\nacc0=(gold==pred).mean(); F0=f1m(gold,pred); print('base acc %.4f F1 %.4f'%(acc0,F0))\n# confusion partner probabilities from row of C (off-diagonal)\ndef alt_for(a, excl):\n    w=(C[a]+C[:,a]).astype(float); w[a]=0\n    for e in excl: w[e]=0\n    return rng.choice(4,p=w/w.sum())\ndef sim(N, p1=.5, p2=.33, T=20000):\n    fa=ff=fe=0; dacc=[]\n    right=np.where(gold==pred)[0]; wrong=np.where(gold!=pred)[0]\n    for t in range(T):\n        p=pred.copy(); u=rng.random(N)\n        n1=(u<p1).sum(); n2=((u>=p1)&(u<p1+p2)).sum(); n3=N-n1-n2\n        for i in rng.choice(right,n1,replace=False): p[i]=alt_for(pred[i],[])\n        ws=rng.choice(wrong,n2+n3,replace=False)\n        for i in ws[:n2]: p[i]=gold[i]\n        for i in ws[n2:]: p[i]=alt_for(pred[i],[gold[i]])\n        a=(p==gold).mean(); F=f1m(gold,p)\n        A=a<acc0-0.01-1e-9; B=F<F0-0.02-1e-9\n        fa+=A; ff+=B; fe+=(A or B); dacc.append(a-acc0)\n    return fa/T, ff/T, fe/T, np.mean(dacc)\nfor N in [4,6,8,10,13,17,22,28]:\n    print(N, 'P(fail acc) %.3f  P(fail F1) %.3f  P(fail any) %.3f  mean dacc %.4f'%sim(N, T=4000))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
