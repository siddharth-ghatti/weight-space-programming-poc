{"id": "toolu_01DtmQAv84bVeW58wwvFyut7", "caller": {"type": "direct"}, "input": {"code": "import json\nbl=np.load('base_logits.npy'); y=np.load('y.npy')\npb=bl.argmax(1); s=np.sort(bl,1); marg=s[:,-1]-s[:,-2]; ru=np.argsort(bl,1)[:,-2]\ndef dmarg(lg):\n    # change in (base-pred logit - max other logit)\n    oth=np.where(np.eye(4)[pb]>0,-np.inf,lg).max(1)\n    return (lg[np.arange(1000),pb]-oth)-marg\nfor f in ['lg_pass25.npy','lg_pass31_m1792v2.npy','lg_pass30_m2048v2.npy']:\n    lg=np.load(f); dm=dmarg(lg)\n    print(f,'mean dm all %.3f'%dm.mean())\n    for a,b in [(0,.5),(.5,1),(1,2),(2,4),(4,99)]:\n        m=(marg>=a)&(marg<b); r=m&(pb==y); w=m&(pb!=y)\n        print('  marg %.1f-%.1f n=%3d mean dm %.3f sd %.3f | base right n=%3d %.3f | base wrong n=%2d %.3f'%(a,b,m.sum(),dm[m].mean(),dm[m].std(),r.sum(),dm[r].mean() if r.sum() else 0,w.sum(),dm[w].mean() if w.sum() else 0))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
