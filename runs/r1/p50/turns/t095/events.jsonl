{"id": "toolu_01M37x1TFGr37R92bXzNz1ST", "caller": {"type": "direct"}, "input": {"code": "exec(open('seq.py').read())\nrng=np.random.default_rng(1)\niscls0=np.load('ffn_in_L0_iscls.npy').astype(bool)\nfor L in range(5):\n    A,S=all_data(L); A=A.astype(np.float64)\n    # cls flag: first token of each sequence (S changes)\n    iscls=np.r_[True, S[1:]!=S[:-1]]\n    useq=np.unique(S); te_seq=rng.choice(useq,len(useq)//4,replace=False); te=np.isin(S,te_seq); tr=~te\n    pre=f\"roberta.encoder.layer.{L}.\"\n    W1=base(pre+\"intermediate.dense.weight\").astype(np.float64); b1=base(pre+\"intermediate.dense.bias\")\n    W2=base(pre+\"output.dense.weight\").astype(np.float64); b2=base(pre+\"output.dense.bias\"); g2=base(pre+\"output.LayerNorm.weight\")\n    H=gelu(A@W1.T+b1); F=H@W2.T; U=A+F+b2; sig=U.std(1,keepdims=True)\n    m=1536; sc=H[tr].var(0)*(W2**2).sum(0); order=np.argsort(-sc); keep=np.sort(order[:m]); drop=order[m:]\n    T=H[:,drop]@W2[:,drop].T; X=H[:,keep]; mu=X[tr].mean(0); Xc=X[tr]-mu; G=Xc.T@Xc\n    B=np.linalg.solve(G+0.1*np.trace(G)/m*np.eye(m), Xc.T@(T[tr]-T[tr].mean(0)))\n    E=T-((X-mu)@B+T[tr].mean(0)); Eo=(E-E.mean(1,keepdims=True))/sig*g2\n    en=(Eo**2).sum(1)\n    print(L, 'n_cls', iscls.sum(), 'post-LN err energy: cls test %.3f  tok test %.3f | cls train %.3f tok train %.3f'%(en[te&iscls].mean(), en[te&~iscls].mean(), en[tr&iscls].mean(), en[tr&~iscls].mean()),\n          ' sigma cls %.1f tok %.1f'%(sig[iscls].mean(), sig[~iscls].mean()))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
