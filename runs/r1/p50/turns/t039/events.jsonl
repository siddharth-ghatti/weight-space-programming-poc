{"id": "toolu_01QppHtLtCc89ysVR9fyEbAG", "caller": {"type": "direct"}, "input": {"code": "exec(open(WORK/'builder.py').read())\nfor Lr in range(6):\n    pre=f\"roberta.encoder.layer.{Lr}.\"\n    W1 = base(pre+\"intermediate.dense.weight\"); b1 = base(pre+\"intermediate.dense.bias\"); W2 = base(pre+\"output.dense.weight\")\n    A = ffn_data(Lr); Z = A@W1.T+b1\n    q01 = np.quantile(Z,0.005,axis=0); q99 = np.quantile(Z,0.995,axis=0); fpos = (Z>0).mean(0)\n    dead = (q99< -2.5).sum(); lin = (q01>2.5).sum()\n    H = gelu(Z); sc = H.var(0)*(W2**2).sum(0); sc_sorted = np.sort(sc)[::-1]; cs = np.cumsum(sc_sorted)/sc.sum()\n    print(f\"L{Lr}: dead {dead}, linear {lin}, frac-active median {np.median(fpos):.3f}, sparsity: units for 90/95/99% var-score {np.searchsorted(cs,.9)}, {np.searchsorted(cs,.95)}, {np.searchsorted(cs,.99)}\")"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
