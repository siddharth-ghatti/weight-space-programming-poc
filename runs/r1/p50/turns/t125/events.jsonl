{"id": "toolu_01WTp7XPPRdoGFUBMVsHZtjZ", "caller": {"type": "direct"}, "input": {"code": "bl=np.load('base_logits.npy'); y=np.load('y.npy')\ndef stress(lg, ks=(1,1.5,2,3)):\n    pb=bl.argmax(1); out=[]\n    for k in ks:\n        # shrink base logits by k around their mean, add the same noise d\n        d=lg-bl; b2=bl/k; e=b2+d\n        out.append(int((e.argmax(1)!=pb).sum()))\n    return out\nfor f in ['lg_pass25.npy','lg_pass26.npy','lg_pass29.npy','lg_m1536_v2.npy']:\n    lg=np.load(f); print(f, stress(lg), 'rms',np.sqrt(((lg-bl)**2).mean()).round(4))\n# also earlier m2048 pass12?\nimport glob\nfor p in ['pass_12','pass_10','pass_11']:\n    try:\n        pr=json.load(open(p+'/predictions.json')); idx={r['id']:i for i,r in enumerate(pr)}\n        ids=json.load(open('all_ids.json'))\n        lg=np.array([pr[idx[i]]['logits_edited'] for i in ids])\n        print(p, stress(lg), np.sqrt(((lg-bl)**2).mean()).round(4))\n    except Exception as e: print(p,e)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
