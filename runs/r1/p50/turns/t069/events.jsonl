{"id": "toolu_01A71dqxT6RBvS5s3BNHXRc1", "caller": {"type": "direct"}, "input": {"code": "exec(open('common.py').read())\nimport json\ns = np.sort(BL,1); marg = s[:,-1]-s[:,-2]\ncands = {}\nfor d in ['pass_10','pass_12']:\n    m = json.load(open(d+'/meta.json'))\n    try: lg = np.load(d+'/logits.npy')\n    except Exception as e:\n        print(d, os.listdir(d)); continue\n    cands[d]=lg\nprint({k:v.shape for k,v in cands.items()})\nfor k,lg in cands.items():\n    p = lg.argmax(1); fl = p!=bp\n    bc = bp==y\n    print(k, 'flips', fl.sum(), 'base-correct broken', (fl&bc).sum(), 'base-wrong fixed', (fl&~bc&(p==y)).sum(), 'base-wrong->other wrong', (fl&~bc&(p!=y)).sum())\n    dm = lg - BL\n    # margin noise: change of (top - runner-up) of base classes\n    top = bp; ru = np.argsort(BL,1)[:,-2]\n    nm = (dm[np.arange(1000),top]-dm[np.arange(1000),ru])\n    print('  noise on margin: std', nm.std(), 'mean', nm.mean(), 'mean|.|', np.abs(nm).mean())\n    for lo,hi in [(0,0.5),(0.5,1),(1,2),(2,4),(4,99)]:\n        mk = (marg>=lo)&(marg<hi); print(f'   margin {lo}-{hi}: n {mk.sum()} flips {fl[mk].sum()} base acc {bc[mk].mean():.2f}')"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
