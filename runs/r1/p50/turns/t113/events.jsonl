{"id": "toolu_01WsmDAqoFJsZPPEwb4beEjG", "caller": {"type": "direct"}, "input": {"code": "exec(open('seq.py').read())\nimport time\nrng=np.random.default_rng(5)\ndef greedy_select(Hc_w, W2e, m, delta=0.05):\n    S=Hc_w.T@Hc_w/len(Hc_w); S+=delta*np.diag(np.diag(S))\n    W2S=W2e@S; chosen=[]; alive=np.ones(S.shape[0],bool)\n    for it in range(m):\n        d=np.diag(S); g=(W2S**2).sum(0)/np.maximum(d,1e-12); g[~alive]=-1\n        j=int(np.argmax(g)); chosen.append(j); alive[j]=False\n        s=S[:,j].copy(); sj=s[j]\n        S-=np.outer(s,s)/sj; W2S-=np.outer(W2S[:,j],s)/sj\n    return np.sort(chosen)\nfor L in [0,2,3]:\n    A,S_=all_data(L); A=A.astype(np.float64)\n    useq=np.unique(S_); te_seq=rng.choice(useq,len(useq)//4,replace=False); te=np.isin(S_,te_seq); tr=~te\n    pre=f\"roberta.encoder.layer.{L}.\"\n    W1=base(pre+\"intermediate.dense.weight\").astype(np.float64); b1=base(pre+\"intermediate.dense.bias\")\n    W2=base(pre+\"output.dense.weight\").astype(np.float64); b2=base(pre+\"output.dense.bias\"); g2=base(pre+\"output.LayerNorm.weight\").astype(np.float64)\n    H=gelu(A@W1.T+b1); U=A+H@W2.T+b2; sig=U.std(1,keepdims=True)\n    m=1536; Htr=H[tr]; Hc=Htr-Htr.mean(0); w=1/sig[tr]**2\n    kv=np.sort(np.argsort(-(Htr.var(0)*(W2**2).sum(0)))[:m])\n    kg=greedy_select(Hc,W2,m)\n    kgw=greedy_select(Hc*np.sqrt(w/w.mean()), g2[:,None]*W2, m)\n    for name,keep in [('var',kv),('greedy',kg),('greedy_w',kgw)]:\n        drop=np.setdiff1d(np.arange(3072),keep)\n        T=H[:,drop]@W2[:,drop].T; X=H[:,keep]; mu=X[tr].mean(0); Xc=X[tr]-mu; G=Xc.T@Xc\n        B=np.linalg.solve(G+0.1*np.trace(G)/m*np.eye(m), Xc.T@(T[tr]-T[tr].mean(0)))\n        E=T[te]-((X[te]-mu)@B+T[tr].mean(0)); en=(((E-E.mean(1,keepdims=True))/sig[te]*g2)**2).sum(1).mean()\n        print(L,name,'test %.3f'%en, flush=True)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
