{"id": "toolu_01X4tmeF1eHAvFCgKJPZ5cFF", "caller": {"type": "direct"}, "input": {"code": "helper = r'''\ndef probe_on(L):\n    pre = f\"roberta.encoder.layer.{L}.\"\n    save_edit(pre+\"attention.output.LayerNorm.weight\", np.ones(768, np.float32))\n    save_edit(pre+\"attention.output.LayerNorm.bias\", np.zeros(768, np.float32))\n    save_edit(pre+\"output.dense.weight\", np.zeros((768,3072), np.float32))\n    save_edit(pre+\"output.dense.bias\", np.zeros(768, np.float32))\n    save_edit(pre+\"output.LayerNorm.weight\", np.ones(768, np.float32))\n    save_edit(pre+\"output.LayerNorm.bias\", np.zeros(768, np.float32))\n    set_structure(layers=list(range(L+1)), ffn_keep=3072)\ndef probe_off(L):\n    pre = f\"roberta.encoder.layer.{L}.\"\n    for s in [\"attention.output.LayerNorm.weight\",\"attention.output.LayerNorm.bias\",\"output.dense.weight\",\"output.dense.bias\",\"output.LayerNorm.weight\",\"output.LayerNorm.bias\"]:\n        drop_edit(pre+s)\n'''\nopen(WORK/'probe.py','w').write(helper)\nP = practice(); toks = tokenize([x['text'] for x in P])\nL = np.array([len(t['ids']) for t in toks]); y = np.load(WORK/'y.npy')\nrng = np.random.default_rng(1)\nsel=[]\nfor k,cnt in zip(range(4),[6,8,10,8]):\n    cand = np.where((y==k)&(L>=120)&(L<=330))[0]\n    sel += list(rng.choice(cand, cnt, replace=False))\nsel = sorted(sel)\nprint(len(sel), L[sel].sum(), L[sel].max(), [P[i]['id'] for i in sel])\njson.dump([P[i]['id'] for i in sel], open(WORK/'probe_ids.json','w'))\nexec(helper)\nprobe_on(0); print(edits(), structure()['layers'])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
