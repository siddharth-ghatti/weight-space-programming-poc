{"id": "toolu_01HMfakvf5iwx4GtTi12XBPE", "caller": {"type": "direct"}, "input": {"code": "exec(open(WORK/'builder.py').read())\nA = ffn_data(5); pre=\"roberta.encoder.layer.5.\"\nW1 = base(pre+\"intermediate.dense.weight\"); b1 = base(pre+\"intermediate.dense.bias\"); W2 = base(pre+\"output.dense.weight\"); b2=base(pre+\"output.dense.bias\")\nH = gelu(A@W1.T+b1); R = A + H@W2.T + b2\neven = np.arange(1000)%2==0; odd=~even\nRv = R[odd]-R[even].mean(0)\nprint('varying norm of pre-LN R at L5 CLS', np.linalg.norm(Rv,axis=1).mean(), 'full', np.linalg.norm(R[odd]-R[odd].mean(1,keepdims=True),axis=1).mean())\nfor m in [1024,1536,2048,2560]:\n    sc = H[even].var(0)*(W2**2).sum(0); keep=np.argsort(-sc)[:m]; drop=np.setdiff1d(np.arange(3072),keep)\n    Hk=H[:,keep]; mk=Hk[even].mean(0); T=H[:,drop]@W2[:,drop].T; mt=T[even].mean(0)\n    Xk=Hk[even]-mk; G=Xk.T@Xk\n    out=[]\n    for lr in [None,0.01,0.1,1.0]:\n        if lr is None: B=np.zeros((m,768))\n        else: B=np.linalg.solve(G+lr*np.trace(G)/m*np.eye(m), Xk.T@(T[even]-mt))\n        D=T[odd]-mt-(Hk[odd]-mk)@B; D-=D.mean(1,keepdims=True)\n        out.append(f\"lam{lr}: {np.linalg.norm(D)/np.linalg.norm(Rv):.3f}\")\n    print(m, ' '.join(out))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
