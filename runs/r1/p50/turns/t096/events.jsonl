{"id": "toolu_01XcAAvSVcFgME7hadBJU1Nj", "caller": {"type": "direct"}, "input": {"code": "exec(open('seq.py').read())\nrng=np.random.default_rng(2)\nfor L in [1,2]:\n    A,S=all_data(L); A=A.astype(np.float64)\n    useq=np.unique(S); te_seq=rng.choice(useq,len(useq)//4,replace=False); te=np.isin(S,te_seq); trall=np.where(~te)[0]\n    trseq=np.setdiff1d(useq,te_seq); rng.shuffle(trseq)\n    pre=f\"roberta.encoder.layer.{L}.\"\n    W1=base(pre+\"intermediate.dense.weight\").astype(np.float64); b1=base(pre+\"intermediate.dense.bias\")\n    W2=base(pre+\"output.dense.weight\").astype(np.float64)\n    H=gelu(A@W1.T+b1); F=H@W2.T; den=((F[te]-F[te].mean(0))**2).sum()\n    m=1536\n    for frac in [0.25,0.5,0.75,1.0]:\n        tr=np.isin(S, trseq[:int(len(trseq)*frac)])&~te\n        sc=H[tr].var(0)*(W2**2).sum(0); order=np.argsort(-sc); keep=np.sort(order[:m]); drop=order[m:]\n        T=H[:,drop]@W2[:,drop].T; X=H[:,keep]; mu=X[tr].mean(0); Xc=X[tr]-mu; G=Xc.T@Xc\n        B=np.linalg.solve(G+0.1*np.trace(G)/m*np.eye(m), Xc.T@(T[tr]-T[tr].mean(0)))\n        E=T[te]-((X[te]-mu)@B+T[tr].mean(0))\n        print(L, frac, tr.sum(), 'test rel %.4f'%((E**2).sum()/den), flush=True)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
