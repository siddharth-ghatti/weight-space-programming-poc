{"id": "toolu_01SHxer7YgxgWpHSbYP7Ra3U", "caller": {"type": "direct"}, "input": {"code": "exec(open('seq.py').read())\ndef evalw(L, m, lam_rel, weighted, gsel):\n    A, S = all_data(L); te = (S<100)&(S%2==1); tr=~te\n    pre = f\"roberta.encoder.layer.{L}.\"\n    W1 = base(pre+\"intermediate.dense.weight\").astype(np.float64); b1 = base(pre+\"intermediate.dense.bias\")\n    W2 = base(pre+\"output.dense.weight\").astype(np.float64); b2 = base(pre+\"output.dense.bias\")\n    g2 = base(pre+\"output.LayerNorm.weight\").astype(np.float64)\n    A = A.astype(np.float64); H = gelu(A@W1.T+b1); Z = A + H@W2.T + b2\n    sig = Z.std(1)\n    w = 1/sig**2 if weighted else np.ones(len(A))\n    colw = (g2[:,None]**2*W2**2).sum(0) if gsel else (W2**2).sum(0)\n    Htr = H[tr]; wt = w[tr]/w[tr].mean()\n    mu = (wt[:,None]*Htr).sum(0)/wt.sum()\n    sc = ((wt[:,None]*(Htr-mu)**2).sum(0)/wt.sum())*colw\n    keep = np.sort(np.argsort(-sc)[:m]); drop = np.setdiff1d(np.arange(3072), keep)\n    T = H[:,drop]@W2[:,drop].T\n    Hk = H[:,keep]; mk = (wt[:,None]*Hk[tr]).sum(0)/wt.sum(); mt = (wt[:,None]*T[tr]).sum(0)/wt.sum()\n    X = (Hk[tr]-mk)*np.sqrt(wt)[:,None]; Tt = (T[tr]-mt)*np.sqrt(wt)[:,None]\n    G = X.T@X; B = np.linalg.solve(G+lam_rel*np.trace(G)/m*np.eye(m), X.T@Tt)\n    err = T[te] - ((Hk[te]-mk)@B + mt)\n    errc = err - err.mean(1,keepdims=True)\n    post = (g2*errc)/sig[te][:,None]\n    # reference: varying part of post-LN output\n    return np.sqrt((post**2).sum(1)).mean()\nfor L in [0,1,3,4]:\n    r = [evalw(L,1024,0.1,wgt,gs) for wgt,gs in [(False,False),(True,False),(False,True),(True,True)]]\n    print(L, np.round(r,4))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
