{"id": "toolu_01Te8Z3iEtbiE8z3GzeRqZF4", "caller": {"type": "direct"}, "input": {"code": "exec(open(WORK/'builder.py').read())\nM = np.load(WORK/'pass_4/attention_mask.npy').astype(bool)\npara = np.repeat(np.arange(32)[:,None], M.shape[1], 1)[M]; tr = para%2==0; te=~tr\nfor Lr in range(5):\n    pre=f\"roberta.encoder.layer.{Lr}.\"\n    W1 = base(pre+\"intermediate.dense.weight\"); b1 = base(pre+\"intermediate.dense.bias\"); W2 = base(pre+\"output.dense.weight\"); b2=base(pre+\"output.dense.bias\")\n    A = ffn_data(Lr); H = gelu(A@W1.T+b1); R = A+H@W2.T+b2\n    Rv = R[te]-R[tr].mean(0)   # token-varying part\n    out=[]\n    for m in [1536,2048]:\n        sc=H[tr].var(0)*(W2**2).sum(0); keep=np.argsort(-sc)[:m]; drop=np.setdiff1d(np.arange(3072),keep)\n        Hk=H[:,keep]; T=H[:,drop]@W2[:,drop].T\n        mk=Hk[tr].mean(0); mt=T[tr].mean(0); Xk=Hk[tr]-mk; G=Xk.T@Xk\n        for lr in [None,0.3,1.0,3.0]:\n            B=np.zeros((m,768)) if lr is None else np.linalg.solve(G+lr*np.trace(G)/m*np.eye(m), Xk.T@(T[tr]-mt))\n            D=T[te]-mt-(Hk[te]-mk)@B\n            out.append(f\"m{m} lam{lr}: {np.linalg.norm(D)/np.linalg.norm(Rv):.3f}\")\n        # in-sample bound on test half\n        X2=Hk[te]-Hk[te].mean(0); T2=T[te]-T[te].mean(0); B2=np.linalg.lstsq(X2,T2,rcond=None)[0]\n        out.append(f\"m{m} insample: {np.linalg.norm(T2-X2@B2)/np.linalg.norm(Rv):.3f}\")\n    print(f\"L{Lr}\", ' | '.join(out))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
