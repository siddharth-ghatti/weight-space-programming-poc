{"id": "toolu_01Cz4wor9nPEqMYi2cwwEsCr", "caller": {"type": "direct"}, "input": {"code": "import json\nexec(open('risk.py').read())\ns_=np.sort(bl,1); margA=s_[:,-1]-s_[:,-2]; rank=np.argsort(-bl,1); order=np.argsort(margA)\ndef risk_donor(lg, k, R=6000, N=400, seed=3, allow=4, randsign=False, nd=30):\n    rng=np.random.default_rng(seed)\n    D=np.take_along_axis(lg-bl,rank,1)\n    P=sm(bl/k); cum=P.cumsum(1)\n    idxs=rng.integers(0,1000,(R,N)); u=rng.random((R,N))\n    G=(u[...,None]>cum[idxs]).sum(-1)\n    bp=bl.argmax(1)[idxs]; fb=f1macro_batch(G,bp); ab=(bp==G).sum(1)\n    pos=np.searchsorted(margA[order], margA/k); off=rng.integers(-nd//2, nd//2, (R,N))\n    donor=order[np.clip(pos[idxs]+off,0,999)]\n    dn=D[donor]*(np.where(rng.random((R,N))<.5,-1,1)[...,None] if randsign else 1)\n    noise=np.zeros_like(dn); np.put_along_axis(noise, rank[idxs], dn, -1)\n    ep=(bl[idxs]/k+noise).argmax(-1)\n    da=(ep==G).sum(1)-ab; fe=f1macro_batch(G,ep)\n    return ((da<-allow)|(fe<fb-0.02)).mean()\nM={'v1':np.load('lg_pass25.npy'),'v2':np.load('lg_pass26.npy'),'v3':np.load('lg_pass29.npy')}\nfor n,l in M.items():\n    r=[risk_donor(l,1.25,seed=s,randsign=rs) for s in (11,12) for rs in (False,True)]\n    print(n, np.round(r,3), 'mean %.3f'%np.mean(r))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
