{"id": "toolu_01KiFt9Q836cHpvGs4LPn9uo", "caller": {"type": "direct"}, "input": {"code": "exec(open('seq.py').read())\nL=4\nextract_probe(L, 'pass_22', 5, 'B1'); extract_probe(L, 'pass_23', 5, 'B2')\nA, S = all_data(L); te = (S<100) & (S%2==1)\ndef holdout(L, m, lam_rel, A, S, te):\n    tr = ~te\n    keep,B,mk,mt = fit_layer(L, m, lam_rel, A=A[tr], save=False)\n    pre = f\"roberta.encoder.layer.{L}.\"\n    W1 = base(pre+\"intermediate.dense.weight\").astype(np.float64); b1 = base(pre+\"intermediate.dense.bias\")\n    W2 = base(pre+\"output.dense.weight\").astype(np.float64)\n    At = A[te].astype(np.float64); H = gelu(At@W1.T+b1); Y = H@W2.T; Z = At+Y\n    drop = np.setdiff1d(np.arange(3072), keep)\n    T = H[:,drop]@W2[:,drop].T; pred = (H[:,keep]-mk)@B + mt\n    den = np.sqrt(((Z-Z.mean(0))**2).sum(1)).mean()\n    return round(np.sqrt(((T-pred)**2).sum(1)).mean()/den,4), round(np.sqrt(((T-T.mean(0))**2).sum(1)).mean()/den,4)\nprint([(lr, holdout(L,1024,lr,A,S,te)) for lr in [0.1]])\nrestore_layer(L)\nfit_layer(L, 1024, 0.05)\nprint(setup_probe(L+1, 1024)); print(load_keeps().keys())\nids = json.load(open(WORK/'all_ids.json')); print(len(ids))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
