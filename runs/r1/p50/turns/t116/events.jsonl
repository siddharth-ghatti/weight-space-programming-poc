{"id": "toolu_01VknuP14UFg7MkZgT2LVo2w", "caller": {"type": "direct"}, "input": {"code": "exec(open('common.py').read())\ns=np.argsort(-BL,1); t1=s[:,0]; t2=s[:,1]\nmarg=BL[np.arange(1000),t1]-BL[np.arange(1000),t2]; right=bp==y\ndef debiased_flips(lg):\n    # noise on runner-up pairwise margin\n    dm=(lg[np.arange(1000),t1]-lg[np.arange(1000),t2])-marg\n    eps=dm.copy(); eps[right]-=dm[right].mean(); eps[~right]-=dm[~right].mean()\n    # expected flips: P(eps < -mu) using empirical eps distribution (ignore self)\n    es=np.sort(eps)\n    pf=np.searchsorted(es, -marg)/len(es)\n    return pf.sum(), eps.std(), (lg.argmax(1)!=bp).sum()\nfor name in ['lg_pass25.npy','lg_pass26.npy','lg_D1_L01.npy','lg_D2_L234.npy']:\n    E,sd,obs=debiased_flips(np.load(name))\n    print(f'{name}: observed flips {obs}, de-biased expected practice flips {E:.1f}, eps std {sd:.3f}; test N for k=1,1.5,2,3: '+', '.join(f'{0.4*k*E:.1f}' for k in [1,1.5,2,3]))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
