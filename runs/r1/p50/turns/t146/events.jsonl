{"id": "toolu_01SApnis6gk8Xu9wSTnNKkGD", "caller": {"type": "direct"}, "input": {"code": "import json\nbl=np.load('base_logits.npy'); y=np.load('y.npy')\npb=bl.argmax(1); s=np.sort(bl,1); marg=s[:,-1]-s[:,-2]\ndef dmarg(lg):\n    oth=np.where(np.eye(4)[pb]>0,-np.inf,lg).max(1)\n    return (lg[np.arange(1000),pb]-oth)-marg\nM={'v1':'lg_pass25.npy','v2':'lg_pass26.npy','v3':'lg_pass29.npy','m1792':'lg_pass31_m1792v2.npy','m2048':'lg_pass30_m2048v2.npy'}\nfor n,f in M.items():\n    lg=np.load(f); dm=dmarg(lg)\n    out=[np.sqrt((dm[(marg>=a)&(marg<b)]**2).mean()) for a,b in [(0,1),(1,2),(2,99)]]\n    # soft flip score: expected flips if noise were gaussian w/ item's |dm| under shrink k=1.25\n    from math import erf\n    print('%-6s dm rms by margin [<1, 1-2, >2]:'%n, np.round(out,3), ' overall %.3f'%np.sqrt((dm**2).mean()))\n# paired comparison v1 vs v3 per item on low margin\nd1=dmarg(np.load('lg_pass25.npy')); d3=dmarg(np.load('lg_pass29.npy'))\nm=marg<2\nprint('low-margin items: frac where |dm_v3|<|dm_v1|: %.3f'%(np.abs(d3[m])<np.abs(d1[m])).mean(), ' n',m.sum())\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
