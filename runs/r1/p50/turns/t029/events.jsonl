{"id": "toolu_019cEjzzB7qtXwWgfryVEpsw", "caller": {"type": "direct"}, "input": {"code": "builder2 = r'''\ndef build_layer_zero(Lr, m, lam_rel, fit_mask=None):\n    \"\"\"Prune by zeroing dropped W2 columns (structure stays full). fit_mask: rows of data used for fitting.\"\"\"\n    pre = f\"roberta.encoder.layer.{Lr}.\"\n    W1 = base(pre+\"intermediate.dense.weight\"); b1 = base(pre+\"intermediate.dense.bias\")\n    W2 = base(pre+\"output.dense.weight\"); b2 = base(pre+\"output.dense.bias\")\n    A = ffn_data(Lr)\n    if fit_mask is not None: A = A[fit_mask]\n    H = gelu(A@W1.T + b1)\n    sc = H.var(0)*(W2**2).sum(0)\n    keep = np.sort(np.argsort(-sc)[:m]); drop = np.setdiff1d(np.arange(3072), keep)\n    Hk = H[:,keep]; mk = Hk.mean(0); T = H[:,drop]@W2[:,drop].T; mt = T.mean(0)\n    if lam_rel is None: B = np.zeros((m,768))\n    else:\n        Xk = Hk-mk; G = Xk.T@Xk; lam = lam_rel*np.trace(G)/m\n        B = np.linalg.solve(G+lam*np.eye(m), Xk.T@(T-mt))\n    W2n = np.zeros_like(W2); W2n[:,keep] = W2[:,keep] + B.T\n    save_edit(pre+\"output.dense.weight\", W2n.astype(np.float32))\n    save_edit(pre+\"output.dense.bias\", (b2 + mt - mk@B).astype(np.float32))\n    return keep.tolist()\n'''\nopen(WORK/'builder.py','a').write(builder2)\nexec(open(WORK/'builder.py').read())\nfor e in edits(): drop_edit(e)\nclear_structure()\nfor Lr in range(5): build_layer_zero(Lr, 1024, 1.0)\nprint(edits(), structure()['m'])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
