{"id": "toolu_01K1cVtXtheB7xurriKN2EMj", "caller": {"type": "direct"}, "input": {"code": "exec(open(WORK/'common.py').read())\ndef margin_noise(lg, BL=BL):\n    o = np.argsort(-BL,1); t1, t2 = o[:,0], o[:,1]; r = np.arange(len(BL))\n    mb = BL[r,t1]-BL[r,t2]; me = lg[r,t1]-lg[r,t2]\n    return (me-mb).std(), np.abs(me-mb).mean()\nfor nm, pth in [('drop4 orig', 'pass_3'), ('m1536 orig','pass_10')]:\n    lg = np.load(WORK/pth/'logits.npy'); print(nm, 'margin noise std/mean|.|', margin_noise(lg))\n# test-flip estimate: assume test margins ~ base practice margins rescaled down; base practice margin stats\no = np.sort(BL,1); mb = o[:,-1]-o[:,-2]\nprint('practice margin pctiles', np.percentile(mb,[5,10,25,50,75]))\nprint('logit scale std', BL.std(0))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
