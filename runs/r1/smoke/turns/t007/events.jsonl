{"id": "toolu_01NLoqxRCzXjWmprT9iPwAFe", "caller": {"type": "direct"}, "input": {"code": "\nimport numpy as np\nclear_structure()\nprint(param_count()['total'], structure()['m'], structure()['layers'])\nopen('notes.md','a').write(\"\"\"\n- FINDING: edited 6L m=1536 (gaussian-energy pruning) is BROKEN: logits ~constant [-0.4,0,0.9,-0.4], always 'strategy' on 10 items; base p0000 was [-1.46,-1.39,-0.27,3.78]. DO NOT USE.\n- structure reset to full (clear_structure). Fallback = unpruned base (passes by construction).\n- Next idea: only prune FFN units that are PROVABLY ~dead from weights alone (Cauchy-Schwarz bound using LN: ||z||<=sqrt(768)).\n\"\"\")\nfrom scipy.special import erf\ndef gelu(x): return 0.5*x*(1+erf(x/np.sqrt(2)))\ndef gelu_absmax_interval(lo, hi):\n    # max |gelu| on [lo,hi]; gelu has min ~ -0.17 at x~-0.75; monotone for x>-0.75 ; for x<-0.75 |gelu| decreasing in |x|... compute on grid\n    xs = np.linspace(0,1,201)[None,:]\n    g = np.abs(gelu(lo[:,None] + (hi-lo)[:,None]*xs))\n    return g.max(1)\nres = {}\nfor l in range(6):\n    p = f'roberta.encoder.layer.{l}.'\n    Win = base(p+'intermediate.dense.weight'); b = base(p+'intermediate.dense.bias')\n    Wout = base(p+'output.dense.weight')\n    g = base(p+'attention.output.LayerNorm.weight'); be = base(p+'attention.output.LayerNorm.bias')\n    mu = Win@be + b\n    r = np.sqrt(768.0)*np.linalg.norm(Win*g[None,:],axis=1)\n    amax = gelu_absmax_interval(mu-r, mu+r)\n    bound = amax*np.linalg.norm(Wout,axis=0)\n    res[l]=bound\n    xs = np.sort(bound)\n    cs = np.cumsum(xs)\n    xnorm = np.sqrt((g**2).sum()+(be**2).sum())\n    print(l, 'ref |x|~%.1f'%xnorm, 'n(bound<1e-3)=',(bound<1e-3).sum(), 'n(<1e-2)=',(bound<1e-2).sum(), 'cumsum at 100/300/600: ', cs[[99,299,599]].round(3), 'min wout norm', np.linalg.norm(Wout,axis=0).min().round(4))\nnp.save('rigorous_bound.npy', np.stack([res[l] for l in range(6)]))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
