{"id": "toolu_01X2AWu43gRJW7M5LcgvbCju", "caller": {"type": "direct"}, "input": {"code": "exec(open(WORK/'build2.py').read())\nlab=np.load(WORK/'labels.npy'); N=len(lab)\nF=dict(np.load(WORK/'prep_feats.npz')); J=np.load(WORK/'joint_v2.npz')\nc12=np.load(WORK/'v2_c12.npy')\nparts=['m2','m6','m10']\nS=[F[p]@J[p] for p in parts]            # [N,8] each\nSc=[s-s.mean(1,keepdims=True) for s in S]\nr=c12[:,R]; rc=r-r.mean(1,keepdims=True)\nA=np.zeros((N,3)); res=np.zeros(N)\nfor i in range(N):\n    X=np.stack([Sc[k][i] for k in range(3)],1)*0.1\n    coef,_,_,_=np.linalg.lstsq(X,rc[i],rcond=None); A[i]=coef\n    res[i]=np.linalg.norm(rc[i]-X@coef)/np.linalg.norm(rc[i])\nprint('per-layer scale mean', A.mean(0).round(3), 'std', A.std(0).round(3), 'relres', res.mean().round(4), res.max().round(4))\n# global (pooled) fit of per-layer scale\nX=np.concatenate([np.stack([Sc[k][i] for k in range(3)],1) for i in range(N)])*0.1\ncoef,_,_,_=np.linalg.lstsq(X,rc.reshape(-1),rcond=None); print('pooled per-layer scales', coef.round(3))\nnp.save(WORK/'v2_layer_scales.npy', A)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
