{"id": "toolu_01SVhdbpZvd8nsJiHs9AaVbY", "caller": {"type": "direct"}, "input": {"code": "lab=np.load(WORK/'labels.npy'); N=len(lab); folds=np.load(WORK/'folds.npy'); Y=np.eye(8)[lab]\nR = [601, 222, 88, 83, 444, 506, 254, 495]; keep=np.setdiff1d(np.arange(768),R)\nM=np.load(WORK/'base_mean.npy'); E12=np.load(WORK/'ed1_cls12.npy'); a=np.load(WORK/'ed1_a.npy')\ndef oof(X,lam):\n    o=np.zeros((N,8))\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; Z=(X[tr]-mu)/sd\n        if Z.shape[1]>Z.shape[0]:\n            K=Z@Z.T; al=np.linalg.solve(K+lam*np.eye(len(K)),Y[tr]-Y[tr].mean(0)); o[te]=((X[te]-mu)/sd)@(Z.T@al)\n        else:\n            W=np.linalg.solve(Z.T@Z+lam*np.eye(Z.shape[1]), Z.T@(Y[tr]-Y[tr].mean(0))); o[te]=((X[te]-mu)/sd)@W\n    return o\nacc=lambda S:round((S.argmax(1)==lab).mean(),4)\nlate={lam:oof(E12[:,keep],lam) for lam in [30,100]}\nsets={'2':[2],'2,4,6,8,10':[2,4,6,8,10],'2..10':list(range(2,11)),'1..10':list(range(1,11)),'0,2..10':[0]+list(range(2,11)),'2,6,10':[2,6,10],'2,4':[2,4], '2,3':[2,3]}\nfor name,ls in sets.items():\n    X=np.concatenate([M[l][:,keep] for l in ls],1)\n    for lam in [300,1000]:\n        c=oof(X,lam*len(ls)**0.5)\n        print(name, lam, 'carried', acc(c), 'fusion', [(al,acc(al*c*(a/a.mean())[:,None]+late[30])) for al in [0.75,1,1.5,2]], flush=True)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
