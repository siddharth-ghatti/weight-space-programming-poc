{"id": "toolu_01WP85FrF5cjmsCRF95SbVbg", "caller": {"type": "direct"}, "input": {"code": "lab = np.load(WORK/'labels.npy'); N=len(lab); folds=np.load(WORK/'folds.npy'); Y=np.eye(8)[lab]\nM=np.load(WORK/'base_mean.npy'); C=np.load(WORK/'base_cls.npy')\ndef ridge_cv(X, lams, std=True):\n    res={}\n    for lam in lams:\n        pred=np.zeros(N,int)\n        for f in range(5):\n            tr=folds!=f; te=~tr\n            mu=X[tr].mean(0); sd=(X[tr].std(0)+1e-6) if std else np.ones(X.shape[1])\n            Xt=(X[tr]-mu)/sd; Xe=(X[te]-mu)/sd\n            # dual form for speed when d>n\n            if Xt.shape[1]>Xt.shape[0]:\n                K=Xt@Xt.T; a=np.linalg.solve(K+lam*np.eye(len(K)), Y[tr]-Y[tr].mean(0)); S=Xe@(Xt.T@a)\n            else:\n                Wt=np.linalg.solve(Xt.T@Xt+lam*np.eye(Xt.shape[1]), Xt.T@(Y[tr]-Y[tr].mean(0))); S=Xe@Wt\n            pred[te]=np.argmax(S,1)\n        res[lam]=round((pred==lab).mean(),4)\n    return res\ndef ln(X): \n    X=X-X.mean(1,keepdims=True); return X/np.sqrt((X**2).mean(1,keepdims=True)+1e-12)\ncombos={'m11':[M[11]],'m11_ln':[ln(M[11])],'m0+m11':[M[0],M[11]],'m6+m11':[M[6],M[11]],'m0+m6+m11':[M[0],M[6],M[11]],\n        'm11+c11':[M[11],C[11]],'m11+c12':[M[11],C[12]], 'm12':[M[12]], 'm0+m12':[M[0],M[12]], 'all_mean':[M[l] for l in range(0,13,2)]}\nfor k,v in combos.items():\n    X=np.concatenate(v,1)\n    print(k, ridge_cv(X,[30,100,300,1000]), flush=True)\nprint('m11 nostd', ridge_cv(M[11],[1,10,100],std=False))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
