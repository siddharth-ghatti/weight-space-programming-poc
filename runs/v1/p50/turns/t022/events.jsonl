{"id": "toolu_01SgrXgxbhBxKDmNodPtNjMs", "caller": {"type": "direct"}, "input": {"code": "lab=np.load(WORK/'labels.npy'); N=len(lab); folds=np.load(WORK/'folds.npy'); Y=np.eye(8)[lab]\nR = [601, 222, 88, 83, 444, 506, 254, 495]; keep=np.setdiff1d(np.arange(768),R)\nM=np.load(WORK/'base_mean.npy'); E12=np.load(WORK/'ed1_cls12.npy')\ndef oof(X,lams):\n    out={}\n    Ks=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; Z=(X[tr]-mu)/sd; Ze=(X[te]-mu)/sd\n        Ks.append((Z@Z.T, Ze@Z.T, tr, te))\n    for lam in lams:\n        o=np.zeros((N,8))\n        for K,Ke,tr,te in Ks:\n            al=np.linalg.solve(K+lam*np.eye(len(K)),Y[tr]-Y[tr].mean(0)); o[te]=Ke@al\n        out[lam]=round((o.argmax(1)==lab).mean(),4)\n    return out\nfor name,ls in {'2..10+E12':list(range(2,11)),'2,4,6,8,10+E12':[2,4,6,8,10],'2,6,10+E12':[2,6,10],'2+E12':[2], '2,4+E12':[2,4]}.items():\n    X=np.concatenate([M[l][:,keep] for l in ls]+[E12[:,keep]],1)\n    print(name, oof(X,[100,300,1000,3000]), flush=True)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
