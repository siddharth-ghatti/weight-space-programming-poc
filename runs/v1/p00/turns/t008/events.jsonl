{"id": "toolu_01UnUQvzZ4MrdDXosjVQRoyb", "caller": {"type": "direct"}, "input": {"code": "exec(open(WORK/'feat_lib.py').read())\nPm = build_P(30)\nFa = feats(Pm,'approx'); sc = np.linalg.norm(Fa,axis=1).mean(); Fa/=sc\ndef fit_ridge0(X, y, lam):\n    Yt = np.eye(8)[y]; Yt = Yt - Yt.mean(0)\n    return np.linalg.solve(X.T@X + lam*np.eye(X.shape[1]), X.T@Yt), np.zeros(8)\nacc,pr = cv(Fa,y,fit_ridge0,0.3)\nshort = ['COV','EXC','PREM','DED','CLM','DEF','TERM','COND']\nfor i in np.where(pr!=y)[0][:40]:\n    print(short[y[i]],'->',short[pr[i]],'|',P_[i]['register'],'|',texts[i][:150])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
