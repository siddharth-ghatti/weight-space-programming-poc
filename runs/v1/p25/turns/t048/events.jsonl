{"id": "toolu_018sbjZ7zBmSE1xJjSq6J25C", "caller": {"type": "direct"}, "input": {"code": "import numpy as np\nF=np.load('feats.npz'); y=F['y']; FOLDS=np.load('folds_rep.npy')\nC9=F['C9'].astype(np.float64); M9=F['M9'].astype(np.float64); M0=F['M0'].astype(np.float64)\ndef stdz(X,tr): m=X[tr].mean(0); s=X[tr].std(0)+1e-6; return (X-m)/s\ndef ridge_pred(Xtr,Y,lam,Xte):\n    xm=Xtr.mean(0); Xc=Xtr-xm; ym=Y.mean(0)\n    n,d=Xc.shape\n    if d<=n: Wt=np.linalg.solve(Xc.T@Xc+lam*np.eye(d),Xc.T@(Y-ym))\n    else: Wt=Xc.T@np.linalg.solve(Xc@Xc.T+lam*np.eye(n),Y-ym)\n    return (Xte-xm)@Wt+ym\ndef run(extra_fn, lams, w=1.0):\n    res={l:0 for l in lams}\n    for fo in FOLDS:\n        for f in range(5):\n            tr=fo!=f; te=fo==f\n            E=extra_fn(tr)\n            X=np.concatenate([stdz(C9,tr),stdz(M9,tr)]+([w*E] if E is not None else []),1)\n            Y=np.eye(8)[y[tr]]-1/8\n            for l in lams: res[l]+=(ridge_pred(X[tr],Y,l,X[te]).argmax(1)==y[te]).sum()\n    return {l:round(res[l]/len(y)/len(FOLDS),4) for l in lams}\nM0c=M0-M0.mean(0); U,S,Vt=np.linalg.svd(M0c,full_matrices=False)\nfor k in [8,16,32,64]:\n    P=M0c@Vt[:k].T; P=P/P.std(0)\n    for w in [1,3]:\n        print('PC',k,'w',w, run(lambda tr: P-P[tr].mean(0), [300,1000],w))\n# class-mean (LDA-ish) within fold\ndef lda_fn(k_reg):\n    def fn(tr):\n        X=M0; mu=X[tr].mean(0); Xs=(X-mu)\n        Sw=np.cov((Xs[tr]-np.array([Xs[tr][y[tr]==c].mean(0) for c in range(8)])[y[tr]]).T)\n        Mc=np.array([Xs[tr][y[tr]==c].mean(0) for c in range(8)])\n        W=np.linalg.solve(Sw+k_reg*np.trace(Sw)/768*np.eye(768),Mc.T)  # 768x8\n        P=Xs@W; return P/P[tr].std(0)\n    return fn\nfor kr in [0.1,1.0]:\n    for w in [1,3]:\n        print('LDA reg',kr,'w',w, run(lda_fn(kr),[300,1000],w))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
