{"id": "toolu_01T6xCSXPSE5qa99wgbw4uVu", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy')\ndef stdz(X,tr): mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd\ndef cv(featfn, lam):\n    accs=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Z=featfn(tr); mu=Z[tr].mean(0); Zc=Z-mu\n        Y=np.eye(8)[y[tr]]-1/8\n        K=Zc@Zc[tr].T; a=np.linalg.solve(K[tr]+lam*np.eye(tr.sum()),Y); pr=K[te]@a\n        accs.append((np.argmax(pr,1)==y[te]).mean())\n    return round(np.mean(accs),4)\nfor k in [4,5,6,8]:\n    tr=folds!=0; te=~tr\n    A=stdz(F['C11'],tr); B=F[f'C{k}']; B=B-B[tr].mean(0)\n    for lam in [10,100]:\n        R=np.linalg.solve(A[tr].T@A[tr]+lam*np.eye(768),A[tr].T@B[tr])\n        print('C11->C%d'%k,lam, round(1-((A[te]@R-B[te])**2).sum()/((B[te])**2).sum(),3))\nfor Ls in [['M4','M11'],['M5','M11'],['M4','M10'],['M2','M11'],['M4','M6','M11']]:\n    fn=lambda tr: np.concatenate([stdz(F[k],tr) for k in Ls],1)/np.sqrt(len(Ls))\n    print(Ls,[cv(fn,l) for l in [30,100,300]])\n# variability of CLS states across sentences\nfor k in [3,4,5]:\n    C=F[f'C{k}']; print('C%d'%k,'mean norm',np.linalg.norm(C.mean(0)).round(2),'std norm',np.sqrt(((C-C.mean(0))**2).sum(1).mean()).round(2))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
