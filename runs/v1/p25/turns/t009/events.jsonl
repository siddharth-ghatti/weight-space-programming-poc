{"id": "toolu_01YU3pWRzTXKpMjf3A4WjAny", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy')\ndef LN(X): \n    X=X-X.mean(1,keepdims=True); return X/np.sqrt((X**2).mean(1,keepdims=True)+1e-12)\ndef gelu(x): \n    from scipy.special import erf; return 0.5*x*(1+erf(x/np.sqrt(2)))\ndef cv(featfn, lam):\n    accs=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Z=featfn(tr)\n        mu=Z[tr].mean(0); Zc=Z-mu\n        Y=np.eye(8)[y[tr]]-1/8\n        if Z.shape[1]>tr.sum():\n            K=Zc@Zc[tr].T; a=np.linalg.solve(K[tr]+lam*np.eye(tr.sum()),Y); pr=K[te]@a\n        else:\n            A=np.linalg.solve(Zc[tr].T@Zc[tr]+lam*np.eye(Z.shape[1]),Zc[tr].T@Y); pr=Zc[te]@A\n        accs.append((np.argmax(pr,1)==y[te]).mean())\n    return round(np.mean(accs),4)\nfor L in [11,12,6]:\n    X=LN(F[f'M{L}'])\n    print(L,'lin LN', [cv(lambda tr: X, l) for l in [1,3,10,30,100]])\n    def stdz(tr): mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd\n    print(L,'lin std', [cv(stdz, l) for l in [30,100,300]])\nX=LN(F['M11'])\nrng=np.random.RandomState(1)\nfor sc in [0.5,1,2]:\n    def rf(tr):\n        mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; Xs=(X-mu)/sd\n        R=rng.randn(768,3072)*sc/np.sqrt(768); b=rng.randn(3072)*0.5\n        return np.concatenate([Xs, gelu(Xs@R+b)],1)\n    print('rf',sc,[cv(rf,l) for l in [10,30,100,300]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
