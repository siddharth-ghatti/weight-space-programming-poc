{"id": "toolu_0125QTUeagkwxUGQKF4rxUiM", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy')\ndef stdz(X,tr): mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd\ndef cv(featfn, lam):\n    accs=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Z=featfn(tr); mu=Z[tr].mean(0); Zc=Z-mu\n        Y=np.eye(8)[y[tr]]-1/8\n        K=Zc@Zc[tr].T; a=np.linalg.solve(K[tr]+lam*np.eye(tr.sum()),Y); pr=K[te]@a\n        accs.append((np.argmax(pr,1)==y[te]).mean())\n    return round(np.mean(accs),4)\nfor k in [4,5,6,7,8,9]:\n    fn=lambda tr: np.concatenate([stdz(F[f'M{k}'],tr),stdz(F['M11'],tr)],1)\n    print('M%d+M11'%k,[cv(fn,l) for l in [30,100,200,400]])\ndef pca(X,tr,r,white=False):\n    Xs=stdz(X,tr); U,S,Vt=np.linalg.svd(Xs[tr],full_matrices=False); Z=Xs@Vt[:r].T\n    return Z/S[:r]*np.sqrt(tr.sum()) if white else Z\nfor r in [256,384,512]:\n    fn=lambda tr: np.concatenate([pca(F['M6'],tr,r),pca(F['M11'],tr,r)],1)\n    print('pca',r,'M6+M11',[cv(fn,l) for l in [30,100,200,400]])\nfn=lambda tr: pca(F['M11'],tr,384); print('M11 pca384 alone',[cv(fn,l) for l in [30,100,200]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
