{"id": "toolu_01Dp1P9PSgJdcFnPAeW8xVyh", "caller": {"type": "direct"}, "input": {"code": "import numpy as np, time\nF=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy')\nC9=F['C9'].astype(np.float64); M9=F['M9'].astype(np.float64)\nprint(folds.shape, folds[:10], np.bincount(folds) if folds.ndim==1 else None)\ndef gelu(z):\n    from scipy.special import erf\n    return 0.5*z*(1+erf(z/np.sqrt(2)))\ndef ridge_fit(X,Y,lam):\n    xm=X.mean(0); Xc=X-xm; ym=Y.mean(0)\n    n,d=X.shape\n    if d<=n: Wt=np.linalg.solve(Xc.T@Xc+lam*np.eye(d),Xc.T@(Y-ym))\n    else: Wt=Xc.T@np.linalg.solve(Xc@Xc.T+lam*np.eye(n),Y-ym)\n    return Wt, ym-xm@Wt\ndef cv(featfn, lams, fold=folds):\n    res={l:0 for l in lams}\n    for f in range(5):\n        tr=fold!=f; te=fold==f\n        Xtr,Xte=featfn(tr,te)\n        Y=np.eye(8)[y[tr]]-1/8\n        for l in lams:\n            Wt,b=ridge_fit(Xtr,Y,l); res[l]+=( (Xte@Wt+b).argmax(1)==y[te]).sum()\n    return {l:res[l]/len(y) for l in lams}\nZ=np.concatenate([C9,M9],1)\ndef lin(tr,te):\n    mu=Z[tr].mean(0); sd=Z[tr].std(0)+1e-6\n    return (Z[tr]-mu)/sd,(Z[te]-mu)/sd\nprint('linear', cv(lin,[100,300,1000]))\ndef kern(beta,theta,wlin=1.0):\n    def fn(tr,te):\n        mu=Z[tr].mean(0); sd=Z[tr].std(0)+1e-6\n        A=(Z[tr]-mu)/sd; Bt=(Z[te]-mu)/sd\n        An=A/np.linalg.norm(A,axis=1,keepdims=True); Bn=Bt/np.linalg.norm(Bt,axis=1,keepdims=True)\n        Ktr=gelu(beta*(An@An.T)-theta); Kte=gelu(beta*(Bn@An.T)-theta)\n        return np.concatenate([wlin*A,Ktr],1),np.concatenate([wlin*Bt,Kte],1)\n    return fn\nt=time.time()\nfor beta,theta in [(10,3),(10,5),(20,8),(5,1)]:\n    print(beta,theta, cv(kern(beta,theta,0.3),[1,10,100]), time.time()-t)"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
