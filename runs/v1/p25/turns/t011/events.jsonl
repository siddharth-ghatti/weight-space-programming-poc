{"id": "toolu_01Bvw5SwWdRdN7kgeuNDLyPd", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy')\ndef LN(X): \n    X=X-X.mean(1,keepdims=True); return X/np.sqrt((X**2).mean(1,keepdims=True)+1e-12)\ndef cv(featfn, lam):\n    accs=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Z=featfn(tr); mu=Z[tr].mean(0); Zc=Z-mu\n        Y=np.eye(8)[y[tr]]-1/8\n        K=Zc@Zc[tr].T; a=np.linalg.solve(K[tr]+lam*np.eye(tr.sum()),Y); pr=K[te]@a\n        accs.append((np.argmax(pr,1)==y[te]).mean())\n    return round(np.mean(accs),4)\ndef stdz(X,tr): mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd\nfor name,Xs in [('C11+M11',['C11','M11']),('C12+M11',['C12','M11']),('C1+M11',['C1','M11']),('C11+M0+M11',['C11','M0','M11']),('M0+M10',['M0','M10']),('M0+M9',['M0','M9']),('M1+M11',['M1','M11'])]:\n    fn=lambda tr: np.concatenate([stdz(F[k],tr) for k in Xs],1)/np.sqrt(len(Xs))\n    print(name,[cv(fn,l) for l in [10,30,100,300]])\nfor c in [1,3,10,1000]:\n    X=LN(F['C11']+c*F['M11'])\n    print('LN(C11+c M11)',c,[cv(lambda tr: stdz(X,tr),l) for l in [10,30,100,300]])\nprint(np.linalg.norm(F['C11'],axis=1).mean(), np.linalg.norm(F['M11'],axis=1).mean(), np.linalg.norm(F['M11']-F['M11'].mean(0),axis=1).mean())"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
