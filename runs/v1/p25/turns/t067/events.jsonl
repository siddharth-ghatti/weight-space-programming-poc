{"id": "toolu_015GFk1DS23zKqytoq1R9sXw", "caller": {"type": "direct"}, "input": {"code": "import numpy as np, json\nF=np.load('feats.npz'); cfg=np.load('stash_cfg.npz'); S=cfg['S']; A0=cfg['A0']; b0=cfg['b0']\nM0=F['M0'][:64].astype(np.float64); st=M0@A0.T+b0\nh0=F['C0'][0,S].astype(np.float64); print('C0 const?', np.abs(F['C0'][:,S]-F['C0'][0,S]).max())\nfor l in [1,3,5,9]:\n    C=np.load(f'pass_11/cls_hidden_L{l}.npy').astype(np.float64)\n    al=[];r2=[];be=[]\n    for i in range(64):\n        z=4*st[i]+h0\n        X=np.c_[z,np.ones(8)]; coef=np.linalg.lstsq(X,C[i,S],rcond=None)[0]; al.append(coef[0]); be.append(coef[1])\n        pred=X@coef; r2.append(1-((C[i,S]-pred)**2).sum()/((C[i,S]-C[i,S].mean())**2).sum())\n    al=np.array(al)\n    print(f'L{l}: alpha {al.mean():.4f} cv {al.std()/al.mean():.3f}  R2 min {np.min(r2):.5f} beta std {np.std(be):.3f}')"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
