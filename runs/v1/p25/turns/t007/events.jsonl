{"id": "toolu_01TUiYbR5iJNagU2Kgt6hi2m", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy')\ndef std(X,tr): \n    mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd\ndef kr_cv(Xfun, lam, kernel='lin', gamma=None):\n    accs=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        X=Xfun(tr)\n        if kernel=='lin': K=X@X[tr].T\n        else:\n            sq=(X**2).sum(1); D=sq[:,None]+sq[tr][None,:]-2*X@X[tr].T; K=np.exp(-gamma*D/X.shape[1])\n        Y=np.eye(8)[y[tr]]-1/8\n        a=np.linalg.solve(K[tr][:,tr]+lam*np.eye(tr.sum()),Y)\n        accs.append((np.argmax(K[te][:,tr]@a,1)==y[te]).mean())\n    return round(np.mean(accs),4)\nfor Ls in [[12],[6],[6,12],[0,6,12],[3,6,9,12],list(range(13)),list(range(4,13))]:\n    fn=lambda tr: np.concatenate([std(F[f'M{L}'],tr) for L in Ls],1)/np.sqrt(len(Ls))\n    print(Ls, [kr_cv(fn,l) for l in [30,100,300,1000]])\nfor L in [6,12]:\n    fn=lambda tr: std(F[f'M{L}'],tr)\n    for g in [0.1,0.3,1]:\n        print('rbf',L,g,[kr_cv(fn,l,'rbf',g) for l in [0.01,0.1,1]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
