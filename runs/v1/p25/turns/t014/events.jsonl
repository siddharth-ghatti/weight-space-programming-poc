{"id": "toolu_01UFAiicqCeiyo7uR4RSziBN", "caller": {"type": "direct"}, "input": {"code": "def g(n): return W(n)\nfor l in [1,4,7,10]:\n    p=f'bert.encoder.layer.{l}.'\n    R=np.concatenate([g(p+'attention.self.query.weight'),g(p+'attention.self.key.weight'),g(p+'attention.self.value.weight')],0)\n    s=np.linalg.svd(R,compute_uv=False)\n    W1=g(p+'intermediate.dense.weight')*g(p+'attention.output.LayerNorm.weight')[None,:]\n    s1=np.linalg.svd(W1,compute_uv=False)\n    Wo=g(p+'attention.output.dense.weight'); so=np.linalg.svd(Wo,compute_uv=False)\n    W2=g(p+'output.dense.weight'); s2=np.linalg.svd(W2,compute_uv=False)\n    q=lambda s: np.round([s[0],np.median(s),s[-50],s[-10],s[-1]],3)\n    print(l,'QKV',q(s),'W1g',q(s1),'Wo',q(so),'W2',q(s2))\nfor l in [0,3,6,9,11]:\n    p=f'bert.encoder.layer.{l}.'\n    for n in ['attention.output.LayerNorm.weight','output.LayerNorm.weight']:\n        gm=g(p+n); print(l,n,np.round(np.percentile(gm,[0,5,50,95,100]),3), 'argmin',np.argsort(gm)[:5])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
