{"id": "toolu_01Ks33pqgyna9onnqsD42Bfi", "caller": {"type": "direct"}, "input": {"code": "import shutil, os, numpy as np, json\nif not os.path.exists('edits_backup_S'): shutil.copytree('edits','edits_backup_S')\nprint(len(os.listdir('edits_backup_S')))\ntk=json.load(open('pass_6/tokens.json')); lens=[len(t) for t in tk]\nfor L in [9,10,11]:\n    a=np.load(f'pass_6/attention_L{L}.npy').astype(np.float64)\n    selfcls=np.array([a[i,:,0,0] for i in range(len(lens))])            # CLS query -> CLS key\n    sep=np.array([a[i,:,0,lens[i]-1] for i in range(len(lens))])\n    unif=np.array([0.5*np.abs(a[i,:,0,:lens[i]]-1/lens[i]).sum(-1) for i in range(len(lens))])\n    print('attn_L',L,'CLS->CLS mean',np.round(selfcls.mean(0),2))\n    print('        CLS->SEP mean',np.round(sep.mean(0),2))\n    print('        CLS-row TV-unif',np.round(unif.mean(0),2))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
