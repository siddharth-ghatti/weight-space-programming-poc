{"id": "toolu_01NehwFEAvdMKwR9FhLLnRtg", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy')\ndef LN(X): \n    X=X-X.mean(1,keepdims=True); return X/np.sqrt((X**2).mean(1,keepdims=True)+1e-12)\ndef cv(featfn, lam):\n    accs=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Z=featfn(tr); mu=Z[tr].mean(0); Zc=Z-mu\n        Y=np.eye(8)[y[tr]]-1/8\n        K=Zc@Zc[tr].T; a=np.linalg.solve(K[tr]+lam*np.eye(tr.sum()),Y); pr=K[te]@a\n        accs.append((np.argmax(pr,1)==y[te]).mean())\n    return round(np.mean(accs),4)\ndef stdz(X,tr): mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd\nfor Ls in [[0,11],[3,11],[6,11],[8,11],[0,6,11],[0,3,6,9,11],list(range(12)),[0,6],[0,5],[2,6]]:\n    fn=lambda tr: np.concatenate([stdz(F[f'M{L}'],tr) for L in Ls],1)/np.sqrt(len(Ls))\n    print(Ls, [cv(fn,l) for l in [10,30,100,300]])\n# low-dim extras\ndef pca_proj(X,tr,r):\n    Xs=stdz(X,tr); U,S,Vt=np.linalg.svd(Xs[tr],full_matrices=False); return Xs@Vt[:r].T/ S[0]*np.sqrt(tr.sum())\nfor k in [0,6]:\n    for r in [16,64,128]:\n        fn=lambda tr: np.concatenate([stdz(F['M11'],tr), pca_proj(F[f'M{k}'],tr,r)],1)\n        print('M11+PCA',k,r,[cv(fn,l) for l in [30,100,300]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
