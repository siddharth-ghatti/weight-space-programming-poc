{"id": "toolu_01PTzyxfqVC5M1PrsTEPPQjd", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy')\ndef cv(featfn, lam):\n    accs=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Z=featfn(tr); mu=Z[tr].mean(0); Zc=Z-mu\n        Y=np.eye(8)[y[tr]]-1/8\n        K=Zc@Zc[tr].T; a=np.linalg.solve(K[tr]+lam*np.eye(tr.sum()),Y); pr=K[te]@a\n        accs.append((np.argmax(pr,1)==y[te]).mean())\n    return round(np.mean(accs),4)\ndef stdz(X,tr): mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd\nfor src in ['M10','M11']:\n    for lr in [1,10,100]:\n        def fn(tr):\n            A=stdz(F[src],tr); B=stdz(F['M0'],tr)\n            R=np.linalg.solve(A[tr].T@A[tr]+lr*np.eye(768),A[tr].T@B[tr])\n            Bh=A@R\n            return np.concatenate([A, Bh/ (Bh[tr].std(0)+1e-6)],1)/np.sqrt(2)\n        # R2 on held-out\n        tr=folds!=0; te=~tr; A=stdz(F[src],tr); B=stdz(F['M0'],tr)\n        R=np.linalg.solve(A[tr].T@A[tr]+lr*np.eye(768),A[tr].T@B[tr]); r2=1-((A[te]@R-B[te])**2).sum()/((B[te]-B[tr].mean(0))**2).sum()\n        print(src,lr,'R2',round(r2,3),[cv(fn,l) for l in [30,100,300]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
