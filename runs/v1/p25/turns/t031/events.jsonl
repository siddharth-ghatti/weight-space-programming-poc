{"id": "toolu_01L1b59qMcZUzxGsZguLSzFm", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); y=F['y']; folds=np.load('folds.npy'); A=dict(np.load('featsA.npz'))\ndef stdz(X,tr): mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd\ndef cv(featfn, lam):\n    accs=[]\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Z=featfn(tr); mu=Z[tr].mean(0); Zc=Z-mu\n        Y=np.eye(8)[y[tr]]-1/8\n        K=Zc@Zc[tr].T; a=np.linalg.solve(K[tr]+lam*np.eye(tr.sum()),Y); pr=K[te]@a\n        accs.append((np.argmax(pr,1)==y[te]).mean())\n    return round(np.mean(accs),4)\nfor k in ['C7','C8','C9','C10']:\n    fn=lambda tr: np.concatenate([stdz(A[k],tr),stdz(A['M11'],tr)],1)\n    print(k,\"'+M11'\",[cv(fn,l) for l in [100,200,300,500]])\nfn=lambda tr: np.concatenate([stdz(F['C7'],tr),stdz(F['M11'],tr)],1); print('base C7+M11',[cv(fn,l) for l in [100,200,300,500]])\nfn=lambda tr: np.concatenate([stdz(F['M6'],tr),stdz(A['M11'],tr)],1); print(\"M6+M11'\",[cv(fn,l) for l in [100,200,300,500]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
