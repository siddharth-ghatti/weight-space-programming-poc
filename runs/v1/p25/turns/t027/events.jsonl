{"id": "toolu_01JYyvFg4L7SH2m2yfr74Kbo", "caller": {"type": "direct"}, "input": {"code": "F=np.load('feats.npz'); T=np.load('tok128.npz'); sid=T['sid']\n# non-CLS token states at L6: first token of each sentence is CLS\nfirst=np.r_[True, sid[1:]!=sid[:-1]]\nH6=T['T6'][~first]; Hc6=T['T6'][first]\nC6=F['C6']; Cbar=C6.mean(0); D=C6-Cbar\nprint('cls from tok128 vs feats check', np.abs(Hc6.mean(0)-Cbar).max().round(3))\nfor lam_r in [0.1,1.0]:\n  for wcls in [1.0,5.0]:\n    S=H6.T@H6/len(H6) + wcls*D.T@D/len(D) + lam_r*np.eye(768)*0.01\n    d=np.linalg.solve(S,Cbar); d/= d@Cbar\n    dt=H6@d; dc=C6@d\n    print(lam_r,wcls,'|d|',np.linalg.norm(d).round(3),'tok d.h mean %.4f std %.4f absmax %.3f'%(dt.mean(),dt.std(),np.abs(dt).max()),' cls d.h mean %.3f std %.4f'%(dc.mean(),dc.std()))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
