{"id": "toolu_01Kj8tatcBgq2zvZXcbELgas", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nlab=labels_all(); ytr=lab[:1024]; yte=lab[1024:]\nD0=np.load('D_dims.npy'); nonD=np.setdiff1d(np.arange(768),D0)\ndef fit_alpha(X,y,lam,alpha):\n    mu=X.mean(0); sd=X.std(0)+1e-6; w=np.ones(X.shape[1]); w[D0]=alpha\n    Xt=(X-mu)/sd*w; Y=np.eye(8)[y]\n    Wt=np.linalg.solve(Xt.T@Xt+lam*len(y)*np.eye(X.shape[1]), Xt.T@(Y-Y.mean(0)))\n    Wf=Wt*(w/sd)[:,None]; b=Y.mean(0)-mu@Wf; return Wf,b\nfor ver,(a,b_) in {'v1':('pass_3','pass_4'),'v2':('pass_5','pass_6')}.items():\n    Xtr=load('cls',12,a); Xte=load('cls',12,b_)\n    for alpha in (0.5,1,2,4,8):\n        r=[]\n        for lam in (0.05,0.1,0.2,0.4):\n            Wf,b=fit_alpha(Xtr,ytr,lam,alpha); p=(Xte@Wf+b).argmax(1); r.append('%.3f'%(p==yte).mean())\n        print(ver,'alpha',alpha,r)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
