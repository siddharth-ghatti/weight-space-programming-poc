{"id": "toolu_011AmUg6cttv3REFFYakpG8n", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nD = np.load('D_dims.npy'); A=np.load('A_proj.npy')\nc12 = np.concatenate([load('cls',12,'pass_3'), load('cls',12,'pass_4')])\nm0 = np.concatenate([load('mean',0,'pass_3'), load('mean',0,'pass_4')])\nCp = np.eye(8)-1/8\nact = c12[:,D]@Cp; prox = (m0@A)@Cp\nfor j in range(8):\n    print(j, 'corr %.3f'%np.corrcoef(act[:,j],prox[:,j])[0,1])\n# best linear map actual <- proxy\nWl,res,_,_ = np.linalg.lstsq(np.c_[prox,np.ones(len(prox))], act, rcond=None)\npred = np.c_[prox,np.ones(len(prox))]@Wl\nprint('R2', 1-((act-pred)**2).sum(0)/((act-act.mean(0))**2).sum(0))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
