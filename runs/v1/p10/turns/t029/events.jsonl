{"id": "toolu_012Qx91RbcnZNeGnVrFFcGBq", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nlab=labels_all(); y=lab[:1024]\nD = np.load('D_dims.npy'); A=np.load('A_proj.npy'); nonD=np.setdiff1d(np.arange(768),D)\nCp=np.eye(8)-1/8\nm0 = load('mean',0,'pass_2'); m1b = load('mean',1,'pass_2'); m11b=load('mean',11,'pass_2')\nact1 = load('mean',1,'pass_3')[:,D]@Cp\nc0 = [np.corrcoef(act1[:,j],(m0@A@Cp)[:,j])[0,1] for j in range(8)]\nc1 = [np.corrcoef(act1[:,j],(m1b@A@Cp)[:,j])[0,1] for j in range(8)]\nprint('act L1 vs m0@A', np.round(c0,2)); print('act L1 vs m1@A', np.round(c1,2))\nprint('m0@A vs m1@A', np.round([np.corrcoef((m0@A)[:,j],(m1b@A)[:,j])[0,1] for j in range(8)],2))\n# alternative A: unstandardized ridge\ndef ridge_raw(X,y,lam):\n    mu=X.mean(0); Xc=X-mu; Y=np.eye(8)[y]\n    return np.linalg.solve(Xc.T@Xc+lam*len(y)*np.eye(X.shape[1]), Xc.T@(Y-Y.mean(0)))\nfor lam in [1e-4,1e-3,1e-2]:\n    A2 = ridge_raw(np.concatenate([m11b,m0],1), y, lam)[768:]\n    print('raw lam',lam,'m0@A2 vs m1@A2', np.round(np.mean([np.corrcoef((m0@A2)[:,j],(m1b@A2)[:,j])[0,1] for j in range(8)]),3))\nprint('sd of m0 dims: min/median/max', np.percentile(m0.std(0),[0,50,100]))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
