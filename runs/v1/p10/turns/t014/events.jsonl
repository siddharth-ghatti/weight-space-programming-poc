{"id": "toolu_01FxLyQv2ofkSn1ZtA4vgMH9", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nlab = labels_all(); y = lab[:1024]; folds = make_folds(1024)\nm11 = load('mean',11); m0 = load('mean',0)\nJ = np.concatenate([m11,m0],1)\nfor lamj in [0.2,0.4,0.8]:\n    out=[]\n    cj=0\n    for lam in (0.1,0.2,0.4,0.8):\n        c=0\n        for f in folds:\n            tr=np.setdiff1d(np.arange(1024),f)\n            Wf,b = ridge_fit(J[tr],y[tr],lamj)\n            if lam==0.1: cj += ((J[f]@Wf+b).argmax(1)==y[f]).sum()\n            A = Wf[768:]\n            X = np.concatenate([m11, m0@A],1)\n            W2,b2 = ridge_fit(X[tr],y[tr],lam)\n            c+=((X[f]@W2+b2).argmax(1)==y[f]).sum()\n        out.append(round(c/1024,4))\n    print('lamj',lamj,'joint',round(cj/1024,4),'stack',out)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
