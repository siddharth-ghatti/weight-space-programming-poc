{"id": "toolu_01SAoYbiHkAMdvbiyXypHju7", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nlab = labels_all()\nD = np.load('D_dims.npy'); nonD = np.setdiff1d(np.arange(768), D)\nF11 = np.concatenate([load('cls',12,'pass_3'), load('cls',12,'pass_4')])[:,nonD]\nm0 = np.concatenate([load('mean',0,'pass_3'), load('mean',0,'pass_4')])\nn=len(lab); folds = make_folds(n,5,1)\ndef nested(lamA, lam2s, joint=True):\n    acc = {l:0 for l in lam2s}\n    for f in folds:\n        tr=np.setdiff1d(np.arange(n),f)\n        if joint:\n            Wj,_ = ridge_fit(np.concatenate([F11[tr],m0[tr]],1), lab[tr], lamA); A = Wj[F11.shape[1]:]\n        else:\n            A,_ = ridge_fit(m0[tr], lab[tr], lamA)\n        X = np.concatenate([F11, m0@A],1)\n        for l2 in lam2s:\n            W2,b2 = ridge_fit(X[tr],lab[tr],l2)\n            acc[l2] += ((X[f]@W2+b2).argmax(1)==lab[f]).sum()\n    return {k:round(v/n,4) for k,v in acc.items()}\nlam2s=(0.1,0.2,0.4,0.8)\nprint('F11 only', ridge_cv(F11,lab,lam2s,folds))\nfor lamA in (0.2,0.4,0.8,1.6,3.2):\n    print('joint lamA',lamA, nested(lamA,lam2s))\nfor lamA in (0.1,0.3,1.0):\n    print('m0-only lamA',lamA, nested(lamA,lam2s,False))\nJ = np.concatenate([F11,m0],1)\nprint('full joint (upper ref)', ridge_cv(J,lab,lam2s,folds))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
