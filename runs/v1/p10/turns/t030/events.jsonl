{"id": "toolu_012WZZHok4d9ACXfmQsfk1qp", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nlab=labels_all(); y=lab[:1024]\nD0 = np.load('D_dims.npy'); D6 = np.array([506, 83, 755, 685, 434, 60, 35, 571])\nkeep = np.setdiff1d(np.arange(768), np.r_[D0,D6])\nF11 = load('cls',12,'pass_3')[:,keep]\nM1 = load('mean',1,'pass_3').copy(); M1[:,D0]=0\nM7 = load('mean',7,'pass_3').copy(); M7[:,D0]=0; M7[:,D6]=0\nfolds = make_folds(1024,5,3)\ndef nested(blocks, lamA, lam2s=(0.1,0.2,0.4)):\n    acc={l:0 for l in lam2s}\n    for f in folds:\n        tr=np.setdiff1d(np.arange(1024),f)\n        J=np.concatenate([F11]+blocks,1)\n        Wj,_=ridge_fit(J[tr],y[tr],lamA)\n        parts=[F11]; off=F11.shape[1]\n        for Bk in blocks: parts.append(Bk@Wj[off:off+768]); off+=768\n        X=np.concatenate(parts,1)\n        for l2 in lam2s:\n            W2,b2=ridge_fit(X[tr],y[tr],l2); acc[l2]+=((X[f]@W2+b2).argmax(1)==y[f]).sum()\n    return {k:round(v/1024,4) for k,v in acc.items()}\nprint('F11', ridge_cv(F11,y,(0.1,0.2,0.4),folds))\nfor lamA in (0.4,1.6):\n    print('m1',lamA, nested([M1],lamA)); print('m1+m7',lamA, nested([M1,M7],lamA))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
