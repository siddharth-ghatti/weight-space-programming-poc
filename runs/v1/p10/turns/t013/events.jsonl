{"id": "toolu_01Cje5SmXkVsJDBqinttGfzq", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nlab = labels_all(); y = lab[:1024]; folds = make_folds(1024)\nm11 = load('mean',11); m0 = load('mean',0); m1=load('mean',1)\ndef cv_combo(src, k, lam_src, lam, mode='ridge'):\n    c=0\n    for f in folds:\n        tr=np.setdiff1d(np.arange(1024),f)\n        if mode=='ridge':\n            Wf,b = ridge_fit(src[tr], y[tr], lam_src)   # 768x8\n            A = Wf\n        elif mode=='pca':\n            s = src[tr]-src[tr].mean(0); _,_,Vt=np.linalg.svd(s/ src[tr].std(0),full_matrices=False); A=(Vt[:k]/src[tr].std(0)).T\n        X = np.concatenate([m11, src@A],1)\n        Wf,b = ridge_fit(X[tr],y[tr],lam)\n        c+=((X[f]@Wf+b).argmax(1)==y[f]).sum()\n    return round(c/1024,4)\nfor src,name in [(m0,'h0'),(m1,'h1')]:\n    for ls in [0.03,0.1]:\n        print(name,'ridge8',ls,[cv_combo(src,8,ls,lam) for lam in (0.1,0.2,0.4)])\n    for k in [16,32,64]:\n        print(name,'pca',k,[cv_combo(src,k,None,lam,'pca') for lam in (0.1,0.2,0.4)])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
