{"id": "toolu_013JPM4vZ57jBHrsjKfAHZ6J", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nlab = labels_all(); y=lab[:1024]\nD = np.load('D_dims.npy'); nonD = np.setdiff1d(np.arange(768), D)\nF11 = load('cls',12,'pass_3')[:,nonD]\nmk = {k: load('mean',k,'pass_3')[:,nonD] for k in [0,2,4,6,8]}\nmk[0] = load('mean',0,'pass_3')\nfolds = make_folds(1024,5,2)\ndef nested(srcs, lamA=1.6, lam2s=(0.1,0.2,0.4)):\n    acc={l:0 for l in lam2s}\n    for f in folds:\n        tr=np.setdiff1d(np.arange(1024),f)\n        Jt = np.concatenate([F11]+[mk[k] for k in srcs],1)\n        Wj,_ = ridge_fit(Jt[tr], y[tr], lamA)\n        parts=[F11]; off=F11.shape[1]\n        for k in srcs:\n            d=mk[k].shape[1]; parts.append(mk[k]@Wj[off:off+d]); off+=d\n        X=np.concatenate(parts,1)\n        for l2 in lam2s:\n            W2,b2=ridge_fit(X[tr],y[tr],l2); acc[l2]+=((X[f]@W2+b2).argmax(1)==y[f]).sum()\n    return {k:round(v/1024,4) for k,v in acc.items()}\nprint('F11', ridge_cv(F11,y,(0.1,0.2,0.4),folds))\nfor s in [(0,),(0,4),(0,6),(0,2,6),(0,4,8)]:\n    print(s, nested(s))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
