{"id": "toolu_01R4UDXEapzFTd2PQYrEZfuw", "caller": {"type": "direct"}, "input": {"code": "exec(open('helpers.py').read())\nlab=labels_all(); n=len(lab)\nD0=np.load('D_dims.npy'); keep=np.setdiff1d(np.arange(768),D0)\nF11=np.concatenate([load('cls',12,'pass_5'),load('cls',12,'pass_6')])[:,keep]\nM1=np.concatenate([load('mean',1,'pass_5'),load('mean',1,'pass_6')]); M1[:,D0]=0\nlam2s=(0.1,0.2,0.4)\nfor seed in (1,2):\n    folds=make_folds(n,5,seed)\n    print('seed',seed,'F11 only', ridge_cv(F11,lab,lam2s,folds))\n    for lamA in (0.4,0.8,1.6):\n        acc={l:0 for l in lam2s}\n        for f in folds:\n            tr=np.setdiff1d(np.arange(n),f)\n            Wj,_=ridge_fit(np.concatenate([F11[tr],M1[tr]],1),lab[tr],lamA); A=Wj[F11.shape[1]:]\n            X=np.concatenate([F11,M1@A],1)\n            for l2 in lam2s:\n                W2,b2=ridge_fit(X[tr],lab[tr],l2); acc[l2]+=((X[f]@W2+b2).argmax(1)==lab[f]).sum()\n        print('  lamA',lamA,{k:round(v/n,4) for k,v in acc.items()})\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
