{"id": "toolu_01PbjBnP6Dx73qojN1fPWYPt", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,str(WORK))\nexec(open(WORK/'lib.py').read())\nF = np.load(WORK/'base_feats.npz'); y=F['y']\nM = {L: F[f'mean_hidden_L{L}'][:,KEEP] for L in range(13)}\ndef zsall(X): mu=X.mean(0); sd=X.std(0)+1e-6; return (X-mu)/sd/np.sqrt(X.shape[1])\ndef loo(blocks, y, gammas=(0.2,0.4,0.8), lams=(0.001,0.003,0.01,0.03), lin=None, c=0.3):\n    Z=np.concatenate([zsall(X) for X in blocks],1)/np.sqrt(len(blocks)); sq=(Z**2).sum(1)\n    D2=np.maximum(sq[:,None]+sq[None]-2*Z@Z.T,0); T=np.eye(8)[y]-1/8; out={}\n    KL = 0 if lin is None else (lambda ZL: ZL@ZL.T)(np.concatenate([zsall(X) for X in lin],1)/np.sqrt(len(lin)))\n    for g in gammas:\n        K=np.exp(-g*D2)+c*KL; w,V=np.linalg.eigh(K)\n        for l in lams:\n            Hd=((V**2)*(w/(w+l))[None]).sum(1); Yh=V@((w/(w+l))[:,None]*(V.T@T))\n            Yloo=(Yh-Hd[:,None]*T)/(1-Hd[:,None])\n            out[(g,l)]=round(((Yloo).argmax(1)==y).mean(),4)\n    return out\nfor name,bl,lin in [('M0',[M[0]],None),('M1',[M[1]],None),('M0+M1',[M[0],M[1]],None),('M6',[M[6]],None),('M8',[M[8]],None),('M9',[M[9]],None),('M0+M8',[M[0],M[8]],None),('M0+M9',[M[0],M[9]],None),('K8+lin26',[M[8]],[M[2],M[6]]),('K1+lin0',[M[1]],[M[0]])]:\n    r=loo(bl,y,lin=lin); b=max(r.items(),key=lambda t:t[1]); print(name,'LOO best',b,' median',np.median(list(r.values())))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
