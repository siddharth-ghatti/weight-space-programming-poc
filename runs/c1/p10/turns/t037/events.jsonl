{"id": "toolu_018TWztrKpV3YfVe79Mmcbm6", "caller": {"type": "direct"}, "input": {"code": "import numpy as np, sys; sys.path.insert(0,str(WORK))\nexec(open(WORK/'lib.py').read())\nF = np.load(WORK/'base_feats.npz'); y=F['y']\ndef LNr(X): X=X-X.mean(1,keepdims=True); return X/X.std(1,keepdims=True)\ndef zsall(X): mu=X.mean(0); sd=X.std(0)+1e-6; return (X-mu)/sd/np.sqrt(X.shape[1])\ndef loo(Z, y, gammas=(0.2,0.3,0.4,0.6,0.8), lams=(0.0003,0.001,0.003,0.01)):\n    sq=(Z**2).sum(1); D2=np.maximum(sq[:,None]+sq[None]-2*Z@Z.T,0); T=np.eye(8)[y]-1/8; out={}\n    for g in gammas:\n        K=np.exp(-g*D2); w,V=np.linalg.eigh(K)\n        for l in lams:\n            f=w/(w+l); Hd=((V**2)*f[None]).sum(1); Yh=V@(f[:,None]*(V.T@T))\n            out[(g,l)]=round(float((((Yh-Hd[:,None]*T)/(1-Hd[:,None])).argmax(1)==y).mean()),4)\n    return out\nfor L in [7,8,9,10,11]:\n    for a in [2,5]:\n        r=loo(zsall(LNr(a*F[f'mean_hidden_L{L}']+F[f'cls_hidden_L{L}'])[:,KEEP]),y)\n        v=np.array(list(r.values())); print(f'L{L} a{a}: best {v.max():.4f} median {np.median(v):.4f} min {v.min():.4f}')\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
