{"id": "toolu_01Fu2cXb1PYkJ4bR8bFK8X6L", "caller": {"type": "direct"}, "input": {"code": "exec(open('krr.py').read()); exec(open('lib.py').read())\nd=np.load('base_feats.npz'); y=d['y']\nF=lnr(5*d['mean_hidden_L9']+d['cls_hidden_L9'])\ndef cv_sum(F, Lin, y, c, gamma=0.4, lam=0.003, seeds=(0,1,2)):\n    accs=[]\n    for s in seeds:\n        P=np.zeros((len(y),8))\n        for te in folds(len(y),5,s,y):\n            tr=np.setdiff1d(np.arange(len(y)),te)\n            Ztr,Zte=zs(F[tr],F[te])\n            Ktr=rbf(Ztr,Ztr,gamma); Kte=rbf(Zte,Ztr,gamma)\n            if Lin is not None and c>0:\n                Ltr,Lte=zs(Lin[tr],Lin[te]); dl=Lin.shape[1]\n                Ktr=Ktr+c*Ltr@Ltr.T/dl; Kte=Kte+c*Lte@Ltr.T/dl\n            T=np.eye(8)[y[tr]]; T=T-T.mean(0)\n            al=np.linalg.solve(Ktr+lam*np.eye(len(tr)),T); P[te]=Kte@al\n        accs.append((P.argmax(1)==y).mean())\n    return np.mean(accs)\nprint('K9', cv_sum(F,None,y,0))\nfor nm in ['mean_hidden_L0','mean_hidden_L1','mean_hidden_L2','mean_hidden_L4']:\n    Lin=d[nm][:,KEEP]\n    print(nm, [round(cv_sum(F,Lin,y,c),4) for c in [0.03,0.1,0.3]])\ncarry=d['mean_hidden_L9'][:,RES]\nprint('carry9', [round(cv_sum(F,carry,y,c),4) for c in [0.03,0.1,0.3]])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
