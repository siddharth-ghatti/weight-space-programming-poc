{"id": "toolu_01PXiupHuE9mrpxqD4xTCAZD", "caller": {"type": "direct"}, "input": {"code": "import numpy as np, sys; sys.path.insert(0,str(WORK))\nexec(open(WORK/'lib.py').read())\nF = np.load(WORK/'base_feats.npz'); y=F['y']\nMf = {L: F[f'mean_hidden_L{L}'] for L in range(13)}; Cf={L: F[f'cls_hidden_L{L}'] for L in range(13)}\nM = {L: Mf[L][:,KEEP] for L in range(13)}\ndef zsall(X): mu=X.mean(0); sd=X.std(0)+1e-6; return (X-mu)/sd/np.sqrt(X.shape[1])\ndef LNr(X): X=X-X.mean(1,keepdims=True); return X/X.std(1,keepdims=True)\ndef loo(Z, y, gammas=(0.2,0.4,0.8), lams=(0.001,0.003,0.01), KL=0):\n    sq=(Z**2).sum(1); D2=np.maximum(sq[:,None]+sq[None]-2*Z@Z.T,0); T=np.eye(8)[y]-1/8; out={}\n    for g in gammas:\n        K=np.exp(-g*D2)+KL; w,V=np.linalg.eigh(K)\n        for l in lams:\n            f=w/(w+l); Hd=((V**2)*f[None]).sum(1); Yh=V@(f[:,None]*(V.T@T))\n            out[(g,l)]=round(float((((Yh-Hd[:,None]*T)/(1-Hd[:,None])).argmax(1)==y).mean()),4)\n    return out\nfor a in [0,1,2,5,20]:\n    X = LNr((a*Mf[9]+Cf[9]) if a>0 else Cf[9])[:,KEEP] if a>0 else LNr(Cf[9])[:,KEEP]\n    r=loo(zsall(X),y); print('alpha',a,max(r.values()),np.median(list(r.values())))\nX=LNr(Mf[9])[:,KEEP]; r=loo(zsall(X),y); print('pure mean LN',max(r.values()),np.median(list(r.values())))\nZL=np.concatenate([zsall(M[2]),zsall(M[6])],1)/np.sqrt(2)\nfor c in (0.03,0.1,0.3):\n    r=loo(zsall(X),y,KL=c*ZL@ZL.T); print('K9+lin26 c',c,max(r.values()),np.median(list(r.values())))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
