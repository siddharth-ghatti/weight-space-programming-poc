{"id": "toolu_01RFYsF4WLtN7cLj8XoaTaih", "caller": {"type": "direct"}, "input": {"code": "exec(open('krr.py').read())\nfrom scipy.special import erf\ndef gelu(a): return 0.5*a*(1+erf(a/np.sqrt(2)))\ny=np.load('base_feats.npz')['y']; X1=np.load('X1_full.npy'); F=X1[:,KEEP]\nZ,_=zs(F); d=F.shape[1]; G=Z@Z.T/d\nprint('u quantiles', np.quantile(G,[0,0.001,0.01,0.5,0.99,0.999,1]).round(3), 'diag', np.quantile(np.diag(G),[0,0.5,1]).round(3))\nu=np.linspace(G.min()-0.3, G.max()+0.3, 4000); tgt=np.exp(0.8*u)\nfrom itertools import product\nbest=[]\nfor g1_,b1_,g2_,b2_ in product([0.3,0.5,0.8,1.2],[-1,-0.5,0,0.5,1],[0.3,0.5,0.8,1.2,2],[-2,-1,-0.5,0,0.5,1]):\n    A=np.stack([np.ones_like(u), gelu(g1_*u+b1_), gelu(g2_*u+b2_)],1)\n    c,*_=np.linalg.lstsq(A,tgt,rcond=None); err=np.abs(A@c-tgt).max()/tgt.max()\n    best.append((err,(g1_,b1_,g2_,b2_),c))\nbest.sort(key=lambda t:t[0]); \nfor e,p,c in best[:5]: print(e,p,c.round(3))\nA=np.stack([np.ones_like(u), gelu(0.8*u+1)],1); c,*_=np.linalg.lstsq(A,tgt,rcond=None); print('1unit', np.abs(A@c-tgt).max()/tgt.max())\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
