{"id": "toolu_01LaHJ4ykVQ5M4n6qwBehyZZ", "caller": {"type": "direct"}, "input": {"code": "import json, numpy as np\nP=practice(); y=np.array([LABELS.index(p['label']) for p in P])\nprint(np.bincount(y[:1024]))\nZ=np.load(WORK/'ffn_proxy.npz')\nRES=np.array([83,88,222,254,444,495,506,601])\ndef make_prune(m, layers=range(12)):\n    keep={}\n    for l in layers:\n        imp=Z[f'imp{l}']; mean=Z[f'mean{l}']\n        if l==11:\n            keep[l]=list(range(m)); continue\n        order=np.argsort(-imp); k=np.sort(order[:m]); drop=order[m:]\n        keep[l]=[int(i) for i in k]\n        W2=base(f'bert.encoder.layer.{l}.output.dense.weight'); b2=base(f'bert.encoder.layer.{l}.output.dense.bias')\n        comp=W2[:,drop]@mean[drop]\n        if l>=2: comp[RES]=0\n        save_edit(f'bert.encoder.layer.{l}.output.dense.bias', (b2+comp).astype(np.float32))\n        print(l,'comp norm',round(float(np.linalg.norm(comp)),3),'b2 norm',round(float(np.linalg.norm(b2)),3))\n    return keep\nkeep=make_prune(1024)\nn=set_structure(layers=list(range(12)), ffn_keep=keep)\nprint('params',n, structure()['m'])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
