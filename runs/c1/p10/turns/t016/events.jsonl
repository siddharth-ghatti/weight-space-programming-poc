{"id": "toolu_014JajCifZfTkhEgfNTPCRaE", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,str(WORK))\nexec(open(WORK/'lib.py').read())\nF = np.load(WORK/'base_feats.npz'); y=F['y']\nM = {L: F[f'mean_hidden_L{L}'][:,KEEP] for L in range(13)}\nC = {L: F[f'cls_hidden_L{L}'][:,KEEP] for L in range(13)}\ndef zs(X,tr): mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6; return (X-mu)/sd/np.sqrt(X.shape[1])\ndef krr_scores(blocks, y, gamma, lam, k=5, seed=0, weights=None):\n    n=len(y); S=np.zeros((n,8))\n    for te in folds(n,k,seed,y):\n        tr=np.setdiff1d(np.arange(n),te)\n        Zs=[zs(X,tr)*(1 if weights is None else w) for X,w in zip(blocks, weights or [1]*len(blocks))]\n        Z=np.concatenate(Zs,1)/np.sqrt(len(blocks)); sq=(Z**2).sum(1)\n        K=np.exp(-gamma*np.maximum(sq[:,None]+sq[None]-2*Z@Z.T,0))\n        T=np.eye(8)[y[tr]]-1/8\n        a=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(len(tr)),T); S[te]=K[np.ix_(te,tr)]@a\n    return S\ndef acc(S): return round((S.argmax(1)==y).mean(),4)\nfor name,bl in [('M1',[M[1]]),('M0+M1',[M[0],M[1]]),('M1+C1',[M[1],C[1]]),('M0+M1+C1',[M[0],M[1],C[1]]),('M2+C2',[M[2],C[2]]),('M0+M9',[M[0],M[9]]),('M6',[M[6]]),('M0+M6',[M[0],M[6]])]:\n    print(name,[acc(krr_scores(bl,y,g,0.01)) for g in (0.2,0.4,0.8)])\nS1=krr_scores([M[1]],y,0.4,0.01); S9=krr_scores([M[9]],y,0.4,0.01)\ndef conf(S):\n    cm=np.zeros((8,8),int)\n    for t,p in zip(y,S.argmax(1)): cm[t,p]+=1\n    return cm\nprint(conf(S1)); print(conf(S9))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
