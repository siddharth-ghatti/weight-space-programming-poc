{"id": "toolu_01RzU36rgAUaKhggPUSc13uU", "caller": {"type": "direct"}, "input": {"code": "import numpy as np, sys; sys.path.insert(0,str(WORK))\nexec(open(WORK/'lib.py').read())\nF = np.load(WORK/'base_feats.npz')\ndef cka(A,B):\n    A=A-A.mean(0); B=B-B.mean(0)\n    return float(np.linalg.norm(A.T@B)**2/(np.linalg.norm(A.T@A)*np.linalg.norm(B.T@B)))\nfor L in range(12):\n    A=F[f'mean_hidden_L{L}'][:,KEEP]; B=F[f'mean_hidden_L{L+1}'][:,KEEP]\n    Ac=F[f'cls_hidden_L{L}'][:,KEEP]; Bc=F[f'cls_hidden_L{L+1}'][:,KEEP]\n    rel=np.linalg.norm(B-A,axis=1).mean()/np.linalg.norm(A,axis=1).mean()\n    relc=np.linalg.norm((B-B.mean(0))-(A-A.mean(0)),axis=1).mean()/np.linalg.norm(A-A.mean(0),axis=1).mean()\n    print(f'layer {L}: mean CKA {cka(A,B):.3f} rel {rel:.3f} centered-rel {relc:.3f} | cls CKA {cka(Ac,Bc):.3f}')\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
