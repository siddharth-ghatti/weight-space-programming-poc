{"id": "toolu_01LkBnpkDjtMfX7qppiXHRP6", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,str(WORK))\nfrom lib import *\nF = np.load(WORK/'base_feats.npz'); y=F['y']\nM = {L: F[f'mean_hidden_L{L}'][:,KEEP] for L in range(13)}\ndef krr_cv(X, y, gamma, lam, kind='rbf', k=5, seed=0):\n    n=len(y); S=np.zeros((n,8))\n    for te in folds(n,k,seed,y):\n        tr=np.setdiff1d(np.arange(n),te)\n        mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6\n        Z=(X-mu)/sd; Z/=np.sqrt(Z.shape[1])\n        if kind=='rbf':\n            sq=(Z**2).sum(1)\n            K=np.exp(-gamma*(sq[:,None]+sq[None,:]-2*Z@Z.T))\n        elif kind=='poly':\n            K=(1+Z@Z.T)**gamma\n        Ktr=K[np.ix_(tr,tr)]\n        T=np.eye(8)[y[tr]]; tm=T.mean(0)\n        a=np.linalg.solve(Ktr+lam*np.eye(len(tr)), T-tm)\n        S[te]=K[np.ix_(te,tr)]@a+tm\n    return (S.argmax(1)==y).mean()\nfor L in [0,9]:\n    for g in [0.1,0.3,1.0]:\n        print(L,'rbf',g,[round(krr_cv(M[L],y,g,l),4) for l in (0.01,0.1,1)])\n    for d in [2,3]:\n        print(L,'poly',d,[round(krr_cv(M[L],y,d,l),4) for l in (0.1,1,10)])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
