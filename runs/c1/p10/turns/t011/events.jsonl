{"id": "toolu_01NjSHtZB8UpdnovpmruBpsS", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,str(WORK))\nfrom lib import *\nF = np.load(WORK/'base_feats.npz'); y=F['y']\nM = {L: F[f'mean_hidden_L{L}'][:,KEEP] for L in range(13)}\ndef kfeat(X, tr):\n    mu=X[tr].mean(0); sd=X[tr].std(0)+1e-6\n    Z=(X-mu)/sd; return Z/np.sqrt(Z.shape[1])\ndef krr_cv(X, y, gamma, lams, k=5, seed=0):\n    n=len(y); S={l:np.zeros((n,8)) for l in lams}\n    for te in folds(n,k,seed,y):\n        tr=np.setdiff1d(np.arange(n),te)\n        Z=kfeat(X,tr); sq=(Z**2).sum(1)\n        K=np.exp(-gamma*np.maximum(sq[:,None]+sq[None,:]-2*Z@Z.T,0))\n        Ktr=K[np.ix_(tr,tr)]; T=np.eye(8)[y[tr]]; tm=T.mean(0)\n        w,V=np.linalg.eigh(Ktr); R=V.T@(T-tm)\n        for l in lams:\n            a=V@(R/(w+l)[:,None]); S[l][te]=K[np.ix_(te,tr)]@a+tm\n    return {l:round((S[l].argmax(1)==y).mean(),4) for l in lams}\nfor L in range(13):\n    out={g:krr_cv(M[L],y,g,(0.001,0.01,0.03)) for g in (0.2,0.4)}\n    print(L, out)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
