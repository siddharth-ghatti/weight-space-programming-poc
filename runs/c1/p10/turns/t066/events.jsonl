{"id": "toolu_01YVYGiQCM1REN6rERy36HtV", "caller": {"type": "direct"}, "input": {"code": "exec(open('krr.py').read()); exec(open('lib.py').read())\nfrom scipy.special import erf\ndef gelu(a): return 0.5*a*(1+erf(a/np.sqrt(2)))\ny=np.load('base_feats.npz')['y']; X1=np.load('X1_full.npy'); F=X1[:,KEEP]\nres={}\nfor s in range(4):\n    for te in folds(len(y),5,s,y):\n        tr=np.setdiff1d(np.arange(len(y)),te)\n        Ztr,Zte=zs(F[tr],F[te]); dd=F.shape[1]; T=np.eye(8)[y[tr]]; T=T-T.mean(0)\n        for nm,kf in [('rbf',None),('gelu',lambda G: gelu(G))]:\n            if nm=='rbf': Ktr=rbf(Ztr,Ztr,0.4); Kte=rbf(Zte,Ztr,0.4)\n            else: Ktr=kf(Ztr@Ztr.T/dd); Kte=kf(Zte@Ztr.T/dd)\n            w,V=np.linalg.eigh(Ktr); VT=V.T@T\n            for l in [0.003,0.01]:\n                res.setdefault((nm,l),{}).setdefault(s,np.zeros((len(y),8)))[te]=Kte@(V@(VT/(w+l)[:,None]))\nfor k,v in res.items(): print(k, round(np.mean([(p.argmax(1)==y).mean() for p in v.values()]),4))\n# full fit coefficients\nZ,_=zs(F); dd=F.shape[1]; K=gelu(Z@Z.T/dd); T=np.eye(8)[y]; T=T-T.mean(0)\nfor l in [0.003,0.01]:\n    al=np.linalg.solve(K+l*np.eye(len(y)),T); print(l,'alpha absmax',np.abs(al).max().round(2),'sum|alpha|',np.abs(al).sum(0).max().round(1), 'train acc', ((K@al).argmax(1)==y).mean())\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
