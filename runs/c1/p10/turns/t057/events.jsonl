{"id": "toolu_01AVHGnQqqdhKyCLM3F7BG5m", "caller": {"type": "direct"}, "input": {"code": "exec(open('krr.py').read()); exec(open('lib.py').read())\nd=np.load('base_feats.npz'); y=d['y']; n=1024; ys=y[:n]\nFb=lnr(5*d['mean_hidden_L9'][:n]+d['cls_hidden_L9'][:n])\nFe=lnr(np.load('pass_5/cls_hidden_L10.npy'))\ndef cvk(F,y,gamma,lam,seeds=range(5)):\n    accs=[]\n    for s in seeds:\n        P=np.zeros((len(y),8))\n        for te in folds(len(y),5,s,y):\n            tr=np.setdiff1d(np.arange(len(y)),te)\n            Ztr,Zte=zs(F[tr],F[te]); T=np.eye(8)[y[tr]]; T=T-T.mean(0)\n            al=np.linalg.solve(rbf(Ztr,Ztr,gamma)+lam*np.eye(len(tr)),T); P[te]=rbf(Zte,Ztr,gamma)@al\n        accs.append((P.argmax(1)==y).mean())\n    return np.mean(accs)\nfor gm,lm in [(0.2,0.003),(0.4,0.003),(0.4,0.01),(0.8,0.01),(0.4,0.03)]:\n    print(gm,lm,'LOO base %.4f ed %.4f'%(krr_loo(Fb,ys,gm,lm),krr_loo(Fe,ys,gm,lm)), ' 5fold base %.4f ed %.4f'%(cvk(Fb,ys,gm,lm),cvk(Fe,ys,gm,lm)))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
