{"id": "toolu_01T6eyHfDSrg1kf7zBU17JxL", "caller": {"type": "direct"}, "input": {"code": "exec(open('lib.py').read())\ny=labels()[:1024]; B=load_base()\nP5=loadpass(5)\ndef bn(X): X=X-X.mean(0); return X/np.sqrt((X**2).sum(1).mean())\ndef kcv(Z, gs=(0.5,1), lams=(0.003,0.01,0.03), k=10):\n    Z=Z/np.linalg.norm(Z,axis=1,keepdims=True); S=Z@Z.T\n    return max(max(krr_cv(np.exp(g*(S-1)),y,lams=lams,k=k,seeds=(0,)).values()) for g in gs)\nfor l in [1,2,4,6,8,10,11]:\n    b=B[f'mean_hidden_L{l}'][:1024][:,KEEP].astype(np.float64)\n    e=P5[f'mean_hidden_L{l}'][:,KEEP].astype(np.float64)\n    # relative distortion\n    rel=np.linalg.norm(e-b)/np.linalg.norm(b-b.mean(0))\n    print(l, 'rel dev %.3f'%rel, 'base %.4f'%kcv(bn(b)), 'pruned %.4f'%kcv(bn(e)))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
