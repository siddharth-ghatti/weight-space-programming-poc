{"id": "toolu_01WwgUReTLSmQtJEyRfvqyd3", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,str(WORK))\nimport numpy as np\nfrom poolfit import *\ncp=np.load('carry_prov.npz'); wraw=cp['wraw'].astype(np.float64); mu0=cp['mu0'].astype(np.float64)\nP='bert.encoder.layer.0.'\nWv=W(P+'attention.self.value.weight').astype(np.float64); bv=W(P+'attention.self.value.bias').astype(np.float64)\nVc=Wv[56:64]\nprint('KEEP cols match wraw', np.abs(Vc[:,KEEP]-wraw[KEEP].T).max())\nprint('RES cols', np.round(Vc[:,RES],3))\nprint('bv vs -wraw^T mu0', np.abs(bv[56:64]-(-wraw.T@mu0)).max())\nf=np.load('feats_drop46.npz'); M,C,M0=f['M'],f['C'],f['M0']\nprint('mu0 vs M0 mean', np.abs(mu0-M0.mean(0)).max(), 'M0 RES mean', M0.mean(0)[RES].round(3))\ncold=(M0-mu0)@wraw\nfor nm,X in [('M',M[:,RES]),('C',C[:,RES])]:\n    Xc=X-X.mean(1,keepdims=True); pc=cold-cold.mean(1,keepdims=True)\n    a=(Xc*pc).sum()/(pc**2).sum(); k=(Xc*pc).sum(1)/(pc**2).sum(1)/a\n    r=Xc-(a*k)[:,None]*pc\n    # uncentered: X ~ off + a*k*cold\n    print(nm,'a',round(a,4),'k cv',round(k.std()/k.mean(),3),'R2 cent',round(1-(r**2).sum()/(Xc**2).sum(),4), 'X mean', X.mean(0).round(3), 'X std', X.std(0).round(3))\n    # common-mode check: does mean over 8 dims follow a*k*mean(cold)?\n    cm=X.mean(1); cmo=cold.mean(1); print('  common-mode corr', np.corrcoef(cm, (a*k)*cmo)[0,1], 'cm std', cm.std(), 'pred std', ((a*k)*cmo).std())\nx=10*(M-M.mean(0))+C; print('energy RES/total in pool x (c=10)', (x[:,RES]**2).sum(1).mean()/(x**2).sum(1).mean())"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
