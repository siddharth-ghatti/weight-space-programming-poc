{"id": "toolu_016HpU3nC5Gxc8o9WpbEF1sf", "caller": {"type": "direct"}, "input": {"code": "exec(open('lib.py').read())\ny=labels(); B=load_base()\nU=np.load('E1_u.npy').astype(np.float64)\nL='bert.encoder.layer.11.'\now=W(L+'attention.output.dense.weight'); perm=np.argmax(np.abs(ow),axis=0)\ndef bn(X): X=X-X.mean(0); return X/np.sqrt((X**2).sum(1).mean())\ndef kcv(Z, gs=(0.5,1,2), lams=(0.003,0.01,0.03), k=10):\n    Z=Z/np.linalg.norm(Z,axis=1,keepdims=True); S=Z@Z.T\n    return {g:max(krr_cv(np.exp(g*(S-1)),y,lams=lams,k=k,seeds=(0,)).values()) for g in gs}\nM0=bn(B['mean_hidden_L0'].astype(np.float64))\ncls_dims=np.concatenate([perm[64*h:64*h+8] for h in range(12)])\nrest=np.setdiff1d(np.arange(768),cls_dims)\nprint('U', kcv(bn(U)))\nprint('M0+Urest', kcv(np.concatenate([M0,bn(U[:,rest])],1)))\nprint('M0+U', kcv(np.concatenate([M0,bn(U)],1)))\n# per head pools PCA parts\nfor h in [8,9,10,11]:\n    d=perm[64*h+8:64*h+64]\n    print('M0+head',h, kcv(np.concatenate([M0,0.5*bn(U[:,d])],1),gs=(1,)))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
