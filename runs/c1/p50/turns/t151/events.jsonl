{"id": "toolu_01W7HdbK2A6Fbz7pwdGMWU1f", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom lib import labels, krr_cv, KEEP, RES\ny=labels()[:1024]\nM9=np.load('pass_34/mean_hidden_L9.npy').astype(np.float64); C9=np.load('pass_34/cls_hidden_L9.npy').astype(np.float64)\nM0=np.load('pass_34/mean_hidden_L0.npy').astype(np.float64)\ndef cosK(X,g):\n    Xc=X-X.mean(0); Xn=Xc/np.linalg.norm(Xc,axis=1,keepdims=True); S=Xn@Xn.T; return np.exp(g*(S-1))\ndef lin(X):\n    Xc=X-X.mean(0); return Xc/np.sqrt((Xc**2).sum(1).mean())\nL0=lin(M0); LL=0.5*L0@L0.T\nfor g in [0.5,2.0]:\n    print('g',g, krr_cv(cosK(M9[:,KEEP],g)+LL,y,[0.003,0.01,0.03],k=10,seeds=range(3)))\nA=lin(M9[:,KEEP]); B=lin(C9[:,KEEP])\nfor w in [0.1,0.2,0.35]:\n    X=np.concatenate([A,w*B],1)\n    print('cls w',w, krr_cv(cosK(X,1.0)+LL,y,[0.003,0.01],k=10,seeds=range(3)))\n# raw (uncentered-around-mean x) variant: x = c*(M9-mu)+C9  (what pool attention gives), c large/small\nfor c in [3.0,6.0]:\n    X=c*(M9[:,KEEP]-M9[:,KEEP].mean(0))+C9[:,KEEP]\n    Xn=X-X.mean(1,keepdims=True); Xn/=np.linalg.norm(Xn,axis=1,keepdims=True)\n    K=np.exp(1.0*(Xn@Xn.T-1))\n    print('pool-x c',c, np.linalg.norm(c*(M9[:,KEEP]-M9[:,KEEP].mean(0)),axis=1).mean()/np.linalg.norm(C9[:,KEEP],axis=1).mean(), krr_cv(K+LL,y,[0.003,0.01],k=10,seeds=range(3)))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
