{"id": "toolu_01NXgYUyBnXmdZJFirgDdzzo", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,str(WORK))\nimport numpy as np, json, time\nfrom lib7 import *\nallids=[r['id'] for r in practice()]; y=labels_for(allids, practice, LABELS); Y=np.eye(8)[y]\nf=np.load('feats_drop46.npz'); M,C,M0=f['M'],f['C'],f['M0']\nk=np.load('carry_k.npy')\ndef prep(M,C,tr,c=10,na=1008):\n    mu=M[tr].mean(0); Z=pool_z(M,C,c,mu); Zt=Z[tr]; Wf=anchor_dirs(Zt); Kc=gelu(Zt@Wf.T); Kc=.5*(Kc+Kc.T)\n    piv=pivchol(Kc,na); return feats(Z,Wf[piv]), Kc[np.ix_(piv,piv)]\ndef run(seed, kf=10, lam=.05, c0=.5, c=10):\n    fo_=folds(y,kf,seed); P={n:np.zeros(1496,int) for n in ['A','Dk','D1','Dk_kmean']}\n    for i in range(kf):\n        tr=fo_!=i; te=~tr; Lin=lin_feats(M0,tr)\n        Pn,Kn=prep(M,C,tr,c=c)\n        cn,bn=fit(Pn[tr],Lin[tr],Y[tr],Kn,lam,c0)\n        Sk=Pn@cn[:1008]; Sl=Lin@cn[1008:]\n        P['A'][te]=(Sk+Sl+bn)[te].argmax(1)\n        P['Dk'][te]=(Sk+k[:,None]*Sl+bn)[te].argmax(1)\n        P['D1'][te]=(Sk+Sl+bn)[te].argmax(1)\n        # pool knows per-sample nothing; but rescale lin by 1/mean(k on train)\n        P['Dk_kmean'][te]=(Sk+(k/k[tr].mean())[:,None]*Sl+bn)[te].argmax(1)\n    return {n:(p==y).mean() for n,p in P.items()}\nR=[run(s) for s in range(10,16)]\nfor n in R[0]: print(n, np.round([r[n] for r in R],4), round(np.mean([r[n] for r in R]),4))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
