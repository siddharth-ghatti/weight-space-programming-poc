{"id": "toolu_01NALnfHppGuG52G57GcbqKs", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.'); from lib import *\ntoks=json.load(open('pass_4/tokens.json')); mask=np.load('pass_4/attention_mask.npy').astype(bool)\nprint(type(toks), len(toks), toks[0][:12] if isinstance(toks,list) else list(toks.keys())[:3])\nX0=np.load('pass_4/token_hidden_L0.npy')  # [64,54,768]\npos=np.tile(np.arange(X0.shape[1]),(64,1))[mask]; Xt=X0[mask]\nlens=mask.sum(1); print('lens',lens.min(),lens.max())\nd=load_base(); y=labels(); M0=d['mean_hidden_L0']\nW,b=ridge_fit(M0,y,3.0)   # class directions on mean features (all 768 dims incl reserved -> L0 has no reserved issue)\nS=Xt@W  # token class scores\nprint('token score std overall', S.std(0).round(2))\n# within-sentence std\nrows=np.repeat(np.arange(64),lens)\nws=np.mean([S[rows==i].std(0) for i in range(64)],0); print('within-sent std',ws.round(2))\nnp.savez('pool_design.npz',W=W,b=b)"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
