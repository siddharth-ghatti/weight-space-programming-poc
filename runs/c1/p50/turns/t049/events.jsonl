{"id": "toolu_01WyksxCnmcpYR7EjcDGJ2AG", "caller": {"type": "direct"}, "input": {"code": "exec(open('lib.py').read())\ny=labels(); B=load_base()\nM0=B['mean_hidden_L0'].astype(np.float64)\nXc=M0-M0.mean(0)\nu,s,vt=np.linalg.svd(Xc,full_matrices=False)\nev=s**2/np.sum(s**2); print('cum var', [round(ev[:k].sum(),3) for k in [8,32,64,128,256,384]])\ndef kcv(Z, gs=(0.5,1,2,3), lams=(0.003,0.01,0.03), k=10):\n    Z=Z/np.linalg.norm(Z,axis=1,keepdims=True); S=Z@Z.T\n    return {g:krr_cv(np.exp(g*(S-1)),y,lams=lams,k=k,seeds=(0,)) for g in gs}\nprint('full', kcv(Xc))\nfor kd in [64,128,256,384]:\n    Z=Xc@vt[:kd].T\n    print(kd, kcv(Z,gs=(1,2),lams=(0.003,0.01)))\n# whitened-ish: scale pcs by s^-a\nfor a in [0.25,0.5]:\n    Z=(Xc@vt[:384].T)/s[:384]**a\n    print('white',a, kcv(Z,gs=(1,2,4),lams=(0.003,0.01,0.03)))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
