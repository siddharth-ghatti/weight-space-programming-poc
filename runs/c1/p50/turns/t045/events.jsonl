{"id": "toolu_012jbAu93zm7Uw68ScsmzToY", "caller": {"type": "direct"}, "input": {"code": "exec(open('lib.py').read())\nL='bert.encoder.layer.11.'\nqb=W(L+'attention.self.query.bias'); qw=W(L+'attention.self.query.weight')\nkw=W(L+'attention.self.key.weight'); kb=W(L+'attention.self.key.bias')\nvw=W(L+'attention.self.value.weight'); vb=W(L+'attention.self.value.bias')\now=W(L+'attention.output.dense.weight'); ob=W(L+'attention.output.dense.bias')\nprint('qw norm', np.abs(qw).max(), 'qb nonzero', np.nonzero(qb)[0], qb[np.nonzero(qb)[0]])\nfor h in range(12):\n    s=slice(64*h,64*h+64)\n    print(h, 'k norm %.2f'%np.linalg.norm(kw[s]), 'kb %.2f'%np.linalg.norm(kb[s]), 'v norm %.2f'%np.linalg.norm(vw[s]), 'rank v', np.linalg.matrix_rank(vw[s]), 'o cols norm %.2f'%np.linalg.norm(ow[:,s]))\nprint('ow nonzero rows', (np.abs(ow).sum(1)>0).sum(), 'cols', (np.abs(ow).sum(0)>0).sum())\nnzr=np.where(np.abs(ow).sum(1)>0)[0]; print(nzr[:20])\nprint('ow structure: per col nonzero count', np.unique((np.abs(ow)>0).sum(0)))\nfor nm in ['attention.output.LayerNorm.weight','attention.output.LayerNorm.bias','output.LayerNorm.weight','output.LayerNorm.bias','output.dense.bias','intermediate.dense.bias']:\n    a=W(L+nm); print(nm, a.min(), a.max())\nprint(np.abs(W(L+'output.dense.weight')[:,0]).max(), np.abs(base(L+'output.dense.weight')[:,0]).max())\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
