{"id": "toolu_01M9QkMfdCtXNdRooC5bs7YF", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.'); from lib import *\nfrom scipy.special import erf\ngelu=lambda t: 0.5*t*(1+erf(t/np.sqrt(2)))\nd=load_base(); y=labels()\nM=lambda l: d[f'mean_hidden_L{l}'][:,KEEP]; Cc=lambda l: d[f'cls_hidden_L{l}'][:,KEEP]\ndef cosnorm(X):\n    Z=X-X.mean(0); Z=Z-Z.mean(1,keepdims=True); return Z/np.linalg.norm(Z,axis=1,keepdims=True)\ndef kern(Z,a=1.0): S=Z@Z.T; return S+(gelu(a*S)+gelu(-a*S))/(a*a)\nL=(0.01,0.03,0.1)\nfor name,bl in [('M0',[M(0)]),('M1',[M(1)]),('M0M1',[M(0),M(1)]),('M0M1M2',[M(0),M(1),M(2)]),('orig',[M(2),M(6),M(10),Cc(12)]),('M0..M12',[M(l) for l in [0,3,6,9,12]])]:\n    Z=cosnorm(blockn(bl)); K=kern(Z)\n    print(name,'10f',krr_cv(K,y,L,k=10,seeds=(0,1,2)),'20f',krr_cv(K,y,L,k=20,seeds=(0,1)))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
