{"id": "toolu_01NF29SxnygWRkuoxofdbvqy", "caller": {"type": "direct"}, "input": {"code": "exec(open('lib.py').read())\ny=labels(); B=load_base()\ndef feat(l, kind='mean'):\n    X=B[f'{kind}_hidden_L{l}'][:,KEEP].astype(np.float64); X=X-X.mean(0); return X/np.sqrt((X**2).sum(1).mean())\ndef kcv(Z, gs=(0.5,1), lams=(0.003,0.01,0.03), k=10):\n    Z=Z/np.linalg.norm(Z,axis=1,keepdims=True); S=Z@Z.T\n    return {g:max(krr_cv(np.exp(g*(S-1)),y,lams=lams,k=k,seeds=(0,)).values()) for g in gs}\nfor l in [7,8,9,10,11]:\n    print('M0+M%d'%l, kcv(np.concatenate([feat(0),feat(l)],1)), ' M%d'%l, kcv(feat(l)))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
