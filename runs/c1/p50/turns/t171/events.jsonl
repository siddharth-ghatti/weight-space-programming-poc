{"id": "toolu_01Sg883u6tc1jckXmA6cmbxf", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,str(WORK))\nfrom lib7 import *\nimport lib7\nF={k:v.astype(np.float64) for k,v in np.load('feats_seq1024_depth.npz').items()}\ny=labels_for([f'p{i:04d}' for i in range(1496)], practice, LABELS)\ndef cv2(last, extra, c0s=None, seeds=(0,1,2), lam=0.02):\n    M=F[f'M{last}']; C=F[f'C{last}']\n    res=[]\n    for sd in seeds:\n        f=folds(y,10,sd); Y=np.eye(8)[y]; pred=np.zeros(len(y),int)\n        for i in range(10):\n            tr=f!=i; te=~tr; mu=M[tr].mean(0)\n            Z=pool_z(M,C,10.0,mu); Zt=Z[tr]; Wf=anchor_dirs(Zt); Kc=gelu(Zt@Wf.T); Kc=.5*(Kc+Kc.T)\n            piv=pivchol(Kc,1008); Wd=Wf[piv]; Kaa=Kc[np.ix_(piv,piv)]; Phi=feats(Z,Wd)\n            Lin=np.concatenate([lin_feats(F[e],tr) for e in extra],1) if extra else np.zeros((len(y),0))\n            coef,b=fit(Phi[tr],Lin[tr],Y[tr],Kaa,lam,0.5/max(1,len(extra)))\n            pred[te]=(np.concatenate([Phi[te],Lin[te]],1)@coef+b).argmax(1)\n        res.append((pred==y).mean())\n    return np.mean(res), np.round(res,4)\nfor last in [9,8,7]:\n    for extra in [['M0'],['M0','M4'],['M0','M6'],['M0','M5'],['M0','M4','M6']]:\n        if any(int(e[1:])>=last for e in extra): continue\n        print(last, extra, cv2(last,extra), flush=True)\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
