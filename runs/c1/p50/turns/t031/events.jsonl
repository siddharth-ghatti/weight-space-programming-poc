{"id": "toolu_01XJFLPn8JSHLVnsuoTWF9AM", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.'); from lib import *\nfrom scipy.special import erf\ngelu=lambda t: 0.5*t*(1+erf(t/np.sqrt(2)))\nd=load_base(); y=labels()\nM=lambda l: d[f'mean_hidden_L{l}'][:,KEEP]\ndef cosnorm(X):\n    Z=X-X.mean(0); Z=Z-Z.mean(1,keepdims=True); return Z/np.linalg.norm(Z,axis=1,keepdims=True)\nZ=cosnorm(M(0)); S=Z@Z.T\nprint('s pct', np.percentile(S[np.triu_indices(len(S),1)],[1,10,50,90,99]))\nL=(1e-3,3e-3,0.01,0.03,0.1,0.3)\nprint('exp', krr_cv(np.exp(S),y,L,k=10,seeds=(0,)))\nprint('exp2', krr_cv(np.exp(2*S),y,L,k=10,seeds=(0,)))\nfor a,b in [(4,0),(4,-1),(6,-1),(8,-2),(3,-0.5),(10,-3),(5,0)]:\n    print('gelu',a,b, krr_cv(gelu(a*S+b),y,L,k=10,seeds=(0,)))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
