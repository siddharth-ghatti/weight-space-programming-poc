{"id": "toolu_01SQm4gXSFK1XiGojWgGNBE5", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.'); from lib import *\nfrom scipy.special import erf\ngelu=lambda t: 0.5*t*(1+erf(t/np.sqrt(2)))\nd=load_base(); y=labels()\nM=lambda l: d[f'mean_hidden_L{l}'][:,KEEP]\ndef cosnorm(X):\n    Z=X-X.mean(0); Z=Z-Z.mean(1,keepdims=True); return Z/np.linalg.norm(Z,axis=1,keepdims=True)\nZ=cosnorm(M(0)); S=Z@Z.T\nL=(1e-3,0.01,0.03,0.1,0.3,1)\nfor a in [1,2,3,4]:\n    Kp=gelu(a*S)+gelu(-a*S)\n    print('pair-even a',a, krr_cv(S+ Kp/ (a*a),y,L,k=10,seeds=(0,)))\nprint('poly2', krr_cv(1+S+S**2/2,y,L,k=10,seeds=(0,)))\nprint('poly3', krr_cv(1+S+S**2/2+S**3/6,y,L,k=10,seeds=(0,)))\nprint('S+S^2', krr_cv(S+S**2,y,L,k=10,seeds=(0,)))\nprint('S+2S^2', krr_cv(S+2*S**2,y,L,k=10,seeds=(0,)))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
