{"id": "toolu_015nfkKMWo2pepPF5yfBaeNp", "caller": {"type": "direct"}, "input": {"code": "exec(open('lib.py').read())\ny=labels()\nU=np.load('E1_u.npy').astype(np.float64)\nprint('U norm', np.linalg.norm(U,axis=1)[:5], U.mean(1)[:3], U.std(1)[:3])\nprint('lin10', cv_acc(U,y,lams=(0.1,1,10,100),k=10))\nB=load_base()\nM0=B['mean_hidden_L0'].astype(np.float64)\nprint('M0 lin10', cv_acc(M0,y,lams=(0.1,1,10,100),k=10))\ndef cosn(X):\n    Xc=X-X.mean(0); return Xc/np.linalg.norm(Xc,axis=1,keepdims=True)\nimport scipy.special as sp\ndef gelu(x): return 0.5*x*(1+sp.erf(x/np.sqrt(2)))\nfor name,X in [('U',U),('M0',M0)]:\n    Z=cosn(X); S=Z@Z.T\n    for sc in [2,4]:\n        K=S+gelu(sc*S)/sc+gelu(-sc*S)/sc\n        print(name, sc, krr_cv(K,y,lams=(0.03,0.1,0.3,1),k=10,seeds=(0,)))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
