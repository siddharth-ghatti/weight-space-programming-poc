{"id": "toolu_01K94ruPKBZ6VQv9wwVS6eeX", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.'); from lib import *\nd=load_base(); y=labels()\nM=lambda l: d[f'mean_hidden_L{l}'][:,KEEP]\ndef tanh_rf_cv(X, y, nfeat=768, scale=1.0, lams=(0.1,1,10), k=10, seeds=(0,), rs=0):\n    Xs=X-X.mean(0); Xs=Xs/np.sqrt((Xs**2).sum(1).mean())  # unit rms norm\n    rng=np.random.RandomState(rs); Wr=rng.randn(X.shape[1],nfeat)*scale; br=rng.randn(nfeat)*0.0\n    F=np.tanh(Xs@Wr+br)\n    return cv_acc(F,y,lams=lams,k=k,seeds=seeds)\nX0=M(0)\nfor sc in [1,2,4,8]:\n    print('L0 tanh rf scale',sc, tanh_rf_cv(X0,y,scale=sc))\nprint('L0 lin 10f',cv_acc(X0,y,lams=(3,),k=10))\n# PCA compressions\nXc=X0-X0.mean(0); U,S,Vt=np.linalg.svd(Xc,full_matrices=False)\nfor r in [32,64,128,256,384]:\n    Z=Xc@Vt[:r].T\n    print('PCA',r,'lin',cv_acc(Z,y,lams=(1,3,10),k=10), 'rbf', krr_cv(rbf(Z),y,(0.01,),k=10,seeds=(0,)))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
