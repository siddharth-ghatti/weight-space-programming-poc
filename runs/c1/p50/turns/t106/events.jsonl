{"id": "toolu_01PyKTKyieafuvbVBaikypUF", "caller": {"type": "direct"}, "input": {"code": "import sys, json; sys.path.insert(0, str(WORK))\nfrom lib import *\nimport scipy.special as sp\ndef gelu(x): return 0.5*x*(1+sp.erf(x/np.sqrt(2)))\ny=labels(); d=np.load('base_feats.npz'); N=len(y); Y=np.eye(8)[y]\ndef cn(X):\n    X=X[:,KEEP].astype(np.float64); X=X-X.mean(0); return X/np.linalg.norm(X,axis=1,keepdims=True)\ndef cen(X):\n    X=X[:,KEEP].astype(np.float64); X=X-X.mean(0); return X/np.sqrt((X**2).sum(1).mean())\nZ9=cn(d['mean_hidden_L9']); C0=cen(d['mean_hidden_L0'])\ndef anchor_cv(a, b, nanch=1000, lam=1e-2, c0=0.5, seeds=(0,1), k=10, lamlin=None):\n    accs=[]\n    for s in seeds:\n        f=folds(y,k,s); S=np.zeros((N,8)); rng=np.random.RandomState(s)\n        for i in range(k):\n            tr=np.where(f!=i)[0]; te=np.where(f==i)[0]\n            anc=rng.choice(tr, min(nanch,len(tr)), replace=False)\n            Phi=gelu(a*(Z9@Z9[anc].T)+b)\n            F=np.hstack([Phi, np.sqrt(c0)*C0*np.sqrt(Phi.shape[1]/C0.shape[1])*0+np.sqrt(c0)*C0]) if c0>0 else Phi\n            mu=F[tr].mean(0); Fc=F-mu\n            Wt=np.linalg.solve(Fc[tr].T@Fc[tr]+lam*np.eye(F.shape[1]), Fc[tr].T@(Y[tr]-Y[tr].mean(0)))\n            S[te]=Fc[te]@Wt\n        accs.append((S.argmax(1)==y).mean())\n    return round(float(np.mean(accs)),4)\nprint('exact KRR K9+0.5lin0:', krr_cv(np.exp(Z9@Z9.T-1)+0.5*C0@C0.T,y,[0.005],k=10,seeds=(0,1)))\nfor a,b in [(1,0),(3,-1),(5,-2),(8,-4),(4,0)]:\n    print(a,b,[anchor_cv(a,b,lam=l) for l in [0.1,1.0,10.0]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
