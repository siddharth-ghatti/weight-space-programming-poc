{"id": "toolu_01D1C64GT55eYiddpEbPnHdn", "caller": {"type": "direct"}, "input": {"code": "import sys, json; sys.path.insert(0, str(WORK))\nfrom lib import *\ny=labels(); d=np.load('base_feats.npz')\ndef cn(X):\n    X=X[:,KEEP].astype(np.float64); X=X-X.mean(0); return X/np.linalg.norm(X,axis=1,keepdims=True)\ndef K(Xs,g=1.0):\n    Z=np.concatenate([cn(X) for X in Xs],1)/np.sqrt(len(Xs)); return np.exp(g*(Z@Z.T-1))\nM=lambda l: d[f'mean_hidden_L{l}']; C=lambda l: d[f'cls_hidden_L{l}']\ncombos={'0,1,2':[M(0),M(1),M(2)],'0,1,2,3':[M(0),M(1),M(2),M(3)],'0..4':[M(i) for i in range(5)],'0..6':[M(i) for i in range(7)],\n        '0,2':[M(0),M(2)],'0,1,C1':[M(0),M(1),C(1)],'0,C1':[M(0),C(1)], '0,1,9':[M(0),M(1),M(9)],'0,4,9':[M(0),M(4),M(9)],'0,8,9':[M(0),M(8),M(9)],'1,9':[M(1),M(9)]}\nfor nm,Xs in combos.items():\n    for g in [1.0,2.0]:\n        print(nm,g,krr_cv(K(Xs,g),y,[0.003,0.01],k=10,seeds=(0,)))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
