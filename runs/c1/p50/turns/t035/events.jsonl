{"id": "toolu_018E8wvSoF3YjAswRLCEBKNp", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.'); from lib import *\nmask=np.load('pass_4/attention_mask.npy').astype(bool); X0=np.load('pass_4/token_hidden_L0.npy')\nT=X0.shape[1]; lens=mask.sum(1)\npos=np.tile(np.arange(T),(64,1))\nissep=np.zeros_like(mask); issep[np.arange(64),lens-1]=True\nbody=mask.copy(); body[:,0]=False; body&=~issep\nXb=X0[body]; pb=pos[body]\nxcls=X0[0,0]; print('cls const?', np.abs(X0[:,0]-xcls).max())\n# position direction: ridge x->pos on body tokens\nmu=Xb.mean(0); A=Xb-mu; lam=10.0\nr=np.linalg.solve(A.T@A+lam*np.eye(768),A.T@(pb-pb.mean()))\npred=A@r; print('pos R2', 1-((pred-(pb-pb.mean()))**2).mean()/pb.var())\nprint('pred vs pos (mean per pos):', [round(float(pred[pb==p].mean()+pb.mean()),1) for p in [1,2,3,5,8,12,20,30,40]])\n# r . x for cls and sep\nprint('r.x cls', float((xcls-mu)@r+pb.mean()), 'sep', float(((X0[issep]-mu)@r).mean()+pb.mean()))\n# cls suppress direction\nc=xcls-Xb.mean(0); c/=np.linalg.norm(c)\nprint('c.x cls',float(c@xcls),'c.x body pct',np.percentile(Xb@c,[1,50,99]),'sep',np.percentile(X0[issep]@c,[1,50,99]))\n# token PCA\nXall=X0[mask]; U,S,Vt=np.linalg.svd(Xall-Xall.mean(0),full_matrices=False); print('pca var top', (S[:64]**2/ (S**2).sum()).sum())\nnp.savez('pool_design.npz', **dict(np.load('pool_design.npz')), r=r, rmu=mu, pmean=pb.mean(), c=c, xcls=xcls, pca=Vt[:128], tokmean=Xall.mean(0))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
