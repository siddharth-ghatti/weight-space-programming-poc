{"id": "toolu_01H4UZkoy3s6mZRXtQA76hm4", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.'); from lib import *\nd=load_base(); y=labels()\nM=lambda l: d[f'mean_hidden_L{l}'][:,KEEP]\ndef anchor_cv(X, y, a, b, k=10, seeds=(0,), lams=(0.01,0.1,1), nanc=768, stdz=True):\n    res={lam:[] for lam in lams}\n    for s in seeds:\n        f=folds(y,k,s); S={lam:np.zeros((len(y),8)) for lam in lams}\n        for i in range(k):\n            tr=f!=i; te=f==i\n            mu=X[tr].mean(0); Z=X-mu; Z=Z/np.sqrt((Z[tr]**2).sum(1).mean())\n            rng=np.random.RandomState(i+100*s); A=Z[tr][rng.choice(tr.sum(),nanc,replace=False)]\n            F=np.tanh(a*(Z@A.T)+b).astype(np.float32).astype(np.float64)\n            if stdz: F=(F-F[tr].mean(0))/(F[tr].std(0)+1e-12)\n            for lam in lams:\n                W,bb=ridge_fit(F[tr],y[tr],lam); S[lam][te]=F[te]@W+bb\n        for lam in lams: res[lam].append((S[lam].argmax(1)==y).mean())\n    return {lam:round(float(np.mean(v)),4) for lam,v in res.items()}\nX0=M(0)\nfor a,b in [(2,-1),(0.5,-3),(1,-3),(1.5,-3),(2,-3),(3,-4),(1,-2)]:\n    print(a,b, anchor_cv(X0,y,a,b,lams=(1,10,100,1000)))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
