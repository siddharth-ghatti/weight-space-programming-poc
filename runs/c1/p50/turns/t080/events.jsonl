{"id": "toolu_01Ucfe5eapbzkCbWD7rmDFP8", "caller": {"type": "direct"}, "input": {"code": "exec(open('lib.py').read())\ny=labels(); B=load_base()\ndef cen(X): X=X[:,KEEP].astype(np.float64); return X-X.mean(0)\ndef bn(X): return X/np.sqrt((X**2).sum(1).mean())\ndef kcv(Z, gs=(0.5,1), lams=(0.003,0.01,0.03), k=10, seeds=(0,)):\n    Z=Z/np.linalg.norm(Z,axis=1,keepdims=True); S=Z@Z.T\n    return max(max(krr_cv(np.exp(g*(S-1)),y,lams=lams,k=k,seeds=seeds).values()) for g in gs)\nM={l:bn(cen(B[f'mean_hidden_L{l}'])) for l in [0,2,4,5,6,7,8,9]}\nprint('M9 2seeds', kcv(M[9],seeds=(0,1)))\nfor l in [2,4,6,7,8]:\n    print('M%d+M9'%l, kcv(np.concatenate([M[l],M[9]],1),seeds=(0,1)))\nprint('M9 20f', kcv(M[9],k=20))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
