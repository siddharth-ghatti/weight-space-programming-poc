{"id": "toolu_01Puimcu5hn3PFdzjMvbfV3o", "caller": {"type": "direct"}, "input": {"code": "import sys, json; sys.path.insert(0, str(WORK))\nfrom lib import *\ny=labels(); d=np.load('base_feats.npz'); N=len(y); Y=np.eye(8)[y]\ndef cn(X):\n    X=X[:,KEEP].astype(np.float64); X=X-X.mean(0); return X/np.linalg.norm(X,axis=1,keepdims=True)\ndef oof_krr(K, f, lam=0.005):\n    S=np.zeros((N,8))\n    for i in np.unique(f):\n        tr=f!=i; te=f==i\n        A=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()), Y[tr]-Y[tr].mean(0)); S[te]=K[np.ix_(te,tr)]@A\n    return S\ndef oof_ridge(X, f, lam):\n    S=np.zeros((N,8))\n    for i in np.unique(f):\n        tr=f!=i; te=f==i; Wt,b=ridge_fit(X[tr],y[tr],lam); S[te]=X[te]@Wt+b\n    return S\nZ9=cn(d['mean_hidden_L9']); K9=np.exp(Z9@Z9.T-1)\nZs={l:cn(d[f'mean_hidden_L{l}'])*np.sqrt(767) for l in [0,1,2,6]}\nfor l in [0,2,6]:\n    for lamr in [30,100,300]:\n        accs={b:[] for b in [0,0.25,0.5,1.0]}\n        for s in range(3):\n            f=folds(y,10,s)\n            S9=oof_krr(K9,f); L=oof_ridge(Zs[l],f,lamr)\n            for b in accs: accs[b].append(((S9+b*L).argmax(1)==y).mean())\n        print('M%d lam%d'%(l,lamr), {b:round(np.mean(v),4) for b,v in accs.items()}, 'lin alone', round((L.argmax(1)==y).mean(),4))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
