{"id": "toolu_01TiHbXrUi5KN25yYL3hjUYE", "caller": {"type": "direct"}, "input": {"code": "exec(open('lib.py').read())\ny=labels(); B=load_base()\ndef cen(X): X=X[:,KEEP].astype(np.float64); return X-X.mean(0)\ndef bn(X): return X/np.sqrt((X**2).sum(1).mean())\ndef kcv(Z, gs=(0.5,1), lams=(0.003,0.01,0.03), k=10):\n    Z=Z/np.linalg.norm(Z,axis=1,keepdims=True); S=Z@Z.T\n    return max(max(krr_cv(np.exp(g*(S-1)),y,lams=lams,k=k,seeds=(0,)).values()) for g in gs)\nM0=cen(B['mean_hidden_L0']); M9=cen(B['mean_hidden_L9']); C9=cen(B['cls_hidden_L9'])\n# R: M9 -> M0 ridge (unsupervised)\nfor lam in [1,10,100]:\n    R=np.linalg.solve(M9.T@M9+lam*np.eye(M9.shape[1]), M9.T@M0)\n    # CV R^2 quickly (2-fold)\n    h=np.arange(1496)%2==0\n    R2=np.linalg.solve(M9[h].T@M9[h]+lam*np.eye(760), M9[h].T@M0[h]); pr=M9[~h]@R2\n    print('lam',lam,'heldout R2 %.3f'%(1-((pr-M0[~h])**2).sum()/((M0[~h]-M0[~h].mean(0))**2).sum()))\nR=np.linalg.solve(M9.T@M9+10*np.eye(760), M9.T@M0)\nprint('M9', kcv(bn(M9)))\nprint('M0+M9', kcv(np.concatenate([bn(M0),bn(M9)],1)))\nprint('RM9+M9', kcv(np.concatenate([bn(M9@R),bn(M9)],1)))\nprint('M9+C9', kcv(np.concatenate([bn(M9),bn(C9)],1)))\nprint('M0+M9+C9', kcv(np.concatenate([bn(M0),bn(M9),bn(C9)],1)))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
