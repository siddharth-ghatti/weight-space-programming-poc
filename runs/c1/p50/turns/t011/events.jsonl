{"id": "toolu_01GHX7xkQngQSpLQ7yZk4jLb", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.'); from lib import *\nd=load_base(); y=labels()\nM=lambda l: d[f'mean_hidden_L{l}'][:,KEEP]\ndef krr_cv(K, y, lams, k=5, seed=0):\n    f=folds(y,k,seed); out={}\n    Y=np.eye(8)[y]\n    for lam in lams:\n        S=np.zeros((len(y),8))\n        for i in range(k):\n            tr=f!=i; te=f==i\n            Ktr=K[np.ix_(tr,tr)]; A=np.linalg.solve(Ktr+lam*np.eye(tr.sum()), Y[tr]-Y[tr].mean(0))\n            S[te]=K[np.ix_(te,tr)]@A\n        out[lam]=round(float((S.argmax(1)==y).mean()),4)\n    return out\nfor name,X in [('L0',M(0)),('L0+L1',np.concatenate([M(0),M(1)],1)),('L6',M(6))]:\n    Xs=(X-X.mean(0)); \n    D2=((Xs[:,None,:]-Xs[None,:,:])**2).sum(-1) if len(X)<0 else None\n    sq=(Xs**2).sum(1); D2=sq[:,None]+sq[None,:]-2*Xs@Xs.T; med=np.median(D2)\n    for gfac in [0.5,1,2]:\n        K=np.exp(-D2/(gfac*med)); print(name,'rbf',gfac,krr_cv(K,y,(0.01,0.03,0.1,0.3)))\n    Kl=Xs@Xs.T; print(name,'lin',krr_cv(Kl,y,(1,3,10)))\n    Kc=Xs@Xs.T/ (np.sqrt(sq)[:,None]*np.sqrt(sq)[None,:]); print(name,'cos-lin', krr_cv(Kc,y,(0.01,0.03,0.1,0.3)))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
