{"id": "toolu_01DwpzGFqJ15toVTYpADC6LH", "caller": {"type": "direct"}, "input": {"code": "import sys, json; sys.path.insert(0, str(WORK))\nfrom lib import *\ny=labels(); d=np.load('base_feats.npz')\ndef cn(X):\n    X=X[:,KEEP].astype(np.float64); X=X-X.mean(0); return X/np.linalg.norm(X,axis=1,keepdims=True)\ndef cen(X, Xref):\n    X=X[:,KEEP].astype(np.float64); X=X-X.mean(0); return X/np.sqrt((X**2).sum(1).mean())\nZ9=cn(d['mean_hidden_L9']); K9=np.exp(Z9@Z9.T-1)\nfor l in [0,1,2,3,6]:\n    Zl=cn(d[f'mean_hidden_L{l}']); Cl=cen(d[f'mean_hidden_L{l}'],None)\n    r={}\n    for c in [0.25,0.5,1.0]:\n        r[c]=krr_cv(K9+c*(Zl@Zl.T),y,[0.005],k=10,seeds=(0,1,2))[0.005]\n    r2=krr_cv(K9+0.5*(Cl@Cl.T),y,[0.005],k=10,seeds=(0,1,2))[0.005]\n    print('M%d cosnorm-lin'%l, r, ' unnormalized-lin c.5:',r2)\n# pruned features (1024) \nyy=y[:1024]\nfor tag,pk in [('m1024',19),('m1536',22)]:\n    E9=cn(np.load(f'pass_{pk}/mean_hidden_L9.npy')); Ke=np.exp(E9@E9.T-1)\n    Z0=cn(d['mean_hidden_L0'][:1024])\n    out={'K9e':krr_cv(Ke,yy,[0.005],k=10,seeds=range(5))[0.005], 'K9e+lin0':krr_cv(Ke+0.5*Z0@Z0.T,yy,[0.005],k=10,seeds=range(5))[0.005]}\n    if pk==19:\n        Z2=cn(np.load('pass_19/mean_hidden_L2.npy')); out['K9e+lin2e']=krr_cv(Ke+0.5*Z2@Z2.T,yy,[0.005],k=10,seeds=range(5))[0.005]\n    print(tag,out)"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
