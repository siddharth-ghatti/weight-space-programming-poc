{"id": "toolu_014Jdxo3GqsQ8tjZHHggs6Xq", "caller": {"type": "direct"}, "input": {"code": "mask=np.load('pass_4/attention_mask.npy').astype(bool)\nH=[np.load(f'pass_4/token_hidden_L{L}.npy')[mask] for L in range(13)]\ndef cos(a,b): return (np.sum(a*b,1)/np.linalg.norm(a,axis=1)/np.linalg.norm(b,axis=1))\nres=np.load(WORK/'reserved.npy'); keep=np.setdiff1d(np.arange(768),res)\nfor L in range(12):\n    a=H[L][:,keep]; b=H[L+1][:,keep]\n    a0=a-a.mean(1,keepdims=True); b0=b-b.mean(1,keepdims=True)\n    print(L, 'cos(hs[L],hs[L+1]) mean', round(float(cos(a0,b0).mean()),3), ' rel change', round(float(np.mean(np.linalg.norm(b0-a0,axis=1)/np.linalg.norm(a0,axis=1))),3))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
