{"id": "toolu_01CacasG2AuConBUqVqH5RC3", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0, str(WORK))\nfrom cvlib import *\nR = np.load(WORK/'base_reads.npz'); y=R['y']; res=np.load(WORK/'reserved.npy')\nkeep = np.setdiff1d(np.arange(768), res)\nM = lambda L: R[f'mean_hidden_L{L}'][:,keep]\ndef krr_cv(X, y, gammas, lams, k=5):\n    f=folds(y,k,0); out={}\n    mu=X.mean(0); sd=X.std(0)+1e-6; Z=(X-mu)/sd\n    sq=(Z**2).sum(1); D2 = sq[:,None]+sq[None,:]-2*Z@Z.T; D2/= Z.shape[1]\n    Y=np.eye(8)[y]\n    for g in gammas:\n        K=np.exp(-g*D2)\n        for lam in lams:\n            S=np.zeros((len(y),8))\n            for i in range(k):\n                tr=f!=i; te=f==i\n                Ytr=Y[tr]-Y[tr].mean(0)\n                A=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()), Ytr)\n                S[te]=K[np.ix_(te,tr)]@A\n            out[(g,lam)]=round(float((S.argmax(1)==y).mean()),4)\n    return out\nfor L in [0,1,2]:\n    print(L, krr_cv(M(L), y, gammas=[0.1,0.3,1.0], lams=[0.01,0.1,1]))\nX=np.concatenate([M(0),M(1),M(2)],1); print('012', krr_cv(X,y,[0.1,0.3,1.0],[0.01,0.1,1]))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
