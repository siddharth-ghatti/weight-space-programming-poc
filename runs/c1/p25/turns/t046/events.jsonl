{"id": "toolu_01Big9qVqMos2o96iTDtnAVy", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom cvlib import folds\nd=np.load('base_reads.npz'); y=d['y']; R=np.load('reserved.npy')\nkeep=np.setdiff1d(np.arange(768),R)\nM={j:d[f'mean_hidden_L{j}'][:,keep] for j in range(13)}\nC={j:d[f'cls_hidden_L{j}'][:,keep] for j in range(13)}\ndef z(X): return (X-X.mean(0))/(X.std(0)+1e-6)\ndef kcv(K, y, lams, seeds=(0,1,2)):\n    Y=np.eye(8)[y]; out={}\n    for lam in lams:\n        a=[]\n        for s in seeds:\n            f=folds(y,5,s); S=np.zeros((len(y),8))\n            for i in range(5):\n                tr=f!=i; te=f==i\n                A=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()), Y[tr]-Y[tr].mean(0))\n                S[te]=K[np.ix_(te,tr)]@A\n            a.append((S.argmax(1)==y).mean())\n        out[lam]=round(100*np.mean(a),2)\n    return out\ndef quad(X,c=0.5):\n    Z=z(X); Z/=np.linalg.norm(Z,axis=1,keepdims=True); Cc=Z@Z.T; return Cc+c*Cc**2\ndef lin(X): Z=z(X)/np.sqrt(X.shape[1]); return Z@Z.T\nL=(1e-2,3e-2)\nprint('M8 quad(M8+C8)+linM2', kcv(quad(np.hstack([M[8],C[8]]))+lin(M[2]),y,L))\nprint('M8 quad(M8,c=1)+linM2', kcv(quad(M[8],1.0)+lin(M[2]),y,L))\nprint('M8 quad(M8)+quad(M5)+linM2', kcv(quad(M[8])+quad(M[5])+lin(M[2]),y,L))\nprint('M8 quad(cat M8 M6)+linM2', kcv(quad(np.hstack([M[8],M[6]]))+lin(M[2]),y,L))\nprint('M8 quad(M8)+linM2+linM5', kcv(quad(M[8])+lin(M[2])+lin(M[5]),y,L))\nprint('M9 quad(M9+C9)+linM2', kcv(quad(np.hstack([M[9],C[9]]))+lin(M[2]),y,L))\nprint('M9 quad(M9)+linM2+linM6', kcv(quad(M[9])+lin(M[2])+lin(M[6]),y,L))\nprint('M9 quad(M9,c=1)+linM2', kcv(quad(M[9],1.0)+lin(M[2]),y,L))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
