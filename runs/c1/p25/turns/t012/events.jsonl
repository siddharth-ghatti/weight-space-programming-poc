{"id": "toolu_01MWGDSmiW3NbwpTpoDBtUQz", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0, str(WORK))\nfrom cvlib import *\nR = np.load(WORK/'base_reads.npz'); y=R['y']; res=np.load(WORK/'reserved.npy'); ids=R['ids']\nkeep = np.setdiff1d(np.arange(768), res)\nM = lambda L: R[f'mean_hidden_L{L}'][:,keep]\nP={x['id']:x for x in practice()}\nX=M(1); f=folds(y,5,0)\nmu=X.mean(0); sd=X.std(0)+1e-6; Z=(X-mu)/sd\nsq=(Z**2).sum(1); D2=(sq[:,None]+sq[None,:]-2*Z@Z.T)/Z.shape[1]; K=np.exp(-0.3*D2); Y=np.eye(8)[y]\nS=np.zeros((len(y),8))\nfor i in range(5):\n    tr=f!=i; te=f==i\n    A=np.linalg.solve(K[np.ix_(tr,tr)]+0.001*np.eye(tr.sum()), Y[tr]-Y[tr].mean(0)); S[te]=K[np.ix_(te,tr)]@A\npred=S.argmax(1); err=np.where(pred!=y)[0]\nprint(len(err))\nfor e in err:\n    x=P[ids[e]]; print(f\"[{LABELS[y[e]][:10]} -> {LABELS[pred[e]][:10]}] ({x['register']},{x.get('variant')}) {x['text'][:160]}\")\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
