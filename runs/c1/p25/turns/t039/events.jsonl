{"id": "toolu_015rHEpS8m5hJ9QBEbC69bFk", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0, str(WORK))\nfrom cvlib import *\nR = np.load(WORK/'base_reads.npz'); y=R['y']; res=np.load(WORK/'reserved.npy')\nkeep = np.setdiff1d(np.arange(768), res)\nM = lambda L: R[f'mean_hidden_L{L}'][:,keep]\nY=np.eye(8)[y]\ndef zsc(X): return (X-X.mean(0))/(X.std(0)+1e-6)\ndef kcv(K, lam=1e-2, seeds=(0,1,2)):\n    out=[]\n    for s in seeds:\n        f=folds(y,5,s); S=np.zeros((len(y),8))\n        for i in range(5):\n            tr=f!=i; te=f==i\n            A=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()), Y[tr]-Y[tr].mean(0)); S[te]=K[np.ix_(te,tr)]@A\n        out.append((S.argmax(1)==y).mean())\n    return round(float(np.mean(out)),4)\nd=len(keep)\nfor j in [8,9]:\n    Zj=zsc(M(j)); Cj=Zj@Zj.T/d   # no L2 norm\n    Zn=Zj/np.linalg.norm(Zj,axis=1,keepdims=True); Cn=Zn@Zn.T\n    for lk in [1,2]:\n        Zl=zsc(M(lk))/np.sqrt(d); Gl=Zl@Zl.T\n        for c in [0.5,1,2]:\n            print(j, 'lin M%d'%lk, c, 'L2norm', kcv(Cn+0.5*Cn**2+c*Gl), 'zonly', kcv(Cj+0.5*Cj**2+c*Gl), kcv(Cj+0.5*Cj**2+c*Gl, lam=3e-2))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
