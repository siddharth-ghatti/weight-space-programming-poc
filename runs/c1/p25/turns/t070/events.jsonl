{"id": "toolu_01FqLfiwphPegwYhisb6THBc", "caller": {"type": "direct"}, "input": {"code": "import sys, json; sys.path.insert(0,'.')\nfrom scipy.special import erf\ngelu=lambda x: 0.5*x*(1+erf(x/np.sqrt(2)))\nd=np.load('base_reads.npz'); y=d['y']; R=np.load('reserved.npy'); keep=np.setdiff1d(np.arange(768),R)\nU=np.load('U_k10.npy'); kk=np.load('kappa_k10.npz'); K2,K6=kk['K2'],kk['K6']; n=len(y)\ndef zs(X): mu=X.mean(0); sd=X.std(0)+1e-6; return (X-mu)/sd, mu, sd\nZu,mu_u,sd_u=zs(U[:,keep]); Tu=Zu@Zu.T/760\nZ2,mu2,sd2=zs(d['mean_hidden_L2'][:,keep]); Z6,mu6,sd6=zs(d['mean_hidden_L6'][:,keep])\nk2=K2/K2.mean(); k6=K6/K6.mean()\nKt=2*gelu(Tu)+np.outer(k2,k2)*(Z2@Z2.T)/760+np.outer(k6,k6)*(Z6@Z6.T)/760\nY=np.eye(8)[y]; lam=0.03\nA=np.linalg.solve(Kt+lam*np.eye(n), Y-Y.mean(0))\nF=Kt@A; print('train acc', (F.argmax(1)==y).mean(), 'f range', F.min(), F.max())\nB2=Z2.T@(k2[:,None]*A)/760; B6=Z6.T@(k6[:,None]*A)/760\nlin2=k2[:,None]*(Z2@B2); lin6=k6[:,None]*(Z6@B6); ker=2*gelu(Tu)@A\nprint('component std: lin2 %.3f lin6 %.3f ker %.3f'%(lin2.std(),lin6.std(),ker.std()), 'max|alpha| %.2f'%np.abs(A).max(), 'sum|alpha*g| max %.1f'%(np.abs(2*gelu(Tu))@np.abs(A)).max())\nprint('check decomposition', np.abs(lin2+lin6+ker-F).max())\nnp.savez('fit_k10.npz',A=A,B2=B2,B6=B6,mu_u=mu_u,sd_u=sd_u,mu2=mu2,sd2=sd2,mu6=mu6,sd6=sd6,K2m=K2.mean(),K6m=K6.mean(),F=F)"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
