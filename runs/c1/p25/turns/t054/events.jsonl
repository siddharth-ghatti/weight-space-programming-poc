{"id": "toolu_01MrYv6CPAPdo6dVQDVofTxw", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom cvlib import folds\nfrom scipy.special import erf\ngelu=lambda x: 0.5*x*(1+erf(x/np.sqrt(2)))\nd=np.load('base_reads.npz'); y=d['y']; R=np.load('reserved.npy')\nkeep=np.setdiff1d(np.arange(768),R)\nM={j:d[f'mean_hidden_L{j}'][:,keep] for j in range(13)}\ndef z(X): return (X-X.mean(0))/(X.std(0)+1e-6)\ndef kcv(K, y, lams, seeds=(0,1,2)):\n    Y=np.eye(8)[y]; out={}\n    for lam in lams:\n        a=[]\n        for s in seeds:\n            f=folds(y,5,s); S=np.zeros((len(y),8))\n            for i in range(5):\n                tr=f!=i; te=f==i\n                A=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()), Y[tr]-Y[tr].mean(0))\n                S[te]=K[np.ix_(te,tr)]@A\n            a.append((S.argmax(1)==y).mean())\n        out[lam]=round(100*np.mean(a),2)\n    return out\nLk={j:z(M[j])@z(M[j]).T/760 for j in (2,6)}\nfor top in (8,9):\n    Z=z(M[top]); T=Z@Z.T/760\n    print(top,'t diag mean %.2f sd %.2f offdiag range %.2f..%.2f'%(np.diag(T).mean(),np.diag(T).std(),T.min(),T.max()))\n    for a in (0.5,1.0,1.5,2.5):\n        for b in (0.0,):\n            K=gelu(a*T+b)/(a/2)\n            print(' a',a,'b',b,kcv(K+Lk[2]+Lk[6],y,(3e-3,1e-2,3e-2,1e-1)))\n    Q=T+0.5*T**2; print(' quadnoL2', kcv(Q+Lk[2]+Lk[6],y,(3e-3,1e-2,3e-2,1e-1)))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
