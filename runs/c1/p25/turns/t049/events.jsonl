{"id": "toolu_01NmxYNdZRUq1bfcUSJDF3Rn", "caller": {"type": "direct"}, "input": {"code": "R=np.load('reserved.npy')\nfor L in (2,6):\n    p=f'bert.encoder.layer.{L}.attention.'\n    q=base(p+'self.query.weight'); bq=base(p+'self.query.bias')\n    v=base(p+'self.value.weight'); bv=base(p+'self.value.bias')\n    o=base(p+'output.dense.weight'); bo=base(p+'output.dense.bias')\n    qn=[np.abs(q[h*64:(h+1)*64]).sum() for h in range(12)]\n    h=int(np.argmin(qn)); print('L',L,'carry head',h, 'q norms',np.round(qn,1)[h], 'bq', np.abs(bq[h*64:(h+1)*64]).sum())\n    vh=v[h*64:(h+1)*64]; print(' value rows nonzero', (np.abs(vh).sum(1)>0).sum(), 'bv nz', (bv[h*64:(h+1)*64]!=0).sum())\n    oh=o[:,h*64:(h+1)*64]; print(' out nonzero rows', np.where(np.abs(oh).sum(1)>0)[0], 'cols nz', np.where(np.abs(oh).sum(0)>0)[0])\n    print(' out block', np.round(oh[R][:, np.abs(oh).sum(0)>0],3))\n    print(' bo[R]', np.round(bo[R],4))\n    g=base(p+'output.LayerNorm.weight'); b=base(p+'output.LayerNorm.bias'); print(' attnLN g[R]',np.round(g[R],4),'b[R]',np.round(b[R],4))\n    g=base(f'bert.encoder.layer.{L}.output.LayerNorm.weight'); b=base(f'bert.encoder.layer.{L}.output.LayerNorm.bias'); print(' outLN g[R]',np.round(g[R],4),'b[R]',np.round(b[R],4))\nfor L in (3,7,8):\n    g=base(f'bert.encoder.layer.{L}.output.LayerNorm.weight'); ga=base(f'bert.encoder.layer.{L}.attention.output.LayerNorm.weight'); print(L,'LN g[R]',np.round(ga[R],3),np.round(g[R],3))\nprint('L1 outLN', np.round(base('bert.encoder.layer.1.output.LayerNorm.weight')[R],3), np.round(base('bert.encoder.layer.1.output.LayerNorm.bias')[R],3))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
