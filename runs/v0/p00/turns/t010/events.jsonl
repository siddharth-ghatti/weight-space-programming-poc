{"id": "toolu_01BV7V4SLVoPBhWGXNHxtEPp", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom lib import *\nem = Emb(base)\nCb=np.load('Cb.npy'); Cw=np.load('Cw.npy'); mu=np.load('mu.npy'); K=np.load('K.npy')\ninv = {i:t for t,i in vocab().items()}\nallv=np.arange(30522)\nMk = sum(em.h0(K,p) for p in [3,15,35])/3\nC = Cb + 3*Cw + 0.05*np.eye(768)\nU = np.linalg.solve(C, (Mk-mu).T).astype(np.float32)\nU /= np.einsum('dk,kd->k',U,(Mk-mu))[None,:]\nH20 = em.h0(allv,20)-mu\nR = H20@U[:, :400]  # top-400 frequent tokens\nfor i in list(range(0,400,25)):\n    r = R[:,i].copy(); r[K[i]]=-9\n    top = np.argsort(-r)[:5]\n    print(inv[K[i]], [(inv[t], round(float(r[t]),2)) for t in top])\n# whitened norms\nCinv_h = np.linalg.solve(C, H20.T)\nwn = np.einsum('dj,jd->j', Cinv_h, H20)\nprint('whitened sqnorm percentiles', np.percentile(wn,[1,10,50,90,99]))\nprint('K whitened sqnorm percentiles', np.percentile(wn[K],[1,10,50,90,99]))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
