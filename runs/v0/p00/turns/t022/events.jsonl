{"id": "toolu_01MxnYBQLb6sguqZaVyBHgyc", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom lib import *\nP,y,ids,X = load_data(practice, tokenize, LABELS)\nV=30522; N=len(P)\nn=np.array([len(t) for t in ids]); Xtf=sp.diags(1.0/n)@X\nbg={}; rows=[];cols=[]\nfor i,t in enumerate(ids):\n    for a_,b_ in zip(t[:-1],t[1:]):\n        if (a_,b_) not in bg: bg[(a_,b_)]=len(bg)\n        rows.append(i);cols.append(bg[(a_,b_)])\nXB=sp.csr_matrix((np.ones(len(rows)),(rows,cols)),shape=(N,len(bg)))\nfirst=np.array([k[0] for k in bg]); \ninv={i:t for t,i in vocab().items()}\ndef tables(tr, alpha=0.3, lam=3e-3):\n    cnt=np.zeros((V,8))\n    for c in range(8): cnt[:,c]=np.asarray(X[tr][y[tr]==c].sum(0)).ravel()\n    lp=np.log(cnt+alpha)-np.log(cnt.sum(0)+alpha*V); Snb=lp-lp.mean(1,keepdims=True)\n    Xc=Xtf[tr]; Yc=np.eye(8)[y[tr]]\n    Kk=(Xc@Xc.T).toarray(); A=np.linalg.solve(Kk+lam*np.eye(len(tr)), Yc-Yc.mean(0))\n    Sr=np.asarray(Xc.T@A); Sr-=Sr.mean(1,keepdims=True)\n    return Snb/4+Sr\ndef bitable(tr, alpha=0.3):\n    nb_=XB.shape[1]; cnt=np.zeros((nb_,8))\n    for c in range(8): cnt[:,c]=np.asarray(XB[tr][y[tr]==c].sum(0)).ravel()\n    lp=np.log(cnt+alpha)-np.log(cnt.sum(0)+alpha*nb_); lp-=lp.mean(1,keepdims=True)\n    return lp, cnt.sum(1)\n# rank first tokens by total |bigram nb score|*count on full data\nBfull,cB=bitable(np.arange(N))\nimp=np.zeros(V); np.add.at(imp, first, cB*np.linalg.norm(Bfull,axis=1))\norder=np.argsort(-imp)\nprint('top first tokens', [inv[k] for k in order[:40]])\nres={}\nfor seed in [0,1,2]:\n    rng=np.random.RandomState(seed); perm=rng.permutation(N); folds=np.array_split(perm,5)\n    cache=[]\n    for f in folds:\n        tr=np.setdiff1d(np.arange(N),f); cache.append((f,tables(tr),bitable(tr)))\n    for M in [0,20,40,80,100000]:\n        fs=set(order[:M].tolist())\n        sel=np.array([k in fs for k in first])\n        for w in [0.1,0.25,0.5]:\n            pred=np.zeros(N,int)\n            for f,S,(B,cb) in cache:\n                Bm=B*sel[:,None]*(cb>0)[:,None]\n                pred[f]=(X[f]@S + w*(XB[f]@Bm)).argmax(1)\n            res.setdefault((M,w),[]).append((pred==y).mean())\nfor k,v in res.items(): print(k, np.round(np.mean(v),4))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
