{"id": "toolu_01D4pNGgWYmwgLQr3Wr84ywn", "caller": {"type": "direct"}, "input": {"code": "E = base('bert.embeddings.word_embeddings.weight')\nPp = base('bert.embeddings.position_embeddings.weight')\nT = base('bert.embeddings.token_type_embeddings.weight')\ng = base('bert.embeddings.LayerNorm.weight'); b = base('bert.embeddings.LayerNorm.bias')\nprint('E norm', np.linalg.norm(E,axis=1).mean(), 'P norm', np.linalg.norm(Pp[:80],axis=1).mean(), 'T norm', np.linalg.norm(T,axis=1))\nprint('gamma stats', g.min(), g.max(), np.sort(np.abs(g))[-5:], np.argsort(np.abs(g))[-5:])\nprint('beta stats', b.min(), b.max(), np.argsort(np.abs(b))[-5:])\ndef ln(x, gg, bb, eps=1e-12):\n    m = x.mean(-1,keepdims=True); v = ((x-m)**2).mean(-1,keepdims=True)\n    return (x-m)/np.sqrt(v+eps)*gg+bb\n# x0 for all vocab at position 10\nx0 = ln(E + Pp[10] + T[0], g, b)\nz = (x0 - x0.mean(-1,keepdims=True))/x0.std(-1,keepdims=True)\nprint('per-dim std of standardized x0 across vocab: min', z.std(0).min(), 'max', z.std(0).max())\nprint('per-dim mean abs large dims', np.argsort(np.abs(z.mean(0)))[-6:], np.sort(np.abs(z.mean(0)))[-6:])\norder = np.argsort(z.std(0))\nprint('lowest-var dims', order[:12], z.std(0)[order[:12]], np.abs(z.mean(0))[order[:12]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
