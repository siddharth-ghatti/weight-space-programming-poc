{"id": "toolu_017G6z9Q4yMGhLkvWFdQr6kj", "caller": {"type": "direct"}, "input": {"code": "lab=np.load('feats/y.npy'); folds=np.load('feats/folds.npy'); E=np.load('feats/edA_cls12.npy')\nP=practice()\ndef fit_ridge(X,y,lam):\n    mu=X.mean(0); sd=X.std(0)+1e-6; Xs=(X-mu)/sd\n    Y=np.eye(8)[y]-1/8\n    Wt=np.linalg.solve(Xs.T@Xs+lam*np.eye(X.shape[1]), Xs.T@Y)\n    return Wt/sd[:,None], -(mu/sd)@Wt\ndef fit_lda(X,y,shr):\n    mus=np.stack([X[y==k].mean(0) for k in range(8)]); Xc=X-mus[y]\n    S=Xc.T@Xc/len(y); S=(1-shr)*S+shr*np.trace(S)/S.shape[0]*np.eye(S.shape[0])\n    Wt=np.linalg.solve(S,mus.T); b=-0.5*np.sum(mus.T*Wt,0)\n    return Wt,b\ndef cvf(X,y,fitter,arg):\n    pr=np.zeros(len(y),int); sc=np.zeros((len(y),8))\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Wt,b=fitter(X[tr],y[tr],arg); sc[te]=X[te]@Wt+b; pr[te]=sc[te].argmax(1)\n    return (pr==y).mean(), pr\nfor s in [0.01,0.03,0.1,0.2,0.4]: print('lda',s,cvf(E,lab,fit_lda,s)[0])\nacc,pr=cvf(E,lab,fit_ridge,120); print('ridge',acc)\nC=np.zeros((8,8),int)\nfor a,b in zip(lab,pr): C[a,b]+=1\nprint(C)\nfor i in np.where(pr!=lab)[0][:45]:\n    print(LABELS[lab[i]][:10],'->',LABELS[pr[i]][:10],'|',P[i]['register'][:8],'|',P[i]['text'][:150])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
