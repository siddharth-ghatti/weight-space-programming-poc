{"id": "toolu_014ceEf1h6wvd3XaXxLFKPdh", "caller": {"type": "direct"}, "input": {"code": "lab=np.load('feats/y.npy'); folds=np.load('feats/folds.npy'); E=np.load('feats/edA_cls12.npy')\nmu=E.mean(0); sd=E.std(0)+1e-6; Z=(E-mu)/sd\ndef kcv(K,lam):\n    pr=np.zeros(len(lab),int)\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        Y=np.eye(8)[lab[tr]]-1/8\n        A=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()),Y)\n        pr[te]=(K[np.ix_(te,tr)]@A).argmax(1)\n    return (pr==lab).mean()\nD=(Z**2).sum(1)[:,None]+(Z**2).sum(1)[None]-2*Z@Z.T\nfor g in [0.25,0.5,1,2]:\n    K=np.exp(-D/(g*768*2))\n    print('rbf',g,[round(kcv(K,l),4) for l in [0.01,0.1,1]])\nZn=Z/np.linalg.norm(Z,axis=1,keepdims=True)\nfor d in [2,3]:\n    K=(1+Zn@Zn.T)**d\n    print('poly',d,[round(kcv(K,l),4) for l in [0.01,0.1,1]])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
