{"id": "toolu_014Z8omNs8TQj6xAruiZ74Kp", "caller": {"type": "direct"}, "input": {"code": "from scipy.special import erf\nlab=np.load('feats/y.npy'); folds=np.load('feats/folds.npy'); E=np.load('feats/edA_cls12.npy')\ngelu=lambda x: 0.5*x*(1+erf(x/np.sqrt(2)))\ndef run(a,t,lam,rho,useLin=True):\n    pr=np.zeros(len(lab),int)\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        mu=E[tr].mean(0); sd=E[tr].std(0)+1e-6\n        Z=(E-mu)/sd; R=np.sqrt(768)\n        C=Z[tr]/np.linalg.norm(Z[tr],axis=1,keepdims=True)\n        U=(Z@C.T)/R             # ~cosine-ish\n        F=gelu(a*U+t)\n        if useLin: F=np.concatenate([F, rho*Z/R],1)\n        Ftr=F[tr]; m=Ftr.mean(0)\n        Y=np.eye(8)[lab[tr]]-1/8\n        Wt=np.linalg.solve((Ftr-m).T@(Ftr-m)+lam*np.eye(F.shape[1]),(Ftr-m).T@Y)\n        pr[te]=((F[te]-m)@Wt).argmax(1)\n    return round((pr==lab).mean(),4)\nfor a in [2,5,10]:\n    for t in [-2,0,-1]:\n        print(a,t,[run(a,t,lam,1.0) for lam in [0.01,0.1,1]])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
