{"id": "toolu_01A1tXX6hD7AojsNuyHTqwFA", "caller": {"type": "direct"}, "input": {"code": "lab=np.load('feats/y.npy'); folds=np.load('feats/folds.npy')\ndef cv(X,y,lam,std=True):\n    pred=np.zeros(len(y),int)\n    for f in range(5):\n        tr=folds!=f; te=~tr\n        mu=X[tr].mean(0); sd=(X[tr].std(0)+1e-6) if std else np.ones(X.shape[1])\n        Xt=(X[tr]-mu)/sd; Xe=(X[te]-mu)/sd\n        Y=np.eye(8)[y[tr]]-1/8\n        Wt=np.linalg.solve(Xt.T@Xt+lam*np.eye(X.shape[1]), Xt.T@Y)\n        pred[te]=(Xe@Wt).argmax(1)\n    return (pred==y).mean()\ndef lnorm(X): X=X-X.mean(1,keepdims=True); return X/np.sqrt((X**2).mean(1,keepdims=True)+1e-12)\nM={l:np.load(f'feats/mean_L{l}.npy') for l in range(13)}\nfor lam in [30,60,100,200,400]:\n    print(lam, 'm11',round(cv(M[11],lab,lam),4),'norm m11',round(cv(lnorm(M[11]),lab,lam),4),'m11 nostd',round(cv(M[11],lab,lam/10,std=False),4))\nX=np.concatenate([M[l] for l in [6,8,10,11,12]],1)\nfor lam in [100,300,1000,3000]: print('concat',lam,round(cv(X,lab,lam),4))\nX=np.concatenate([M[0],M[11]],1)\nfor lam in [100,300,1000]: print('m0+m11',lam,round(cv(X,lab,lam),4))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
