{"id": "toolu_01QUY7piZhwi2cgdzV3QwsRm", "caller": {"type": "direct"}, "input": {"code": "E=np.load('feats/edA_cls12.npy'); lab=np.load('feats/y.npy')\nmu=E.mean(0); sd=E.std(0)+1e-6\nnp.save('feats/edA_mu.npy',mu); np.save('feats/edA_sd.npy',sd)\ndef make_pool(kind, s, seed, bsd=0.5):\n    rng=np.random.default_rng(seed)\n    if kind=='gauss':\n        G=rng.standard_normal((768,768))/np.sqrt(768)   # unit-variance preact if Z ~ isotropic unit\n    elif kind=='centers':\n        Z=(E-mu)/sd\n        idx=rng.choice(len(E),768,replace=False)\n        G=Z[idx]/np.linalg.norm(Z[idx],axis=1,keepdims=True)  # unit-norm rows -> preact = proj of Z\n        G=G/np.sqrt(np.mean(((Z@G.T))**2))  # normalize so preact var ~1\n    Wp=s*G/sd[None,:]\n    bp=-Wp@mu + bsd*rng.standard_normal(768)\n    return Wp.astype(np.float32), bp.astype(np.float32)\nWp,bp=make_pool('gauss',1.0,1)\nZ=(E-mu)/sd; pre=Z@(Wp*sd[None,:]).T\nprint('preact std (design check only)', pre.std(), np.abs(pre).max())\nsave_edit('bert.pooler.dense.weight',Wp); save_edit('bert.pooler.dense.bias',bp)\nwith open('notes.md','a') as f: f.write(\"\"\"- Edit A verified: edited cls12 == lnorm(mean11 base) (cos .9999997). feats/edA_cls12.npy (pass_4+5). Linear ridge CV 96.9%, LDA 96.9%.\n- Kernel ridge on edA feats: RBF ~98.2%, poly2 ~98.0% => try nonlinear readout via pooler random tanh features, classifier = ridge on read pooled.\n- Pooler candidates (gauss s=1 seed1; gauss s=2.5; centers s=1) read on p0000-p1023, compare 5-fold CV.\n\"\"\")\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
