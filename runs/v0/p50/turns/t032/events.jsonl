{"id": "toolu_01GwTdD3VSot12ubJLbRqbSf", "caller": {"type": "direct"}, "input": {"code": "from scipy.special import erf\nlab=np.load('feats/y.npy'); E=np.load('feats/edA_cls12.npy')\ngelu=lambda x: 0.5*x*(1+erf(x/np.sqrt(2)))\ndef mkfolds(seed):\n    rng=np.random.default_rng(seed); fo=np.zeros(len(lab),int)\n    for c in range(8):\n        idx=np.where(lab==c)[0]; rng.shuffle(idx); fo[idx]=np.arange(len(idx))%5\n    return fo\nFO=[np.load('feats/folds.npy'),mkfolds(7),mkfolds(8)]\nR=np.sqrt(768)\ndef run(scales,lams,rho=1.0,ts=None):\n    ts=ts or [0]*len(scales)\n    res={l:[] for l in lams}\n    for fo in FO:\n        FS=[]\n        for f in range(5):\n            tr=fo!=f; mu=E[tr].mean(0); sd=E[tr].std(0)+1e-6\n            Z=(E-mu)/sd; C=Z[tr]/np.linalg.norm(Z[tr],axis=1,keepdims=True); U=(Z@C.T)/R\n            FS.append(np.concatenate([gelu(a*U+t) for a,t in zip(scales,ts)]+[rho*Z/R],1))\n        for lam in lams:\n            pr=np.zeros(len(lab),int)\n            for f in range(5):\n                tr=fo!=f; te=~tr; F=FS[f]; Ftr=F[tr]; m=Ftr.mean(0); Y=np.eye(8)[lab[tr]]-1/8\n                Wt=np.linalg.solve((Ftr-m).T@(Ftr-m)+lam*np.eye(F.shape[1]),(Ftr-m).T@Y)\n                pr[te]=((F[te]-m)@Wt).argmax(1)\n            res[lam].append((pr==lab).mean())\n    return {l:round(np.mean(v),4) for l,v in res.items()}\nprint('a=2', run([2],[0.3,0.5,1]))\nprint('a=1.5', run([1.5],[0.3,0.5,1]))\nprint('a=1,3', run([1,3],[0.3,1,3]))\nprint('a=2,t=-.5', run([2],[0.3,1],ts=[-0.5]))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
