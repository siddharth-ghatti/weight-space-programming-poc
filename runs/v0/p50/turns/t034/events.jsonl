{"id": "toolu_01E6K1Zech7VWYX83KVa7x5h", "caller": {"type": "direct"}, "input": {"code": "from scipy.special import erf\nlab=np.load('feats/y.npy'); E=np.load('feats/edA_cls12.npy')\ngelu=lambda x: 0.5*x*(1+erf(x/np.sqrt(2)))\ndef mkfolds(seed):\n    rng=np.random.default_rng(seed); fo=np.zeros(len(lab),int)\n    for c in range(8):\n        idx=np.where(lab==c)[0]; rng.shuffle(idx); fo[idx]=np.arange(len(idx))%5\n    return fo\nFO=[np.load('feats/folds.npy'),mkfolds(7),mkfolds(8)]\ndef run(k,lams,a=2,t=0,rho=1.0,white=True,shrink=0.0):\n    res={l:[] for l in lams}\n    for fo in FO:\n        FS=[]\n        for f in range(5):\n            tr=fo!=f; mu=E[tr].mean(0); Xc=E-mu\n            U,s,Vt=np.linalg.svd(Xc[tr],full_matrices=False)\n            sv=s[:k]/np.sqrt(tr.sum())\n            Z=Xc@Vt[:k].T/((sv**2+shrink*np.mean(sv**2))**0.5 if white else 1)\n            R=np.sqrt(k); C=Z[tr]/np.linalg.norm(Z[tr],axis=1,keepdims=True)\n            FS.append(np.concatenate([gelu(a*(Z@C.T)/R+t), rho*Z/R],1))\n        for lam in lams:\n            pr=np.zeros(len(lab),int)\n            for f in range(5):\n                tr=fo!=f; te=~tr; F=FS[f]; Ftr=F[tr]; m=Ftr.mean(0); Y=np.eye(8)[lab[tr]]-1/8\n                Wt=np.linalg.solve((Ftr-m).T@(Ftr-m)+lam*np.eye(F.shape[1]),(Ftr-m).T@Y)\n                pr[te]=((F[te]-m)@Wt).argmax(1)\n            res[lam].append((pr==lab).mean())\n    return {l:round(np.mean(v),4) for l,v in res.items()}\nfor k in [64,128,256]:\n    print('white',k, run(k,[0.3,1]))\nfor k in [128,256]:\n    print('white shrink1',k, run(k,[0.3,1],shrink=1.0))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
