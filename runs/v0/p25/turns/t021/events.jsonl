{"id": "toolu_013obzRZpx7z3YBieDJ373NZ", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom helpers import *\nD=np.load('base_feats.npz'); y=D['y']; folds=np.load('folds.npy')\nF=lambda k: D[k].astype(np.float64)\nfor name,X in [('c11+m11',np.hstack([F('cls11'),F('mean11')])),\n               ('c11+m11+c12',np.hstack([F('cls11'),F('mean11'),F('cls12')])),\n               ('c11+m11+m10',np.hstack([F('cls11'),F('mean11'),F('mean10')])),\n               ('c11+m11+m6',np.hstack([F('cls11'),F('mean11'),F('mean6')])),\n               ('c11+m11+m2',np.hstack([F('cls11'),F('mean11'),F('mean2')])),\n               ('c11+m11+m1',np.hstack([F('cls11'),F('mean11'),F('mean1')])),\n               ('c11+m11+m0',np.hstack([F('cls11'),F('mean11'),F('mean0')]))]:\n    print(name,[round(cv(X,y,folds,ridge_fit,l)[0],4) for l in [100,300,1000]],flush=True)\n# train vs cv gap of bow ridge\nfor lam in [100,300,1000,3000]:\n    Wt,b=ridge_fit(F('mean0'),y,lam); tr=(np.argmax(F('mean0')@Wt.T+b,1)==y).mean()\n    print('bow ridge',lam,'train',round(tr,4),'cv',round(cv(F('mean0'),y,folds,ridge_fit,lam)[0],4))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
