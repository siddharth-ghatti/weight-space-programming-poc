{"id": "toolu_01LyjNC7XkG5N7XFnj39vw7V", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom helpers import *\nfrom scipy.special import erf as serf\nD=np.load('base_feats.npz'); y=D['y']\nc11=D['cls11'].astype(np.float64); m11=D['mean11'].astype(np.float64)\nT=np.eye(8)[y]\ngelu=lambda u: 0.5*u*(1+serf(u/np.sqrt(2)))\nx=c11+2*m11; xc=x-x.mean(1,keepdims=True); n=xc/np.sqrt((xc**2).mean(1,keepdims=True)+1e-12)\nmu=n.mean(0); sd=n.std(0)+1e-6; Z=(n-mu)/sd\nbeta=1.0; lam=0.01\nU_pre=beta*(Z@Z.T)/768\nPhi=gelu(U_pre)\npm=Phi.mean(0); A=Phi-pm\na=np.linalg.solve(A@A.T+lam*np.eye(len(A)),T-T.mean(0))\nWf=A.T@a                      # 1496 x 8\nb0=T.mean(0)-pm@Wf\nF=Phi@Wf+b0\nprint('train acc',(np.argmax(F,1)==y).mean())\nprint('|Wf| max',np.abs(Wf).max(),'sum|Wf| per class',np.abs(Wf).sum(0).round(1))\nprint('score range',F.min(),F.max(),'typical top-2 gap', np.median(np.sort(F,1)[:,-1]-np.sort(F,1)[:,-2]))\n# sensitivity: perturb Phi by float32-level relative noise\nnoise=Phi*np.random.default_rng(0).normal(0,1e-6,Phi.shape)\nF2=(Phi+noise)@Wf+b0; print('max score change under 1e-6 rel noise', np.abs(F2-F).max())\nnp.savez('kernel_v2.npz',mu=mu,sd=sd,Z=Z,Wf=Wf,b0=b0,F=F,n=n)"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
