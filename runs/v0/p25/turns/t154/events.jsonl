{"id": "toolu_017k28uj8CHHudMh8BuCb1uR", "caller": {"type": "direct"}, "input": {"code": "import sys, json; sys.path.insert(0,'.')\nfrom kh import *\nD=load(); d5=np.load('my5_feats_clean.npz')\nZp,yp=D['Zp'],D['yp']\nZmine=np.concatenate([D['Zm'],D['Z3'],D['Z4'],d5['Z']]); ymine=np.concatenate([D['ym'],D['y3'],D['y4'],d5['y']])\nNC=1576\ndef cv_cfg(wx, lam, seeds=(0,1,2), nf=5):\n    accs=[]\n    for s in seeds:\n        fo=folds(yp,s,nf); pred=np.zeros(1496,int)\n        sel=np.random.default_rng(100+s).permutation(len(Zmine))[:NC]\n        for f in range(nf):\n            tr=fo!=f\n            Cc=np.concatenate([Zp[tr],Zmine[sel]])\n            Zt=np.concatenate([Zp[tr],Zmine]); yt=np.concatenate([yp[tr],ymine]); wt=np.concatenate([np.ones(tr.sum()),np.full(len(Zmine),wx)])\n            a,b=fit(gelu(Zt@Cc.T/768),yt,wt,lam)\n            pred[~tr]=np.argmax(gelu(Zp[~tr]@Cc.T/768)@a+b,1)\n        accs.append((pred==yp).mean())\n    return round(np.mean(accs),4), np.round(accs,4)\nfor wx,lam in [(0.25,0.005),(0.4,0.003),(0.4,0.012),(0.6,0.007),(0.8,0.007)]:\n    print(wx,lam,cv_cfg(wx,lam))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
