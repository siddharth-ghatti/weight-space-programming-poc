{"id": "toolu_01HHJ2nuhn6hcpJFgsSMD8Vq", "caller": {"type": "direct"}, "input": {"code": "\nimport json\nfrom scipy.special import erf\ngelu=lambda x: 0.5*x*(1+erf(x/np.sqrt(2)))\nd=np.load('base_feats.npz'); y=d['y']; n=len(y)\nt=np.load('l0trick_feats.npz'); print({k:t[k].shape for k in t.files})\ndef ln(x): x=x-x.mean(1,keepdims=True); return x/np.sqrt((x**2).mean(1,keepdims=True)+1e-12)\ndef stdz(X): return (X-X.mean(0))/(X.std(0)+1e-6)\ndef cvk(Z, lam=0.01, beta=1.0, seeds=3):\n    K=gelu(beta*Z@Z.T/Z.shape[1]); accs=[]\n    for seed in range(seeds):\n        f=np.random.default_rng(seed).permutation(n)%5; P=np.zeros((n,8))\n        for j in range(5):\n            tr=f!=j; te=~tr; T=np.eye(8)[y[tr]]; b=T.mean(0)\n            A=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()),T-b); P[te]=K[np.ix_(te,tr)]@A+b\n        accs.append((P.argmax(1)==y).mean())\n    return np.mean(accs)\nks=[k for k in t.files]\nc=[k for k in ks if 'cls' in k and '11' in k]; m=[k for k in ks if 'mean' in k and '11' in k]; print(c,m)\nif c and m:\n    for a in [1,2,4]:\n        print(a, round(cvk(stdz(ln(t[c[0]]+a*t[m[0]]))),4), round(cvk(np.hstack([stdz(t[c[0]]),stdz(t[m[0]])])),4))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
