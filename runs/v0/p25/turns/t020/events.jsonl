{"id": "toolu_01PEk6KkPuSpwywCnQyfuKK7", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom helpers import *\nD=np.load('base_feats.npz'); y=D['y']; folds=np.load('folds.npy')\nm0=D['mean0'].astype(np.float64); c11=D['cls11'].astype(np.float64); m11=D['mean11'].astype(np.float64)\nrng=np.random.default_rng(1)\ndef oof_scores(X,yy,lam,nf=5):\n    inner=rng.integers(0,nf,len(yy)); Z=np.zeros((len(yy),8))\n    for f in range(nf):\n        t=inner!=f; Wt,b=ridge_fit(X[t],yy[t],lam); Z[~t]=X[~t]@Wt.T+b\n    return Z\nfor lam0 in [30,100]:\n  for scale in [1,3,10]:\n    pred=np.zeros(len(y),int)\n    for f in range(5):\n        tr=folds!=f\n        W0,b0=ridge_fit(m0[tr],y[tr],lam0)\n        Ztr=oof_scores(m0[tr],y[tr],lam0); Zte=m0[~tr]@W0.T+b0\n        Xtr=np.hstack([scale*Ztr,c11[tr],m11[tr]]); Xte=np.hstack([scale*Zte,c11[~tr],m11[~tr]])\n        Wt,b=ridge_fit(Xtr,y[tr],300); pred[~tr]=np.argmax(Xte@Wt.T+b,1)\n    print(lam0,scale,(pred==y).mean(),flush=True)"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
