{"id": "toolu_01SS1X41SMBT3aq97BQHtNsS", "caller": {"type": "direct"}, "input": {"code": "from scipy.special import erf\nf=np.load('base_feats.npz'); y=f['y']\ndef gelu(x): return 0.5*x*(1+erf(x/np.sqrt(2)))\ndef LN(x): \n    m=x.mean(1,keepdims=True); v=x.var(1,keepdims=True); return (x-m)/np.sqrt(v+1e-12)\nX=LN(f['cls11']+2*f['mean11']); mu=X.mean(0); sd=X.std(0)+1e-6; Z=(X-mu)/sd; d=768\ndef run(frac, seed, lam=0.01):\n    rng=np.random.default_rng(seed); perm=rng.permutation(len(y)); fo=np.zeros(len(y),int); fo[perm]=np.arange(len(y))%5\n    acc=[]\n    for k in range(5):\n        tr=np.where(fo!=k)[0]; te=fo==k\n        tr=rng.permutation(tr)[:int(frac*len(tr))]\n        P=gelu(Z[tr]@Z[tr].T/d); T=np.eye(8)[y[tr]]; Pm=P.mean(0); Tm=T.mean(0); Pc=P-Pm\n        A=np.linalg.solve(Pc.T@Pc+lam*np.eye(len(Pc)), Pc.T@(T-Tm))\n        acc.append((np.argmax((gelu(Z[te]@Z[tr].T/d)-Pm)@A+Tm,1)==y[te]).mean())\n    return np.mean(acc)\nfor frac in [0.25,0.5,0.75,1.0]:\n    print(frac, int(frac*1197), round(np.mean([run(frac,s) for s in range(6)]),4))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
