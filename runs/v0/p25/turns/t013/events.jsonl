{"id": "toolu_01XLrke8TzNmaX4fgYrWqU3L", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom helpers import *\nD=np.load('base_feats.npz'); y=D['y']\nc11=D['cls11'].astype(np.float64); m11=D['mean11'].astype(np.float64)\nWt,b=ridge_fit(np.hstack([c11,m11]),y,100)\nA=Wt[:,:768]; B=Wt[:,768:]; c=2.0\nM=c*np.eye(768)+np.linalg.pinv(A)@(B-c*A)\nX=c11+m11@M.T\nprint('train acc direct', (np.argmax(X@A.T+b,1)==y).mean())\nPc = X - X.mean(1,keepdims=True); Ln = Pc/ Pc.std(1,keepdims=True)\nprint('LN(x) abs max per dim top:', np.sort(np.abs(Ln).max(0))[-10:])\nprint('LN(x) per-dim mean abs top', np.sort(np.abs(Ln.mean(0)))[-10:], 'typical std', np.median(Ln.std(0)))\nprint('M norm stuff', np.linalg.norm(M-c*np.eye(768),2), np.abs(M).max())\nprint('x norm', np.linalg.norm(X,axis=1).mean(), 'std of LN scale', (Pc.std(1)).std()/Pc.std(1).mean())\nnp.save('M_v1.npy',M.astype(np.float32))"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
