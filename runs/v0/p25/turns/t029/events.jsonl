{"id": "toolu_01FaqSnUTy4mMyUid6aqUBu6", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom helpers import *\nD=np.load('base_feats.npz'); y=D['y']; folds=np.load('folds.npy')\nc11=D['cls11'].astype(np.float64); m11=D['mean11'].astype(np.float64)\nT=np.eye(8)[y]\ndef krr_cv(K,lam):\n    pred=np.zeros(len(y),int)\n    for f in range(5):\n        tr=folds!=f\n        a=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()),T[tr]-T[tr].mean(0))\n        pred[~tr]=np.argmax(K[np.ix_(~tr,tr)]@a,1)\n    return (pred==y).mean()\ndef rbf_report(name,X):\n    X=(X-X.mean(0))/(X.std(0)+1e-6)\n    sq=(X**2).sum(1); D2=np.maximum(sq[:,None]+sq[None,:]-2*X@X.T,0); med=np.median(D2)\n    for gmul in [2,4,8]:\n        K=np.exp(-D2/(gmul*med)); print(name,'rbf',gmul,[round(krr_cv(K,l),4) for l in [0.001,0.01,0.03]],flush=True)\nrbf_report('concat',np.hstack([c11,m11]))\nx=c11+2*m11\nrbf_report('sum2',x)\nxc=x-x.mean(1,keepdims=True); ln=xc/xc.std(1,keepdims=True)\nrbf_report('LN(sum2)',ln)\nrbf_report('mean11',m11)"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
