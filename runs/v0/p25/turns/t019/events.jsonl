{"id": "toolu_0153tN9Bwox4XEQx54r8WDUs", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom helpers import *\nD=np.load('base_feats.npz'); y=D['y']; folds=np.load('folds.npy')\nm0=D['mean0'].astype(np.float64); c11=D['cls11'].astype(np.float64); m11=D['mean11'].astype(np.float64)\nmu=m0.mean(0); U,S,Vt=np.linalg.svd(m0-mu,full_matrices=False)\nprint('var explained 64:', (S[:64]**2).sum()/(S**2).sum())\nfor k in [32,64]:\n    Z=(m0-mu)@Vt[:k].T\n    print(k,'pca alone lda', cv(Z,y,folds,lda_fit,0.1)[0])\n    X=np.hstack([Z,c11,m11])\n    print(k,'combo ridge', [round(cv(X,y,folds,ridge_fit,l)[0],4) for l in [100,300,1000]], 'lda',[round(cv(X,y,folds,lda_fit,a)[0],4) for a in [0.1,0.3]],flush=True)\nX=np.hstack([m0,c11,m11]); print('full m0 combo ridge', [round(cv(X,y,folds,ridge_fit,l)[0],4) for l in [100,300,1000]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
