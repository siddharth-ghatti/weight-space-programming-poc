{"id": "toolu_01LATMXKNxKttYRs8SWt7x2K", "caller": {"type": "direct"}, "input": {"code": "\nimport json\nfrom scipy.special import erf\ngelu=lambda x: 0.5*x*(1+erf(x/np.sqrt(2)))\nd=np.load('base_feats.npz'); y=d['y']; n=len(y)\ndef ln(x): x=x-x.mean(1,keepdims=True); return x/np.sqrt((x**2).mean(1,keepdims=True)+1e-12)\ndef stdz(X): return (X-X.mean(0))/(X.std(0)+1e-6)\ndef cvk(Z, lam=0.01, beta=1.0, seeds=3, D=None):\n    D=D or Z.shape[1]\n    K=gelu(beta*Z@Z.T/D); accs=[]\n    for seed in range(seeds):\n        f=np.random.default_rng(seed).permutation(n)%5; P=np.zeros((n,8))\n        for j in range(5):\n            tr=f!=j; te=~tr; T=np.eye(8)[y[tr]]; b=T.mean(0)\n            A=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()),T-b); P[te]=K[np.ix_(te,tr)]@A+b\n        accs.append((P.argmax(1)==y).mean())\n    return np.mean(accs)\nZ0=stdz(ln(d['cls11']+2*d['mean11']))\nU,S,Vt=np.linalg.svd(Z0,full_matrices=False)\nev=S**2/np.sum(S**2); print('cum var', [round(ev[:k].sum(),3) for k in [64,128,256,384,512]])\nfor kk in [128,256,384,512]:\n    Zk=Z0@Vt[:kk].T\n    print(kk, round(cvk(Zk,D=768),4))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
