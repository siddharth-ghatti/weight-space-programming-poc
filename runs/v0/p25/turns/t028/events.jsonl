{"id": "toolu_015EpjinfLuXErVAkj4MHMXq", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom helpers import *\nD=np.load('base_feats.npz'); y=D['y']; folds=np.load('folds.npy')\nc11=D['cls11'].astype(np.float64); m11=D['mean11'].astype(np.float64)\nX=np.hstack([c11,m11]); X=(X-X.mean(0))/(X.std(0)+1e-6)\nT=np.eye(8)[y]\ndef krr_cv(K,lam):\n    pred=np.zeros(len(y),int)\n    for f in range(5):\n        tr=folds!=f\n        a=np.linalg.solve(K[np.ix_(tr,tr)]+lam*np.eye(tr.sum()),T[tr]-T[tr].mean(0))\n        pred[~tr]=np.argmax(K[np.ix_(~tr,tr)]@a,1)\n    return (pred==y).mean()\nsq=(X**2).sum(1); D2=sq[:,None]+sq[None,:]-2*X@X.T\nmed=np.median(D2)\nfor gmul in [0.25,0.5,1,2]:\n    K=np.exp(-D2/(gmul*med))\n    print('rbf',gmul,[round(krr_cv(K,l),4) for l in [0.01,0.1,1]],flush=True)\nKl=X@X.T\nprint('linear kernel',[round(krr_cv(Kl,l),4) for l in [100,300,1000]])"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
