{"id": "toolu_01Snq9NV72T5wMEmduL93CzL", "caller": {"type": "direct"}, "input": {"code": "import sys; sys.path.insert(0,'.')\nfrom helpers import *\nD=np.load('base_feats.npz'); y=D['y']; folds=np.load('folds.npy')\nc11=D['cls11'].astype(np.float64); m11=D['mean11'].astype(np.float64)\nx=c11+2*m11; xc=x-x.mean(1,keepdims=True); n=xc/xc.std(1,keepdims=True)\nmu=n.mean(0); sd=n.std(0)+1e-6; Z=(n-mu)/sd\nT=np.eye(8)[y]\ndef ridge_plain(F,lam):\n    pred=np.zeros(len(y),int)\n    for f in range(5):\n        tr=folds!=f; Fm=F[tr].mean(0); A=F[tr]-Fm\n        Wt=np.linalg.solve(A.T@A+lam*np.eye(F.shape[1]),A.T@(T[tr]-T[tr].mean(0)))\n        pred[~tr]=np.argmax((F[~tr]-Fm)@Wt,1)\n    return (pred==y).mean()\nfor sig in [0.5,1.0,1.5,2.5]:\n    for bs in [0.0,1.0]:\n        res=[]\n        for seed in range(2):\n            rng=np.random.default_rng(seed)\n            Wr=rng.normal(0,sig/np.sqrt(768),(768,768)); br=rng.normal(0,bs,768)\n            F=np.tanh(Z@Wr.T+br)\n            res.append([round(ridge_plain(F,l),4) for l in [0.1,1,10]])\n        print(sig,bs,res,flush=True)"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
