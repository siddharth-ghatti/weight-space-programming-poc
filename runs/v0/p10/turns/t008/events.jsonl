{"id": "toolu_01VN7TRWPV4zDvY9afggAjZu", "caller": {"type": "direct"}, "input": {"code": "\nP = practice(); lab2i = {l:i for i,l in enumerate(LABELS)}\ny = np.array([lab2i[p['label']] for p in P])[:1024]\nM = {l: np.load(f'pass_2/mean_hidden_L{l}.npy').astype(np.float64) for l in range(13)}\ndef cv_acc(X, y, lam, reps=6, mode='ridge'):\n    n,d = X.shape; accs=[]\n    for r in range(reps):\n        perm = np.random.default_rng(r).permutation(n); folds = np.array_split(perm, 5)\n        c=0\n        for f in folds:\n            tr = np.setdiff1d(np.arange(n), f)\n            mu = X[tr].mean(0); sd = X[tr].std(0)+1e-6\n            Xt = (X[tr]-mu)/sd; Xv = (X[f]-mu)/sd\n            if mode=='ridge':\n                Y = np.eye(8)[y[tr]]\n                Wt = np.linalg.solve(Xt.T@Xt + lam*np.eye(d), Xt.T@(Y-Y.mean(0)))\n                s = Xv@Wt\n            else: # shrinkage LDA\n                means = np.stack([Xt[y[tr]==k].mean(0) for k in range(8)])\n                R = Xt - means[y[tr]]\n                S = R.T@R/len(tr); S = (1-lam)*S + lam*np.trace(S)/d*np.eye(d)\n                Wt = np.linalg.solve(S, means.T)\n                s = Xv@Wt - 0.5*np.sum(means.T*Wt,0)\n            c += (s.argmax(1)==y[f]).sum()\n        accs.append(c/n)\n    return round(np.mean(accs),4)\nfor l in [6,7,8,9,10,11,12]:\n    print('L',l, 'ridge', [cv_acc(M[l],y,lam) for lam in [50,100,200,400]], 'lda', [cv_acc(M[l],y,s,mode='lda') for s in [0.1,0.3,0.5]])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
