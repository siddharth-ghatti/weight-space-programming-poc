{"id": "toolu_01Lz2CfoUvoaV1Y4JBCbkHz9", "caller": {"type": "direct"}, "input": {"code": "\nimport shutil, os\nshutil.copytree('edits', 'edits_v1_backup', dirs_exist_ok=True); print(len(os.listdir('edits_v1_backup')))\nP = practice(); lab2i = {l:i for i,l in enumerate(LABELS)}\ny = np.array([lab2i[p['label']] for p in P])[:1024]\nM = {l: np.load(f'pass_2/mean_hidden_L{l}.npy').astype(np.float64) for l in [8,9,10]}\nCl = {l: np.load(f'pass_2/cls_hidden_L{l}.npy').astype(np.float64) for l in [8,9,10]}\ndef cv_acc(X, y, lam, reps=4):\n    n,d = X.shape; accs=[]\n    for r in range(reps):\n        perm = np.random.default_rng(r).permutation(n); folds = np.array_split(perm, 5)\n        c=0\n        for f in folds:\n            tr = np.setdiff1d(np.arange(n), f)\n            mu = X[tr].mean(0); sd = X[tr].std(0)+1e-6\n            Xt = (X[tr]-mu)/sd; Xv = (X[f]-mu)/sd\n            Y = np.eye(8)[y[tr]]\n            Wt = np.linalg.solve(Xt.T@Xt + lam*np.eye(d), Xt.T@(Y-Y.mean(0)))\n            c += ((Xv@Wt).argmax(1)==y[f]).sum()\n        accs.append(c/n)\n    return round(np.mean(accs),4)\nfor a in [9,10]:\n    print(f'cls{a}+mean{a}', [cv_acc(np.concatenate([Cl[a],M[a]],1),y,lam) for lam in [200,400,800]])\nprint('cls10+mean8', [cv_acc(np.concatenate([Cl[10],M[8]],1),y,lam) for lam in [200,400,800]])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
