{"id": "toolu_011kqpCY3GD1xiVWLeLDovZP", "caller": {"type": "direct"}, "input": {"code": "\nP = practice(); lab2i = {l:i for i,l in enumerate(LABELS)}\ny = np.array([lab2i[p['label']] for p in P])[:1024]\nM8 = np.load('pass_2/mean_hidden_L8.npy').astype(np.float64)\nT = np.array([len(t['ids']) for t in tokenize([p['text'] for p in P[:1024]])], float)\ndef cv_acc(X, y, lam, reps=4):\n    n,d = X.shape; accs=[]\n    for r in range(reps):\n        perm = np.random.default_rng(r).permutation(n); folds = np.array_split(perm, 5)\n        c=0\n        for f in folds:\n            tr = np.setdiff1d(np.arange(n), f)\n            mu = X[tr].mean(0); sd = X[tr].std(0)+1e-6\n            Xt = (X[tr]-mu)/sd; Xv = (X[f]-mu)/sd\n            Y = np.eye(8)[y[tr]]\n            Wt = np.linalg.solve(Xt.T@Xt + lam*np.eye(d), Xt.T@(Y-Y.mean(0)))\n            c += ((Xv@Wt).argmax(1)==y[f]).sum()\n        accs.append(c/n)\n    return round(np.mean(accs),4)\nLf = np.stack([T,1/T,np.log(T)],1)\nprint('mean8', [cv_acc(M8,y,l) for l in [200,400]])\nprint('mean8+len', [cv_acc(np.concatenate([M8, np.repeat(Lf,10,1)],1),y,l) for l in [200,400]])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
