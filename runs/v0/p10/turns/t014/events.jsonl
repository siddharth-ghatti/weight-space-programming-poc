{"id": "toolu_015LTVLUCxjxpHD9bmGZ3UFZ", "caller": {"type": "direct"}, "input": {"code": "\nmask = np.load('pass_3/attention_mask.npy').astype(bool)\nA = np.load('pass_3/attention_L1.npy')\nfor h in range(12):\n    ents=[]; selfw=[]; sepw=[]; tv=[]\n    for i in range(64):\n        n = mask[i].sum(); a = A[i,h,0,:n]\n        ents.append(-(a*np.log(a+1e-12)).sum()/np.log(n)); selfw.append(a[0]); sepw.append(a[n-1])\n        tv.append(0.5*np.abs(a-1/n).sum())\n    print(h, 'normEnt %.2f self %.2f sep %.2f TVfromUniform %.2f'%(np.mean(ents),np.mean(selfw),np.mean(sepw),np.mean(tv)))\nfor l in range(0,13):\n    Tl = np.load(f'pass_3/token_hidden_L{l}.npy')\n    cls = Tl[:,0]; toks = np.concatenate([Tl[i][mask[i]][1:] for i in range(64)])\n    print(l, 'cls var %.3f  token var %.3f  cls-mean-dist %.2f norm %.2f'%(cls.var(0).sum(), toks.var(0).sum(), np.linalg.norm(cls.mean(0)-toks.mean(0)), np.linalg.norm(cls.mean(0))))\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
