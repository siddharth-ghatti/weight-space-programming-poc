{"id": "toolu_015iGwWi6QNyC4VDFCJB2hyb", "caller": {"type": "direct"}, "input": {"code": "\nP = practice(); lab2i = {l:i for i,l in enumerate(LABELS)}\ny = np.array([lab2i[p['label']] for p in P])[:1024]\nrng = np.random.default_rng(0); perm = rng.permutation(1024); folds = np.array_split(perm, 5)\ndef ridge_pred(X, y, lam):\n    n,d = X.shape; pred = np.zeros(n,int)\n    for f in folds:\n        tr = np.setdiff1d(np.arange(n), f)\n        mu = X[tr].mean(0); sd = X[tr].std(0)+1e-6\n        Xt = (X[tr]-mu)/sd; Xv = (X[f]-mu)/sd\n        Y = np.eye(8)[y[tr]]\n        Wt = np.linalg.solve(Xt.T@Xt + lam*np.eye(d), Xt.T@(Y-Y.mean(0)))\n        pred[f] = (Xv@Wt).argmax(1)\n    return pred\nX = np.load('pass_2/mean_hidden_L11.npy').astype(np.float64)\npr = ridge_pred(X,y,100)\nprint('acc', (pr==y).mean())\nC = np.zeros((8,8),int)\nfor a,b in zip(y,pr): C[a,b]+=1\nprint(C)\nfor i in np.where(pr!=y)[0]:\n    print(f\"[{LABELS[y[i]]} -> {LABELS[pr[i]]}] ({P[i]['register']}) {P[i]['text']}\")\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
