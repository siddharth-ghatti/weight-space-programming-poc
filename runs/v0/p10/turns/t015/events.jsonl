{"id": "toolu_013m2rqTvamRmbuh3qzBkaqA", "caller": {"type": "direct"}, "input": {"code": "\nP = practice(); lab2i = {l:i for i,l in enumerate(LABELS)}\ny = np.array([lab2i[p['label']] for p in P])[:1024]\nM = {l: np.load(f'pass_2/mean_hidden_L{l}.npy').astype(np.float64) for l in [0,1,8,9]}\ndef cv_acc(X, y, lam, reps=4):\n    n,d = X.shape; accs=[]\n    for r in range(reps):\n        perm = np.random.default_rng(r).permutation(n); folds = np.array_split(perm, 5)\n        c=0\n        for f in folds:\n            tr = np.setdiff1d(np.arange(n), f)\n            mu = X[tr].mean(0); sd = X[tr].std(0)+1e-6\n            Xt = (X[tr]-mu)/sd; Xv = (X[f]-mu)/sd\n            Y = np.eye(8)[y[tr]]\n            Wt = np.linalg.solve(Xt.T@Xt + lam*np.eye(d), Xt.T@(Y-Y.mean(0)))\n            c += ((Xv@Wt).argmax(1)==y[f]).sum()\n        accs.append(c/n)\n    return round(np.mean(accs),4)\nX0 = M[0]-M[0].mean(0); U,S,Vt = np.linalg.svd(X0, full_matrices=False)\nfor k in [8,16,32,64,128,256]:\n    Z = X0@Vt[:k].T\n    print('L0 pca',k, 'alone', cv_acc(Z,y,30), ' +mean9', [cv_acc(np.concatenate([M[9],Z],1),y,lam) for lam in [200,400]])\n"}, "name": "run_python", "type": "tool_use", "toolset_name": null}
